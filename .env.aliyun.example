APP_MODE=production
DEMO_MODE=false
MOCK_CONNECTOR=false
HTTP_PORT=80
POSTGRES_USER=nova
POSTGRES_PASSWORD=REPLACE_LONG_RANDOM_PASSWORD
POSTGRES_DB=nova_erp
DATABASE_URL=postgresql://nova:REPLACE_LONG_RANDOM_PASSWORD@postgres:5432/nova_erp?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=REPLACE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TOKEN_ENCRYPTION_KEY=REPLACE_64_OR_MORE_RANDOM_HEX_CHARACTERS
CORS_ORIGINS=https://erp.example.com
BOOTSTRAP_CONFIRM=CREATE_FIRST_ADMIN
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_PASSWORD_AT_LEAST_12_CHARACTERS
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_TENANT_NAME=你的企业名称
BOOTSTRAP_TENANT_SLUG=your-company
BOOTSTRAP_TENANT_TIMEZONE=Asia/Shanghai
BOOTSTRAP_DEFAULT_CURRENCY=USD
AMAZON_SP_API_APPROVED=false
AMAZON_SP_APPLICATION_ID=
AMAZON_SP_AUTH_URL=https://sellercentral.amazon.com/apps/authorize/consent
AMAZON_SP_LWA_CLIENT_ID=
AMAZON_SP_LWA_CLIENT_SECRET=
AMAZON_SP_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMAZON_SP_API_REGION=us-east-1
AMAZON_SP_REDIRECT_URI=https://erp.example.com/api/v1/sp-api/oauth/callback
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=

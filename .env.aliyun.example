APP_MODE=production
DEMO_MODE=false
MOCK_CONNECTOR=false
# 网关对外端口：前面还有宿主机 nginx / 云负载均衡时写 127.0.0.1:8080；直接对外写 80。数据库、Redis、连接池、接口服务都不对外暴露。
HTTP_PORT=127.0.0.1:8080
# 前面有几层代理就写几（宿主机 nginx 转发到网关容器的两层部署写 2）；不得写 true。未配置时限流与登录锁定会合并计算。
TRUST_PROXY=2

# 数据库（P1-25）：迁移账号是表的所有者，只用于迁移与运维；接口与后台任务使用两个最小权限账号，由一次性服务 roles 自动创建并补齐权限。
# 所有密码都用长随机的字母数字（会出现在连接串里，不要含 @ : / ? # 等字符），各自独立，至少 16 个字符。
POSTGRES_USER=nova
POSTGRES_PASSWORD=REPLACE_LONG_RANDOM_PASSWORD
POSTGRES_DB=nova_erp
NOVA_APP_PASSWORD=REPLACE_LONG_RANDOM_APP_PASSWORD
NOVA_SYSTEM_PASSWORD=REPLACE_LONG_RANDOM_SYSTEM_PASSWORD
# 使用云数据库时才需要改下面三项（默认自动拼装为内置 postgres 与连接池）：
# DATABASE_APP_URL=postgresql://nova_app:密码@主机:5432/nova_erp?schema=public&sslmode=verify-full
# DATABASE_SYSTEM_URL=postgresql://nova_system:密码@主机:5432/nova_erp?schema=public&sslmode=verify-full
# DATABASE_OWNER_URL=postgresql://迁移账号:密码@主机:5432/nova_erp?schema=public&sslmode=verify-full
# 连接池与加密连接：DB_POOL_SIZE 为单进程连接数上限；数据库在另一台机器上时必须 DB_REQUIRE_TLS=true（连接串必须带 sslmode=require/verify-full，且不允许 sslaccept=accept_invalid_certs）
DB_POOL_SIZE=10
DB_POOL_TIMEOUT_SECONDS=20
DB_REQUIRE_TLS=false
# 语句超时（毫秒）：接口 30 秒、后台任务 120 秒；超时的语句由数据库取消，接口返回 QUERY_TIMEOUT（504，可重试）
# QUERY_STATEMENT_TIMEOUT_MS=30000
# WORKER_STATEMENT_TIMEOUT_MS=120000
SLOW_QUERY_MS=1000

# Redis（P1-25）：队列与缓存是两个独立实例，各自设密码（长随机字母数字）。队列不淘汰任何键、持久化；缓存内存满时淘汰最久未用。
QUEUE_REDIS_PASSWORD=REPLACE_LONG_RANDOM_QUEUE_REDIS_PASSWORD
CACHE_REDIS_PASSWORD=REPLACE_LONG_RANDOM_CACHE_REDIS_PASSWORD
QUEUE_REDIS_MAXMEMORY=512mb
CACHE_REDIS_MAXMEMORY=256mb
# 使用云 Redis 时才需要改：连接串写 rediss://:密码@主机:6380 启用加密连接（证书始终校验），私有 CA 用 REDIS_TLS_CA_FILE 指定
# QUEUE_REDIS_URL=
# CACHE_REDIS_URL=
# REDIS_REQUIRE_TLS=true
# REDIS_TLS_CA_FILE=
# REDIS_TLS_SERVERNAME=

# 容器资源（堆上限 + 余量 = 内存上限，进程在被系统强杀之前就会优雅退出）：按机器内存调整
# API_NODE_HEAP_MB=1024
# API_MEM_LIMIT=1536m
# WORKER_NODE_HEAP_MB=1536
# WORKER_MEM_LIMIT=2g
# WORKER_RSS_LIMIT_MB=1700

JWT_SECRET=REPLACE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# 应用层加密主密钥（P1-24）：32 字节（64 位十六进制）。只配 TOKEN_ENCRYPTION_KEY 时它就是唯一主密钥；轮换主密钥见 docs/runbooks/encryption-keys.md
TOKEN_ENCRYPTION_KEY=REPLACE_64_OR_MORE_RANDOM_HEX_CHARACTERS
# ENCRYPTION_MASTER_KEYS=
# ENCRYPTION_MASTER_KEY_ACTIVE=
# 文件存储（P1-23）：本地磁盘（单机，api 与 worker 共享持久卷 nova-aliyun-storage，需纳入备份）或阿里云对象存储
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE_URL=https://dzanx.com/api/v1/storage/local
STORAGE_SIGNING_KEY=REPLACE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# STORAGE_MAX_UPLOAD_MB=50
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
CORS_ORIGINS=https://dzanx.com
BOOTSTRAP_CONFIRM=CREATE_FIRST_ADMIN
BOOTSTRAP_ADMIN_EMAIL=support@dzanx.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_PASSWORD_AT_LEAST_12_CHARACTERS
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_TENANT_NAME=许昌鸿洛商贸有限公司
BOOTSTRAP_TENANT_SLUG=your-company
BOOTSTRAP_TENANT_TIMEZONE=Asia/Shanghai
BOOTSTRAP_DEFAULT_CURRENCY=USD
AMAZON_SP_API_APPROVED=false
AMAZON_SP_APP_DRAFT=true
AMAZON_SP_APPLICATION_ID=
AMAZON_SP_AUTH_URL=https://sellercentral.amazon.com/apps/authorize/consent
AMAZON_SP_LWA_CLIENT_ID=
AMAZON_SP_LWA_CLIENT_SECRET=
AMAZON_SP_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMAZON_SP_API_REGION=us-east-1
AMAZON_SP_REDIRECT_URI=https://dzanx.com/api/v1/sp-api/oauth/callback
AMAZON_SP_SUCCESS_REDIRECT=https://dzanx.com/app/connections
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AMAZON_ADS_API_APPROVED=false
AMAZON_ADS_API_ENDPOINT=https://advertising-api.amazon.com
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_ADS_REDIRECT_URI=https://dzanx.com/api/v1/ads/oauth/callback
AMAZON_ADS_SUCCESS_REDIRECT=https://dzanx.com/app/connections
AMAZON_ADS_CAMPAIGNS_PATH=/sp/campaigns/list
AMAZON_ADS_REPORTS_PATH=/reporting/reports

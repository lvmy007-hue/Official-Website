{
  "name": "@nova/api",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema ../../database/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema ../../database/prisma/schema.prisma",
    "prisma:bootstrap": "tsx ../../database/prisma/bootstrap-admin.ts",
    "prisma:bootstrap-platform": "tsx ../../database/prisma/bootstrap-platform-admin.ts",
    "sample:load": "tsx src/scripts/load-sample-data.ts",
    "prisma:local-bootstrap": "tsx ../../database/prisma/bootstrap-local.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nova/api-contracts": "workspace:*",
    "@nova/authz": "workspace:*",
    "@nova/crypto": "workspace:*",
    "@nova/storage": "workspace:*",
    "@nova/tenancy": "workspace:*",
    "@nova/workflow": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.25.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "fflate": "0.8.3",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "pino": "9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@swc/core": "^1.16.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "16.14.0-beta.17",
    "pg": "^8.23.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "2.1.4"
  }
}

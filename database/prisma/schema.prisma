  tenant                      Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity                 LegalEntity                     @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  connections                 PlatformConnection[]
  shipFromAddresses           ShipFromAddress[]
  orders                      Order[]
  orderCharges                OrderCharge[]
  orderPackages               OrderPackage[]
  orderCancellations          OrderCancellation[]
  orderStatusHistory          OrderStatusHistory[]
  accountBalances             AccountBalanceSnapshot[]
  parityRuns                  ConnectorParityRun[]
  channelStates               ConnectorChannelState[]
  integrationSwitches         IntegrationSwitch[]
  notificationSubscriptions   NotificationSubscription[]
  amazonNotificationEvents    AmazonNotificationEvent[]
  dataFreshness               DataFreshness[]
  tenantSettings              TenantSetting[]
  storeDailySummaries         StoreDailySummary[]
  asinDailySummaries          AsinDailySummary[]
  profitDailies               ProfitDaily[]
  economicsDailies            EconomicsDaily[]
  economicsPreviews           EconomicsPreview[]
  salesTrafficDailies         SalesTrafficDaily[]
  salesTrafficAsinDailies     SalesTrafficAsinDaily[]
  salesTrafficDiffs           SalesTrafficDiff[]

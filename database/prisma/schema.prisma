  conversionShare1    Decimal?      @db.Decimal(12, 6)
  clickedAsin2        String?
  clickedTitle2       String?
  clickShare2         Decimal?      @db.Decimal(12, 6)
  conversionShare2    Decimal?      @db.Decimal(12, 6)
  clickedAsin3        String?

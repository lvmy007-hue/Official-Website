// ---- M-P3-01：广告连接器 ----

// 亚马逊官方推荐（广告统一接口的推荐资源）。status: NEW 待处理、ADOPTED 已采纳、IGNORED 已忽略、EXPIRED 已失效（亚马逊不再返回的待处理推荐）。
// 同步只更新内容与 lastSeenAt，不改人工决定的状态；adsAccountId 是统一接口的全球广告账户编号（文本，不是外键：账户表在 P3-02）。
model AdsRecommendation {
  id               String     @id @default(cuid())
  tenantId         String
  adsProfileId     String
  adsAccountId     String
  recommendationId String
  type             String
  entityType       String
  entityId         String
  payloadJson      Json
  status           String     @default("NEW")
  receivedAt       DateTime
  lastSeenAt       DateTime
  decidedBy        String?
  decidedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile       AdsProfile @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  account          AdsAccount @relation(fields: [tenantId, adsAccountId], references: [tenantId, adsAccountId], onDelete: Cascade, map: "AdsRecommendation_account_fkey")

  @@unique([tenantId, adsAccountId, recommendationId], map: "AdsRecommendation_uq")
  @@index([adsProfileId, status], map: "AdsRecommendation_profile_status_idx")
  @@index([tenantId, entityType, entityId], map: "AdsRecommendation_entity_idx")
}

// 活动预测（修改预算前的影响预览）：每次请求留一行，只追加。
model AdsForecastRun {
  id              String     @id @default(cuid())
  tenantId        String
  adsProfileId    String
  adsAccountId    String
  campaignId      String
  requestedBudget Decimal    @db.Decimal(20, 6)
  currency        String     @default("USD")
  forecastJson    Json
  requestedAt     DateTime
  requestedBy     String?
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile      AdsProfile @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  account         AdsAccount @relation(fields: [tenantId, adsAccountId], references: [tenantId, adsAccountId], onDelete: Cascade, map: "AdsForecastRun_account_fkey")

  @@index([adsProfileId, campaignId, requestedAt], map: "AdsForecastRun_campaign_idx")
  @@index([tenantId, requestedAt], map: "AdsForecastRun_tenant_idx")
}

// 旧版并行核对的旧通道状态（每个广告档案一行）：连续 requiredPasses 次没有未解释差异后旧通道关闭。
model AdsParityState {
  id                String     @id @default(cuid())
  tenantId          String
  adsProfileId      String     @unique
  legacyEnabled     Boolean    @default(true)
  consecutivePasses Int        @default(0)
  requiredPasses    Int        @default(7)
  lastRunAt         DateTime?
  closedAt          DateTime?
  closedReason      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile        AdsProfile @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "AdsParityState_tenant_idx")
}

// 一次核对：同一时间窗内旧版日指标（已入库）与新报告接口（刚下载）逐活动逐日比对。status: PASSED、HAS_DIFFS、LEGACY_UNAVAILABLE。
model AdsParityRun {
  id               String          @id @default(cuid())
  tenantId         String
  adsProfileId     String
  windowStart      DateTime        @db.Date
  windowEnd        DateTime        @db.Date
  legacyCount      Int             @default(0)
  newCount         Int             @default(0)
  matchedCount     Int             @default(0)
  unexplainedCount Int             @default(0)
  warningCount     Int             @default(0)
  status           String
  startedAt        DateTime        @default(now())
  finishedAt       DateTime?
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile       AdsProfile      @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  diffs            AdsParityDiff[]

  @@index([tenantId, adsProfileId, startedAt], map: "AdsParityRun_tenant_idx")
  @@index([adsProfileId, startedAt], map: "AdsParityRun_profile_idx")
}

// 核对差异：每条都归入四类之一（时间口径、归因口径、范围、未解释）并写明原因。
model AdsParityDiff {
  id          String       @id @default(cuid())
  tenantId    String
  runId       String
  category    String
  entityKey   String
  field       String
  legacyValue String?
  newValue    String?
  explanation String
  createdAt   DateTime     @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run         AdsParityRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, category], map: "AdsParityDiff_run_idx")
  @@index([tenantId, createdAt], map: "AdsParityDiff_tenant_idx")
}

// ---- M-P2a-11：头程物流 ----

// 货代。status: ACTIVE、INACTIVE（停用后不能再选，历史保留）；defaultMode 取 SEA、AIR、EXPRESS，新建运单时作为默认运输方式。
model FreightForwarder {
  id          String              @id @default(cuid())
  tenantId    String
  name        String
  contact     String?
  defaultMode String?
  status      String              @default("ACTIVE")
  version     Int                 @default(1)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipments   FirstMileShipment[]
  stats       TransitTimeStat[]

  @@unique([tenantId, name], map: "FreightForwarder_uq")
}

// 头程运单。mode: SEA、AIR、EXPRESS；customsStatus: NOT_STARTED、IN_PROGRESS、CLEARED、HELD。
// 预估费用为空表示尚未估价（不是 0）；实际费用由 FirstMileCost 汇总，不另存一列。
// warehouseId 是出库国内仓（可空，空表示不占用国内仓库存）；outboundAt 非空表示已按明细在国内仓记了“头程发货”出库流水。
// linkedInboundShipmentIds 是关联的入仓货件编号（FbaInboundShipment.shipmentId，亚马逊货件编号）。
model FirstMileShipment {
  id                       String                  @id @default(cuid())
  tenantId                 String
  forwarderId              String
  waybillNo                String
  mode                     String
  containerNo              String?
  shipDate                 DateTime?               @db.Date
  etaPort                  DateTime?               @db.Date
  ataPort                  DateTime?               @db.Date
  customsStatus            String                  @default("NOT_STARTED")
  etaDelivery              DateTime?               @db.Date
  ataDelivery              DateTime?               @db.Date
  estimatedCost            Decimal?                @db.Decimal(20, 6)
  currency                 String                  @default("USD")
  // P6-26：按渠道报价算出并被采用的预估所依据的渠道与采用时间（预估费用为手工填写时两列为空）
  carrierChannelId         String?
  estimatedAt              DateTime?
  linkedInboundShipmentIds String[]                @default([])
  warehouseId              String?
  outboundAt               DateTime?
  note                     String?
  version                  Int                     @default(1)
  createdBy                String
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  forwarder                FreightForwarder        @relation(fields: [forwarderId], references: [id], onDelete: Restrict)
  warehouse                Warehouse?              @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  carrierChannel           CarrierChannel?         @relation(fields: [carrierChannelId], references: [id], onDelete: Restrict)
  items                    FirstMileShipmentItem[]
  costs                    FirstMileCost[]
  milestones               FirstMileMilestone[]
  allocations              LandedCostAllocation[]

  @@unique([tenantId, forwarderId, waybillNo], map: "FirstMileShipment_uq")
  @@index([forwarderId], map: "FirstMileShipment_fwd_idx")
  @@index([warehouseId], map: "FirstMileShipment_wh_idx")
  @@index([carrierChannelId], map: "FirstMileShipment_channel_idx")
  @@index([tenantId, shipDate], map: "FirstMileShipment_ship_idx")
}

// ---- M-P6-26：物流渠道与报价 ----

// 物流商（承运商）。status: ACTIVE、INACTIVE（停用后不能再被新运单选用，历史保留）；version 是乐观锁。
model Carrier {
  id        String           @id @default(cuid())
  tenantId  String
  name      String
  code      String
  status    String           @default("ACTIVE")
  version   Int              @default(1)
  createdBy String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channels  CarrierChannel[]

  @@unique([tenantId, code], map: "Carrier_code_uq")
}

// 渠道。volumetricDivisor 是材积除数（立方厘米每千克，空运常用 6000）；splitFactor 是分抛系数（0 到 1）：
// 体积重大于实重时，计费重 = 实重 + （体积重 − 实重）× 分抛系数；系数为 1 即取两者较大者。
model CarrierChannel {
  id                String              @id @default(cuid())
  tenantId          String
  carrierId         String
  name              String
  code              String
  volumetricDivisor Decimal             @default(6000) @db.Decimal(12, 2)
  splitFactor       Decimal             @default(1) @db.Decimal(6, 4)
  status            String              @default("ACTIVE")
  version           Int                 @default(1)
  createdBy         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carrier           Carrier             @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  rates             ChannelRate[]
  shipments         FirstMileShipment[]

  @@unique([tenantId, carrierId, code], map: "CarrierChannel_code_uq")
  @@index([carrierId], map: "CarrierChannel_carrier_idx")
}

// 渠道阶梯报价：某目的地区、重量段 [weightFrom, weightTo)（下限含、上限不含，上限为空表示无上限）、生效区间（两端含，截止为空表示长期有效）。
// billingMode: PER_KG（计费重 × 单价）、PER_CBM（体积 × 单价）、FLAT（该段一口价，不乘重量）。同渠道、同地区、重量段重叠的报价生效区间不得重叠。
model ChannelRate {
  id            String         @id @default(cuid())
  tenantId      String
  channelId     String
  region        String
  weightFrom    Decimal        @db.Decimal(14, 4)
  weightTo      Decimal?       @db.Decimal(14, 4)
  unitPrice     Decimal        @db.Decimal(20, 6)
  currency      String         @default("USD")
  billingMode   String         @default("PER_KG")
  effectiveFrom DateTime       @db.Date
  effectiveTo   DateTime?      @db.Date
  version       Int            @default(1)
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel       CarrierChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channelId, region, weightFrom, effectiveFrom], map: "ChannelRate_uq")
  @@index([channelId], map: "ChannelRate_channel_idx")
}

// ---- M-P6-27：审批收件箱 ----

// 统一的审批记录。type：FINANCE_POLICY、PROFIT_FORMULA、PERIOD_CLOSE、PRICING_RULE_CONFIRM、ADS_RULE_CONFIRM、BULK_PRICE、BULK_BUDGET；
// status：PENDING、APPROVED、REJECTED、CANCELLED（数据库 CHECK）。同一对象同一类型至多一条 PENDING（部分唯一索引 ApprovalRequest_pending_uq，Prisma 无法表达，只写在迁移里）。
// approverIds 是登记时有该单据审批权限的在职成员（不含发起人）；各模块原有的审批逻辑仍是事实来源，状态变化双向同步。
model ApprovalRequest {
  id          String    @id @default(cuid())
  tenantId    String
  type        String
  objectType  String
  objectId    String
  title       String
  summary     Json      @default("{}")
  requesterId String
  approverIds String[]  @default([])
  ccIds       String[]  @default([])
  status      String    @default("PENDING")
  decidedBy   String?
  decidedAt   DateTime?
  comment     String?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, requesterId, createdAt], map: "ApprovalRequest_requester_idx")
  @@index([tenantId, status, createdAt], map: "ApprovalRequest_status_idx")
  @@index([tenantId, type, objectType, objectId], map: "ApprovalRequest_object_idx")
}

// M-P6-29：新品定价试算记录。saved 区分“24 小时参数缓存”和用户点了保存的记录（name 可空，不能靠它区分）。
// 缓存不另用 Redis：同样参数看 inputHash + estimatedAt（24 小时内复用最近一条，租户内可复用，列表只看自己的）。
model PricingCalcRecord {
  id          String   @id @default(cuid())
  tenantId    String
  name        String?
  inputHash   String
  inputJson   Json
  resultJson  Json
  estimatedAt DateTime
  createdBy   String
  saved       Boolean  @default(false)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, inputHash, estimatedAt], map: "PricingCalcRecord_hash_idx")
  @@index([tenantId, createdBy, estimatedAt], map: "PricingCalcRecord_owner_idx")
}

// M-P6-32：自定义指标。expression 存 { text, ast }；dimensions 是适用的数据源维度代码。
model CustomMetric {
  id         String   @id @default(cuid())
  tenantId   String
  key        String
  name       String
  expression Json
  dimensions String[] @default([])
  format     Json
  version    Int      @default(1)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key], map: "CustomMetric_key_uq")
  @@index([tenantId, createdBy], map: "CustomMetric_owner_idx")
}

// M-P6-32：我的报表。收藏是 starredBy（用户编号数组）；定时在 schedule（UTC 小时）。
model CustomReport {
  id        String   @id @default(cuid())
  tenantId  String
  ownerId   String
  name      String
  shared    Boolean  @default(false)
  source    String
  config    Json
  schedule  Json?
  starredBy String[] @default([])
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerId], map: "CustomReport_owner_idx")
  @@index([tenantId, shared], map: "CustomReport_shared_idx")
}

// 自定义仪表盘文件夹（P6-33）。上级为空是根目录。删除上级时子文件夹一并删除。
model DashboardFolder {
  id        String            @id @default(cuid())
  tenantId  String
  parentId  String?
  ownerId   String
  name      String
  version   Int               @default(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    DashboardFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DashboardFolder[] @relation("FolderTree")
  dashboards Dashboard[]

  @@unique([tenantId, ownerId, parentId, name], map: "DashboardFolder_name_uq")
  @@index([parentId], map: "DashboardFolder_parent_idx")
  @@index([tenantId, ownerId], map: "DashboardFolder_owner_idx")
}

// 自定义仪表盘（P6-33）。layout 是 12 列网格。refreshMinutes 为空表示不自动刷新，最快 5 分钟。
model Dashboard {
  id             String             @id @default(cuid())
  tenantId       String
  folderId       String?
  ownerId        String
  name           String
  shared         Boolean            @default(false)
  layout         Json
  refreshMinutes Int?
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder         DashboardFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  widgets        DashboardWidget[]

  @@unique([tenantId, ownerId, folderId, name], map: "Dashboard_name_uq")
  @@index([folderId], map: "Dashboard_folder_idx")
  @@index([tenantId, ownerId], map: "Dashboard_owner_idx")
  @@index([tenantId, shared], map: "Dashboard_shared_idx")
}

// 仪表盘组件（P6-33）。query 绑定 P6-32 数据源；文本组件的 query 为空对象。
model DashboardWidget {
  id          String    @id @default(cuid())
  tenantId    String
  dashboardId String
  type        String
  query       Json
  options     Json
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([tenantId, dashboardId], map: "DashboardWidget_dash_idx")
  @@index([dashboardId], map: "DashboardWidget_dashfk_idx")
}

// 运单明细（每个 SKU 一行）：体积（立方米）、重量（千克）、货值为空表示没填，按对应口径分摊时必须全部填写。purchaseOrderId 记这批货来自哪张采购单（可空）。
model FirstMileShipmentItem {
  id              String            @id @default(cuid())
  tenantId        String
  shipmentId      String
  sku             String
  purchaseOrderId String?
  quantity        Int
  cartons         Int?
  volumeCbm       Decimal?          @db.Decimal(14, 4)
  weightKg        Decimal?          @db.Decimal(14, 4)
  goodsValue      Decimal?          @db.Decimal(20, 6)
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment        FirstMileShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@unique([shipmentId, sku], map: "FirstMileItem_uq")
  @@index([tenantId, sku], map: "FirstMileItem_sku_idx")
  @@index([purchaseOrderId], map: "FirstMileItem_po_idx")
}

// 头程费用明细。item: FREIGHT（运费）、CLEARANCE（清关费）、DUTY（关税）、DELIVERY（送仓费）、SURCHARGE（附加费）。
model FirstMileCost {
  id         String            @id @default(cuid())
  tenantId   String
  shipmentId String
  item       String
  amount     Decimal           @db.Decimal(20, 6)
  currency   String
  incurredAt DateTime          @db.Date
  note       String?
  createdBy  String
  createdAt  DateTime          @default(now())
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment   FirstMileShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, shipmentId], map: "FirstMileCost_ship_idx")
  @@index([shipmentId], map: "FirstMileCost_fk_idx")
}

// 运输节点。source: MANUAL（我方录入）、FILE_IMPORT（货代文件导入）、API（接口；Tracking API 是否覆盖入仓货件尚未实测，目前不会出现）。
model FirstMileMilestone {
  id         String            @id @default(cuid())
  tenantId   String
  shipmentId String
  milestone  String
  occurredAt DateTime
  location   String?
  source     String
  note       String?
  createdBy  String?
  createdAt  DateTime          @default(now())
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment   FirstMileShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, milestone, occurredAt], map: "FirstMileMilestone_uq")
  @@index([tenantId, occurredAt], map: "FirstMileMilestone_time_idx")
}

// 头程费用分摊结果（每个运单每个 SKU 一行；重新分摊先撤销旧结果）。method: VOLUME、WEIGHT、VALUE、QTY。
// costVersionId 指向同时写入的成本版本草稿（source = FIRST_MILE_ALLOCATION，sourceDocId = 运单编号）。
model LandedCostAllocation {
  id                  String            @id @default(cuid())
  tenantId            String
  firstMileShipmentId String
  sku                 String
  method              String
  quantity            Int
  allocatedAmount     Decimal           @db.Decimal(20, 6)
  currency            String
  costVersionId       String?
  createdBy           String
  createdAt           DateTime          @default(now())
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment            FirstMileShipment @relation(fields: [firstMileShipmentId], references: [id], onDelete: Cascade)
  costVersion         CostVersion?      @relation(fields: [costVersionId], references: [id], onDelete: SetNull)

  @@unique([firstMileShipmentId, sku, method], map: "LandedCost_uq")
  @@index([tenantId, sku], map: "LandedCost_sku_idx")
  @@index([costVersionId], map: "LandedCost_cv_idx")
}

// 实际时效统计（发货日到实际交付日，自然日）：按货代、运输方式、实际交付所在月份。p50、p90 是该月样本的分位数（最近邻法）。
model TransitTimeStat {
  id          String           @id @default(cuid())
  tenantId    String
  forwarderId String
  mode        String
  periodMonth DateTime         @db.Date
  sampleCount Int
  p50Days     Int
  p90Days     Int
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  forwarder   FreightForwarder @relation(fields: [forwarderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, forwarderId, mode, periodMonth], map: "TransitTimeStat_uq")
  @@index([forwarderId], map: "TransitTimeStat_fwd_idx")
}

// ---- M-P1-26：订单接口与财务接口升级新增的表 ----

// 按月分区表（分区列 purchaseDate）。订单收入、费用、促销、税的逐项金额；与所属订单同一分区日期。
model OrderCharge {
  id                String        @default(cuid())
  tenantId          String
  sellerAccountId   String
  orderId           String
  orderItemId       String
  amazonOrderId     String
  purchaseDate      DateTime
  chargeKind        String
  componentKey      String
  amount            Decimal       @db.Decimal(20, 6)
  currency          String        @default("USD")
  feeCategory       String?
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  order             Order         @relation(fields: [orderId, purchaseDate], references: [id, purchaseDate], onDelete: Cascade)

  @@id([id, purchaseDate])
  @@unique([sellerAccountId, orderItemId, chargeKind, componentKey, purchaseDate], map: "OrderCharge_dedupe_key")
  @@index([tenantId, purchaseDate])
  @@index([orderId, purchaseDate])
  @@index([tenantId, amazonOrderId])
}

// 订单状态变化记录：每次接口、推送或报告带来新的状态就追加一条，不覆盖。
model OrderStatusHistory {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  orderId           String
  orderPurchaseDate DateTime
  status            String
  occurredAt        DateTime
  source            String
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime      @default(now())
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  order             Order         @relation(fields: [orderId, orderPurchaseDate], references: [id, purchaseDate], onDelete: Cascade)

  @@unique([orderId, status, sourceUpdatedAt])
  @@index([tenantId, occurredAt])
  @@index([sellerAccountId, occurredAt])
  @@index([orderId, orderPurchaseDate])
}

model OrderPackage {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  orderId           String
  orderPurchaseDate DateTime
  packageId         String
  carrier           String        @default("")
  trackingNumber    String        @default("")
  shippingService   String?
  packageStatus     String?
  shipDate          DateTime?
  deliveredAt       DateTime?
  fulfillmentCenter String?
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  order             Order         @relation(fields: [orderId, orderPurchaseDate], references: [id, purchaseDate], onDelete: Cascade)

  @@unique([sellerAccountId, orderId, packageId, trackingNumber], map: "OrderPackage_dedupe_key")
  @@index([tenantId, shipDate])
  @@index([orderId, orderPurchaseDate])
}

model OrderCancellation {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  orderId           String
  orderPurchaseDate DateTime
  cancelledBy       String
  reasonCode        String        @default("")
  requestedAt       DateTime?
  cancelledAt       DateTime?
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  order             Order         @relation(fields: [orderId, orderPurchaseDate], references: [id, purchaseDate], onDelete: Cascade)

  @@unique([sellerAccountId, orderId])
  @@index([tenantId, cancelledAt])
  @@index([orderId, orderPurchaseDate])
}

// 账户余额快照：每天每种余额类型一行（含账户类型，同一余额类型在不同账户类型下并存）。
model AccountBalanceSnapshot {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  snapshotDate      DateTime      @db.Date
  balanceType       String
  accountType       String        @default("")
  currency          String
  amount            Decimal       @db.Decimal(20, 6)
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, snapshotDate, currency, balanceType, accountType], map: "AccountBalanceSnapshot_dedupe_key")
  @@index([tenantId, snapshotDate])
  @@index([sellerAccountId, snapshotDate])
}

// 新旧接口并行双跑的通道状态：每个店铺、每个数据域一行；旧通道核对通过后关闭。
model ConnectorChannelState {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  domain            String
  legacyEnabled     Boolean       @default(true)
  consecutivePasses Int           @default(0)
  requiredPasses    Int           @default(7)
  lastRunAt         DateTime?
  closedAt          DateTime?
  closedReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, domain])
  @@index([tenantId, domain])
}

// 一次核对：同一时间窗内，新旧接口各拉一遍并逐项比对。
model ConnectorParityRun {
  id               String                @id @default(cuid())
  tenantId         String
  sellerAccountId  String
  domain           String
  windowStart      DateTime
  windowEnd        DateTime
  legacyCount      Int                   @default(0)
  newCount         Int                   @default(0)
  matchedCount     Int                   @default(0)
  unexplainedCount Int                   @default(0)
  status           String
  syncJobId        String?
  startedAt        DateTime              @default(now())
  finishedAt       DateTime?
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount    SellerAccount         @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  diffs            ConnectorParityDiff[]

  @@index([tenantId, sellerAccountId, domain, startedAt])
  @@index([sellerAccountId, startedAt])
}

// 核对差异：每条差异必须归入四类之一（时间口径、归因口径、范围、未解释），并写明原因。
model ConnectorParityDiff {
  id          String             @id @default(cuid())
  tenantId    String
  runId       String
  category    String
  entityKey   String
  field       String
  legacyValue String?
  newValue    String?
  explanation String
  createdAt   DateTime           @default(now())
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run         ConnectorParityRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, category])
  @@index([tenantId, createdAt])
}

// ============================================================
// P1-28 平台能力（M-P1-28）：写入开关、汇率、待办、预警、通知、导出、保存视图、协作、推送订阅、数据新鲜度
// ============================================================

// 亚马逊写入开关：每个企业 20 项，默认全部关闭。sellerAccountId 为空表示企业级（本期只用企业级）。
// statsJson 按日保存写调用与失败次数（只保留最近 7 天），calls7d/failures7d 是由它派生的缓存。
model IntegrationSwitch {
  id                  String         @id @default(cuid())
  tenantId            String
  sellerAccountId     String?
  switchKey           String
  enabled             Boolean        @default(false)
  enabledAt           DateTime?
  enabledBy           String?
  reason              String?
  autoDisabledReason  String?
  consecutiveFailures Int            @default(0)
  calls7d             Int            @default(0)
  failures7d          Int            @default(0)
  statsJson           Json?
  version             Int            @default(1)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount       SellerAccount? @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, switchKey])
  @@index([sellerAccountId])
}

// 开关变更记录：开启、关闭、自动关闭、一键只读、紧急关闭，保存变更前后的状态。
model IntegrationSwitchLog {
  id              String   @id @default(cuid())
  tenantId        String
  sellerAccountId String?
  switchKey       String
  action          String
  reason          String
  actorId         String?
  beforeJson      Json
  afterJson       Json
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sellerAccountId, switchKey, createdAt])
}

// 每日汇率：以美元为基准，rate 为 1 美元折合的外币金额。期间关账后 lockedByPeriodId 不为空，数据库禁止修改与删除。
model FxRate {
  id               String    @id @default(cuid())
  tenantId         String
  baseCurrency     String    @default("USD")
  quoteCurrency    String
  rateDate         DateTime  @db.Date
  rate             Decimal   @db.Decimal(18, 8)
  source           String
  isFallback       Boolean   @default(false)
  sourceDate       DateTime? @db.Date
  isManualOverride Boolean   @default(false)
  overrideReason   String?
  overriddenBy     String?
  lockedByPeriodId String?
  fetchedAt        DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, baseCurrency, quoteCurrency, rateDate, source])
  @@index([tenantId, quoteCurrency, rateDate])
}

// 汇率来源配置：每个企业一个主源、一个备源；最近一次获取状态也记在这里。
model FxSourceConfig {
  id                  String    @id @default(cuid())
  tenantId            String
  role                String
  provider            String
  pathTemplate        String
  priority            Int       @default(1)
  enabled             Boolean   @default(true)
  lastAttemptAt       DateTime?
  lastSuccessAt       DateTime?
  lastStatus          String?
  lastErrorCode       String?
  consecutiveFailures Int       @default(0)
  updatedBy           String?
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role])
}

// 待办：由预警自动生成或人工创建。状态 PENDING、IN_PROGRESS、DONE、CLOSED；关闭结论 HANDLED、NOT_NEEDED、FALSE_POSITIVE、IGNORED。
model WorkItem {
  id              String       @id @default(cuid())
  tenantId        String
  sellerAccountId String?
  title           String
  kind            String
  source          String       @default("MANUAL")
  status          String       @default("PENDING")
  priority        String       @default("NORMAL")
  severity        String       @default("INFO")
  dueAt           DateTime?
  slaBreachedAt   DateTime?
  escalatedAt     DateTime?
  sourceAlertId   String?
  ruleCode        String?
  entityType      String?
  entityId        String?
  entityLabel     String?
  impactMin       Decimal?     @db.Decimal(20, 6)
  impactMax       Decimal?     @db.Decimal(20, 6)
  currency        String       @default("USD")
  suggestedAction String?
  detail          String?
  closeConclusion String?
  closeNote       String?
  ignoreReason    String?
  deferredUntil   DateTime?
  ackAt           DateTime?
  closedAt        DateTime?
  closedBy        String?
  ownerId         String
  createdBy       String
  version         Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments     Assignment[]

  @@index([tenantId, ownerId, status])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, createdBy])
  @@index([tenantId, sourceAlertId])
  @@index([tenantId, ruleCode, closedAt])
}

// 待办指派记录（转派会新增一条，保留历史）。
model Assignment {
  id         String    @id @default(cuid())
  tenantId   String
  workItemId String
  assigneeId String
  assignedBy String
  assignedAt DateTime  @default(now())
  acceptedAt DateTime?
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem   WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, assigneeId])
  @@index([tenantId, assigneeId])
}

// 预警规则：条件由评估器解释；每次改动生成新版本。
model AlertRule {
  id              String             @id @default(cuid())
  tenantId        String
  code            String
  domain          String
  name            String
  conditionJson   Json
  severity        String             @default("WARNING")
  cooldownMinutes Int                @default(60)
  enabled         Boolean            @default(true)
  scopeJson       Json
  // P6-16：自定义指标规则的条件（ConditionGroups，评估器类型 CUSTOM_METRIC 才有）；通知频率（IMMEDIATE / HOURLY / DAILY，检查约束）；多级升级（[{ afterMinutes }]，最多 3 级，没有为空）。
  conditionGroups Json?
  notifyFrequency String             @default("IMMEDIATE")
  escalation      Json?
  currentVersion  Int                @default(1)
  version         Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions        AlertRuleVersion[]
  instances       AlertInstance[]
  digests         AlertDigest[]

  @@unique([tenantId, code])
}

model AlertRuleVersion {
  id            String    @id @default(cuid())
  tenantId      String
  ruleId        String
  versionNo     Int
  conditionJson Json
  changedBy     String
  changeReason  String
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule          AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, versionNo])
  @@index([tenantId, ruleId])
}

// 预警实例：同一规则同一对象在“新”状态下只有一条（部分唯一索引，迁移里手写），重复触发只刷新最近触发时间与次数。
model AlertInstance {
  id               String      @id @default(cuid())
  tenantId         String
  sellerAccountId  String?
  ruleId           String
  ruleVersionNo    Int
  entityType       String
  entityId         String
  severity         String
  status           String      @default("NEW")
  firstTriggeredAt DateTime    @default(now())
  lastTriggeredAt  DateTime    @default(now())
  triggerCount     Int         @default(1)
  evidenceJson     Json
  dedupKey         String
  workItemId       String?
  resolvedAt       DateTime?
  // P5-01：人工处理的结论（HANDLED / NOT_NEEDED / FALSE_POSITIVE / IGNORED，检查约束），自动恢复的为空；用于误报率与处理时长统计。
  closeConclusion  String?
  closeNote        String?
  closedBy         String?
  // 展示用：标题、对象名称、建议、影响金额区间（评估器每次命中都刷新为最新值；旧实例为空）。
  title            String?
  entityLabel      String?
  suggestedAction  String?
  impactMin        Decimal?    @db.Decimal(20, 6)
  impactMax        Decimal?    @db.Decimal(20, 6)
  currency         String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule             AlertRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  reads            AlertRead[]

  @@index([tenantId, ruleId, status])
  @@index([tenantId, status, lastTriggeredAt])
  @@index([tenantId, ruleId, firstTriggeredAt], map: "AlertInstance_rule_stats_idx")
  @@index([tenantId, sellerAccountId, firstTriggeredAt], map: "AlertInstance_store_time_idx")
  @@index([ruleId])
}

// 预警的已读状态（P6-15）：按用户记录，与预警的处理状态（AlertInstance.status）互不影响；同一用户同一条预警至多一行。
// 预警被删除时连带删除；用户不设外键（成员被移除后留下的已读记录无害，随预警清理）。
model AlertRead {
  id       String        @id @default(cuid())
  tenantId String
  alertId  String
  userId   String
  readAt   DateTime      @default(now())
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alert    AlertInstance @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId])
  @@index([tenantId, userId])
}

// 预警汇总批次与升级记录（P6-16）。dedupKey 在企业内唯一，既是批次的幂等键，也是多个后台进程同时扫描时“认领”的依据：
// - FREQUENCY：按通知频率汇总，dedupKey = freq:{ruleId}:{时段}（每小时为 UTC 小时，每日为企业时区的日期），时段结束后发一条汇总；
// - QUIET：静默时段内产生的预警，dedupKey 在待发送时是 quiet:{ruleId}:pending，静默结束发送时改成带发送时间的键，下一个静默时段另起一批；
// - ESCALATION：某条预警的第 N 级升级已通知（dedupKey = esc:{预警编号}:{级别}），一行就是一次已发出的升级，状态直接为 SENT。
// alertIds 是并入这一批的预警编号（最多 500 个）；status 为 PENDING（待发送）或 SENT（已发送，sentAt 有值）。
model AlertDigest {
  id        String    @id @default(cuid())
  tenantId  String
  ruleId    String
  kind      String
  dedupKey  String
  status    String    @default("PENDING")
  alertIds  Json      @default("[]")
  itemCount Int       @default(0)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule      AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupKey])
  @@index([tenantId, status, kind])
  @@index([ruleId])
}

// 站内通知（消息中心）。dedupKey 不为空时同一用户同一键只保留一条（部分唯一索引，迁移里手写）。
model Notification {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String
  kind         String
  title        String
  body         String
  link         String?
  severity     String    @default("INFO")
  readAt       DateTime?
  dedupKey     String?
  createdAt    DateTime  @default(now())
  // P5-11：业务域（库存、财务、广告等，用于按业务域筛选与偏好）；旧通知没有
  domain       String?
  // P5-11：免打扰期间收到的通知（不计入顶栏未读数）；时段结束后合并成一条汇总，汇总时写下 summarizedAt
  silencedAt   DateTime?
  summarizedAt DateTime?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, silencedAt, summarizedAt])
}

// 个人偏好（P5-11）：每个成员在每个企业里一行（通知偏好、免打扰时段）；P6-01 起在同一行补收藏与密度。
// notifyJson 的格式见 packages/api-contracts/src/profile.ts（NotifyPrefs）；没有记录表示全部接收、免打扰关闭。version 做乐观锁。
// favoriteRoutes：侧边导航收藏的路由模板（最多 30 个，数据库 CHECK 兜底）；density：界面密度（COMPACT/STANDARD，CHECK 约束）。
model UserPreference {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  notifyJson     Json     @default("{}")
  favoriteRoutes String[] @default([])
  density        String   @default("STANDARD")
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId], map: "UserPreference_uq")
}

// 导出任务：流式生成、字段按发起人权限过滤、文件签名链接下载。
model ExportJob {
  id                  String    @id @default(cuid())
  tenantId            String
  kind                String
  sourcePage          String
  filterSummary       String
  filterJson          Json
  format              String
  status              String    @default("QUEUED")
  rowCount            Int?
  fileKey             String?
  fileSize            Int?
  errorCode           String?
  expiresAt           DateTime
  requestedBy         String
  fieldPolicySnapshot Json
  startedAt           DateTime?
  finishedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, requestedBy, createdAt])
  @@index([status, expiresAt])
}

// 保存视图：个人或团队共享；每人每页最多一个默认视图（部分唯一索引，迁移里手写）。
model SavedView {
  id          String   @id @default(cuid())
  tenantId    String
  pageKey     String
  name        String
  filterJson  Json
  columnsJson Json
  sortJson    Json
  ownerId     String
  shared      Boolean  @default(false)
  isDefault   Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([ownerId, pageKey, name])
  @@index([tenantId, pageKey, shared])
}

// 表格视图与筛选方案（P6-03）：列显示、顺序、列宽、固定、排序、筛选、维度，分系统、团队共享、个人三级。
// scope=USER 时 ownerUserId 为本人，其余为空；createdBy 记创建人（团队视图展示用）。
// 唯一性与“至多一个默认”用部分唯一索引保证（写在迁移里，Prisma 模型表达不了，migrate diff 不比较部分索引）。
model GridView {
  id          String   @id @default(cuid())
  tenantId    String
  gridId      String
  kind        String   @default("VIEW")
  scope       String
  ownerUserId String?
  createdBy   String?
  name        String
  config      Json
  isDefault   Boolean  @default(false)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, gridId, kind])
}

// 对象事件时间线：改价、改预算、改刊登、入仓确认、成本变更、预警、手工记录等。
model EntityEvent {
  id              String   @id @default(cuid())
  tenantId        String
  sellerAccountId String?
  entityType      String
  entityId        String
  kind            String
  occurredAt      DateTime
  title           String
  detailJson      Json?
  actorKind       String   @default("SYSTEM")
  actorId         String?
  sourceRef       String?
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, entityId, kind, occurredAt, sourceRef])
  @@index([tenantId, entityType, entityId, occurredAt])
}

// 运营日志：运营人员手工记录的店铺、ASIN、广告活动层面的动作。
model OperationLog {
  id              String   @id @default(cuid())
  tenantId        String
  sellerAccountId String?
  scope           String
  scopeRef        String
  occurredAt      DateTime
  category        String
  text            String
  authorId        String
  attachmentIds   String[]
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope, scopeRef, occurredAt])
}

model Comment {
  id         String    @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String
  body       String
  mentions   String[]
  authorId   String
  parentId   String?
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId, createdAt])
}

model Watch {
  id         String   @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String
  userId     String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([tenantId, entityType, entityId])
}

// 亚马逊通知订阅：每个店铺每个通知类型一条。destinationId 来自部署专项创建的接收端；未创建时状态为 NOT_CREATED。
model NotificationSubscription {
  id               String        @id @default(cuid())
  tenantId         String
  sellerAccountId  String
  destinationId    String
  notificationType String
  subscriptionId   String
  filterJson       Json?
  status           String        @default("NOT_CREATED")
  lastReceivedAt   DateTime?
  events24h        Int           @default(0)
  failures24h      Int           @default(0)
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount    SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, destinationId, notificationType])
  @@index([tenantId, status])
}

// 收到的亚马逊通知（按月分区，分区列 receivedAt，保留 90 天）。消息体存对象存储，库内只存引用。
model AmazonNotificationEvent {
  id               String         @default(cuid())
  tenantId         String
  sellerAccountId  String?
  notificationId   String
  notificationType String
  receivedAt       DateTime       @default(now())
  payloadObjectKey String
  status           String         @default("RECEIVED")
  attempts         Int            @default(0)
  processedAt      DateTime?
  errorCode        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount    SellerAccount? @relation(fields: [sellerAccountId], references: [id], onDelete: SetNull)

  @@id([id, receivedAt])
  @@unique([tenantId, notificationId, receivedAt])
  @@index([tenantId, notificationType, receivedAt])
  @@index([tenantId, status, receivedAt])
  @@index([sellerAccountId])
}

// 数据新鲜度：每个数据来源（订单、财务、库存……）最近一次尝试与成功的时间。sellerAccountId 为空表示企业级来源（如汇率）。
model DataFreshness {
  id              String         @id @default(cuid())
  tenantId        String
  sellerAccountId String?
  sourceKey       String
  lastAttemptAt   DateTime
  lastSuccessAt   DateTime?
  dataThrough     DateTime?
  lastRowCount    Int            @default(0)
  status          String         @default("NORMAL")
  lastErrorCode   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount? @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, sourceKey])
  @@index([sellerAccountId])
}

// 企业设置项（键值）：汇率附加币种、待办时限等。sellerAccountId 为空表示企业级。
model TenantSetting {
  id              String         @id @default(cuid())
  tenantId        String
  sellerAccountId String?
  key             String
  valueJson       Json
  scope           String         @default("TENANT")
  updatedBy       String
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount? @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, key])
  @@index([sellerAccountId])
}

// 经营目标（P2a-04，04 章 4.4）：按店铺 × 期间设置的目标值，可细化到类目或 ASIN 组（dimensionRef 为逗号分隔的 ASIN 列表或类目路径）。
// 整店目标的 dimensionRef 固定为 'ALL'。version 用于乐观锁：多人同时编辑时后写入的一方必须带上自己看到的版本号。
model BusinessTarget {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  periodKind      String        @default("MONTH")
  periodStart     DateTime      @db.Date
  dimension       String        @default("STORE")
  dimensionRef    String        @default("ALL")
  metric          String
  targetValue     Decimal       @db.Decimal(20, 6)
  paceMode        String        @default("LINEAR")
  note            String?
  version         Int           @default(1)
  updatedBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, periodKind, periodStart, dimension, dimensionRef, metric], map: "business_target_cell_key")
  @@index([tenantId, sellerAccountId, periodStart])
  @@index([sellerAccountId])
}

// 经营日汇总（P2a-01，10 章 10.1）：店铺 × 日，由派生任务增量刷新（先删后写、同一事务，可重复执行）。
// summaryDate 是数据口径时区（企业的 timezone，默认美国太平洋时区）的日历日。
// 可空列为空 = 来源还没有接入或没有数据（不是 0）：广告需要店铺绑定（P3-03）、利润需要利润日表（P2b-09）、会话需要业务报告（P4-01）。
model StoreDailySummary {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  summaryDate     DateTime      @db.Date
  orders          Int           @default(0)
  units           Int           @default(0)
  salesAmount     Decimal       @default(0) @db.Decimal(20, 6)
  refundAmount    Decimal       @default(0) @db.Decimal(20, 6)
  feeAmount       Decimal       @default(0) @db.Decimal(20, 6)
  adsSpend        Decimal?      @db.Decimal(20, 6)
  adsSales        Decimal?      @db.Decimal(20, 6)
  profit          Decimal?      @db.Decimal(20, 6)
  sessions        Int?
  currency        String        @default("USD")
  metricVersion   String
  salesSource     String        @default("ORDERS")
  refreshedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, summaryDate])
  @@index([tenantId, summaryDate])
  @@index([sellerAccountId])
}

// ASIN 日汇总（P2a-01）：店铺 × ASIN × 日。口径同上；库存、会话、广告、利润随各自工作包接入前为空。
model AsinDailySummary {
  id                 String        @id @default(cuid())
  tenantId           String
  sellerAccountId    String
  summaryDate        DateTime      @db.Date
  asin               String
  sku                String?
  units              Int           @default(0)
  salesAmount        Decimal       @default(0) @db.Decimal(20, 6)
  sessions           Int?
  pageViews          Int?
  buyBoxPct          Decimal?      @db.Decimal(9, 6)
  adsSpend           Decimal?      @db.Decimal(20, 6)
  adsSales           Decimal?      @db.Decimal(20, 6)
  profit             Decimal?      @db.Decimal(20, 6)
  inventoryAvailable Int?
  currency           String        @default("USD")
  metricVersion      String
  salesSource        String        @default("ORDERS")
  refreshedAt        DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount      SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, asin, summaryDate])
  @@index([tenantId, summaryDate])
  @@index([tenantId, sellerAccountId, summaryDate])
  @@index([sellerAccountId])
}

// 广告日汇总（P3-04，10 章 10.1）：广告档案 × 广告产品 × 活动 × 日 × 币种，由派生任务 ads_daily_summary 先删后写（可重复执行）。
// 数据来自 AdsMetric 里 entityType = CAMPAIGN 的行（其他对象类型的行是同一笔花费的更细拆分，加进来会重复计数）。
// 与冻结的出入：键用 adsProfileId（档案，永远有值）而不是店铺编号与账户编号——AdsMetric 的旧行没有账户编号，店铺绑定也会变化，
// 所以汇总不存店铺；读取方按 AdsProfile.sellerAccountId 过滤范围（与 adsProfileWhere 一致）。adsAccountId 只是来源行或档案上的账户编号文本，可空，没有外键。
// campaignId 为空串表示来源行没有活动编号（账户级）。summaryDate 是广告账户自己的报告日（广告接口按档案时区出报告），不换算到企业时区。
// spend、sales 为空 = 来源行都没给（不是 0）。
model AdsDailySummary {
  id            String     @id @default(cuid())
  tenantId      String
  adsProfileId  String
  adsAccountId  String?
  adProduct     String
  campaignId    String     @default("")
  summaryDate   DateTime   @db.Date
  impressions   Int        @default(0)
  clicks        Int        @default(0)
  spend         Decimal?   @db.Decimal(20, 6)
  sales         Decimal?   @db.Decimal(20, 6)
  orders        Int        @default(0)
  currency      String     @default("USD")
  metricVersion String
  refreshedAt   DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile    AdsProfile @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, adsProfileId, adProduct, campaignId, summaryDate, currency], map: "AdsDailySummary_uq")
  @@index([tenantId, summaryDate], map: "AdsDailySummary_date_idx")
  @@index([adsProfileId], map: "AdsDailySummary_profile_idx")
}

// 利润日表（P2b-09，07 章 7.9、10 章 10.1）：店铺 × SKU × 日 × 收入确认口径，由派生任务 profit_daily 先删后写（可重复执行）。
// profitDate 是企业数据口径时区的日历日。sku 为 '__STORE__' 的是店铺级行（没有 SKU 的费用与账户级广告）。
// basis: ORDERED、SHIPPED、SETTLED；costing: FIFO、MOVING_AVG、MONTH_AVG（该行计算时企业设置的存货计价）。
// 金额都是店铺币种（美元）；费用、退款、促销、成本是正数的“花费”。可空列为空 = 没有数据来源或没算出来（不是 0）：
//   adsSpendAllocated 在广告阶段（P3-16）之前永远为空；adsUnallocated 只在店铺级行且广告已接入时有值；productCost 等成本列在成本不全时为空；
//   profit 在卖出的件数没有被采购成本完全覆盖时为空。costCurrency 与 productCostOriginal、fxRate、fxSource、fxFallback 记录成本的原币金额与折算依据。
// flags 是数据质量标记（见契约 PROFIT_FLAGS）。
model ProfitDaily {
  id                    String        @id @default(cuid())
  tenantId              String
  sellerAccountId       String
  profitDate            DateTime      @db.Date
  sku                   String
  asin                  String?
  basis                 String
  costing               String
  currency              String        @default("USD")
  units                 Int           @default(0)
  costedUnits           Int           @default(0)
  revenue               Decimal       @default(0) @db.Decimal(20, 6)
  refunds               Decimal       @default(0) @db.Decimal(20, 6)
  feeCommission         Decimal       @default(0) @db.Decimal(20, 6)
  feeFulfillment        Decimal       @default(0) @db.Decimal(20, 6)
  feeStorage            Decimal       @default(0) @db.Decimal(20, 6)
  feeAged               Decimal       @default(0) @db.Decimal(20, 6)
  feeInbound            Decimal       @default(0) @db.Decimal(20, 6)
  feeOther              Decimal       @default(0) @db.Decimal(20, 6)
  promotion             Decimal       @default(0) @db.Decimal(20, 6)
  adsSpendAllocated     Decimal?      @db.Decimal(20, 6)
  adsUnallocated        Decimal?      @db.Decimal(20, 6)
  productCost           Decimal?      @db.Decimal(20, 6)
  firstMileCost         Decimal?      @db.Decimal(20, 6)
  otherCost             Decimal?      @db.Decimal(20, 6)
  // P6-18：关税（来自生效成本版本的单件关税，空 = 没有关税成本流，不是 0）；itemAmounts 是按利润项目字典拆开的、对净利润的带符号贡献
  // （键为项目编号，未映射的交易类型键为 "~:" 加默认归入的利润桥项目）；空 = 租户还没有字典或这一行没有交易明细。
  dutyCost              Decimal?      @db.Decimal(20, 6)
  itemAmounts           Json?
  // P6-20：这一行里估算（预估与自定义费用）计入的花费合计，已经包含在上面各费用列与净利润里；空 = 这一行没有估算。
  estimatedFee          Decimal?      @db.Decimal(20, 6)
  reimbursement         Decimal       @default(0) @db.Decimal(20, 6)
  profit                Decimal?      @db.Decimal(20, 6)
  costCoverage          Decimal?      @db.Decimal(9, 6)
  costCurrency          String?
  productCostOriginal   Decimal?      @db.Decimal(20, 6)
  firstMileCostOriginal Decimal?      @db.Decimal(20, 6)
  fxRate                Decimal?      @db.Decimal(18, 8)
  fxSource              String?
  fxFallback            Boolean       @default(false)
  flags                 String[]      @default([])
  metricVersion         String
  refreshedAt           DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount         SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, sku, profitDate, basis], map: "ProfitDaily_uq")
  @@index([tenantId, basis, profitDate], map: "ProfitDaily_date_idx")
  @@index([sellerAccountId])
}

// 官方单品经济·实际数据（P2b-11，D-04，Data Kiosk economics）：店铺 × MSKU × 日（aggregation 目前只有 DAY）。重复拉取按唯一键覆盖。
// 金额都是 currency 的币种（美元店铺为 USD）：sales 是净销售额（下单销售额 − 退款销售额，退款按退款申请时间计）；feesTotal 是全部费用类型的合计，
// 明细在 feesJson（[{ type, amount }]）；adsSpend 是广告扣款合计（没有广告扣款为 0）。可空列为空 = 官方没给：
//   sellerCostPerUnit 为空表示卖家没有在亚马逊后台填写成本（DK_NO_COST_PROVIDED，不是 0）；netProceeds 为空表示官方没有算出净收益。
model EconomicsDaily {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  date              DateTime      @db.Date
  msku              String
  asin              String?
  aggregation       String        @default("DAY")
  currency          String        @default("USD")
  unitsOrdered      Int           @default(0)
  unitsRefunded     Int           @default(0)
  netUnits          Int           @default(0)
  orderedSales      Decimal       @default(0) @db.Decimal(20, 6)
  refundedSales     Decimal       @default(0) @db.Decimal(20, 6)
  sales             Decimal       @default(0) @db.Decimal(20, 6)
  feesTotal         Decimal       @default(0) @db.Decimal(20, 6)
  feesJson          Json          @default("[]")
  adsSpend          Decimal       @default(0) @db.Decimal(20, 6)
  sellerCostPerUnit Decimal?      @db.Decimal(20, 6)
  costJson          Json?
  netProceeds       Decimal?      @db.Decimal(20, 6)
  syncedAt          DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, msku, date, aggregation], map: "EconomicsDaily_uq")
  @@index([tenantId, date], map: "EconomicsDaily_date_idx")
  @@index([sellerAccountId])
}

// 官方费用预览（P2b-11，D-05，Data Kiosk economicsPreview）：未来最多 120 天的费用预估。每次查询带同一个 queriedAt，页面只看每个店铺最近一次查询的行。
// 亚马逊费用调整日落在区间内时，官方把区间拆成调整前后两段（rangeStart、rangeEnd 是拆分后的区间）；
// amountPerUnitDelta 是调整前后单件费用的变化（没有调整为空），quantity 是官方预估的数量（官方没给为空）。
model EconomicsPreview {
  id                 String        @id @default(cuid())
  tenantId           String
  sellerAccountId    String
  msku               String
  asin               String?
  feeType            String
  rangeStart         DateTime      @db.Date
  rangeEnd           DateTime      @db.Date
  estimatedAmount    Decimal       @db.Decimal(20, 6)
  quantity           Decimal?      @db.Decimal(20, 6)
  amountPerUnit      Decimal?      @db.Decimal(20, 6)
  amountPerUnitDelta Decimal?      @db.Decimal(20, 6)
  currency           String        @default("USD")
  queriedAt          DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount      SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, msku, feeType, rangeStart, rangeEnd], map: "EconomicsPreview_uq")
  @@index([tenantId, queriedAt], map: "EconomicsPreview_time_idx")
  @@index([sellerAccountId])
}

// 小时销售推送（P2a-03，04 章 4.2 / models.md M-P2a-03）：按月 hourStart 分区；幂等键 (sellerAccountId, asin, hourStart)。
// 官方推送不含订单数，orders 暂存 0；延迟最长 24 小时的补发用 isLateArrival 标记，sourceUpdatedAt 较新者覆盖。
model HourlySalesEvent {
  id              String        @default(cuid())
  tenantId        String
  sellerAccountId String
  asin            String
  hourStart       DateTime
  units           Int
  salesAmount     Decimal       @db.Decimal(20, 6)
  currency        String        @default("USD")
  orders          Int           @default(0)
  isLateArrival   Boolean       @default(false)
  sourceUpdatedAt DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@id([id, hourStart])
  @@unique([tenantId, sellerAccountId, asin, hourStart], map: "HourlySalesEvent_uq")
  @@index([tenantId, hourStart], map: "HourlySalesEvent_tenant_hour_idx")
  @@index([tenantId, sellerAccountId, hourStart], map: "HourlySalesEvent_store_hour_idx")
  @@index([sellerAccountId], map: "HourlySalesEvent_store_idx")
}

// 小时详情页流量推送：官方字段为 glanceViews，写入 pageViews；sessions / buyBoxPct 官方推送不含，保持空。
model HourlyTrafficEvent {
  id              String        @default(cuid())
  tenantId        String
  sellerAccountId String
  asin            String
  hourStart       DateTime
  pageViews       Int
  sessions        Int?
  buyBoxPct       Decimal?      @db.Decimal(9, 6)
  isLateArrival   Boolean       @default(false)
  sourceUpdatedAt DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@id([id, hourStart])
  @@unique([tenantId, sellerAccountId, asin, hourStart], map: "HourlyTrafficEvent_uq")
  @@index([tenantId, hourStart], map: "HourlyTrafficEvent_tenant_hour_idx")
  @@index([tenantId, sellerAccountId, hourStart], map: "HourlyTrafficEvent_store_hour_idx")
  @@index([sellerAccountId], map: "HourlyTrafficEvent_store_idx")
}

// 小时可售库存推送：highlyAvailableInventory → availableQty。
model HourlyInventoryEvent {
  id              String        @default(cuid())
  tenantId        String
  sellerAccountId String
  asin            String
  hourStart       DateTime
  availableQty    Int
  isLateArrival   Boolean       @default(false)
  sourceUpdatedAt DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@id([id, hourStart])
  @@unique([tenantId, sellerAccountId, asin, hourStart], map: "HourlyInventoryEvent_uq")
  @@index([tenantId, hourStart], map: "HourlyInventoryEvent_tenant_hour_idx")
  @@index([tenantId, sellerAccountId, hourStart], map: "HourlyInventoryEvent_store_hour_idx")
  @@index([sellerAccountId], map: "HourlyInventoryEvent_store_idx")
}

// ───── P2a-05 库存类同步器（models.md 第十一节，importers.md I-05、R-08～R-22、N-04） ─────
// 数量列允许为空：空表示“这个来源没有报告这一项”，不是 0（MYI、预留、滞留各报各的列，同一天同一商品按来源分行存放）。
// 按月 snapshotDate 分区；幂等键 (sellerAccountId, sku, fnsku, snapshotDate, source)，fnsku 缺失时存空串（唯一键不能含空值）。
model InventoryDailySnapshot {
  id                    String        @default(cuid())
  tenantId              String
  sellerAccountId       String
  snapshotDate          DateTime      @db.Date
  sku                   String
  fnsku                 String        @default("")
  asin                  String        @default("")
  sellable              Int?
  inbound               Int?
  reserved              Int?
  unsellable            Int?
  researching           Int?
  reservedCustomerOrder Int?
  reservedTransfer      Int?
  reservedProcessing    Int?
  stranded              Int?
  strandedReason        String?
  source                String
  sourceUpdatedAt       DateTime
  syncedAt              DateTime      @default(now())
  sourceReportJobId     String?
  sourceRecordId        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount         SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@id([id, snapshotDate])
  @@unique([tenantId, sellerAccountId, sku, fnsku, snapshotDate, source], map: "InventoryDailySnapshot_uq")
  @@index([tenantId, sellerAccountId, snapshotDate], map: "InventoryDailySnapshot_store_date_idx")
  @@index([sellerAccountId], map: "InventoryDailySnapshot_store_idx")
}

// 库存台账明细（R-12）：幂等键是行内容哈希（含同一天内完全相同行的出现序号），不分区（量大时在 G-09 评估）。
model InventoryLedgerEntry {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  eventDate         DateTime      @db.Date
  eventTime         DateTime?
  fnsku             String
  asin              String        @default("")
  sku               String        @default("")
  fulfillmentCenter String        @default("")
  disposition       String        @default("")
  reasonCode        String        @default("")
  eventType         String        @default("")
  referenceId       String?
  quantity          Int
  country           String?
  reconciledQty     Int?
  unreconciledQty   Int?
  rowHash           String
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, rowHash], map: "InventoryLedgerEntry_uq")
  @@index([tenantId, sellerAccountId, eventDate], map: "InventoryLedgerEntry_store_date_idx")
  @@index([sellerAccountId], map: "InventoryLedgerEntry_store_idx")
}

// 库存台账汇总（R-13）：aggregation 取 DAILY / WEEKLY / MONTHLY（创建报告时的汇总粒度）；fulfillmentCenter 存报告的“位置”列。
model InventoryLedgerSummary {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  date              DateTime      @db.Date
  fnsku             String
  asin              String        @default("")
  sku               String        @default("")
  fulfillmentCenter String        @default("")
  disposition       String        @default("")
  aggregation       String        @default("DAILY")
  startingQty       Int           @default(0)
  inTransitQty      Int           @default(0)
  receipts          Int           @default(0)
  customerShipments Int           @default(0)
  customerReturns   Int           @default(0)
  vendorReturns     Int           @default(0)
  transfers         Int           @default(0)
  found             Int           @default(0)
  lost              Int           @default(0)
  damaged           Int           @default(0)
  disposed          Int           @default(0)
  other             Int           @default(0)
  endingQty         Int           @default(0)
  unknownEvents     Int           @default(0)
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, date, fnsku, fulfillmentCenter, disposition, aggregation], map: "InventoryLedgerSummary_uq")
  @@index([tenantId, sellerAccountId, date], map: "InventoryLedgerSummary_store_date_idx")
  @@index([sellerAccountId], map: "InventoryLedgerSummary_store_idx")
}

// 库龄快照（R-08 派生）：5 个冻结分段 + 5 个报告提供的细分段（可空）；ageSurchargeEstimate = 库龄附加费各分段预估之和。
model InventoryAgeSnapshot {
  id                   String        @id @default(cuid())
  tenantId             String
  sellerAccountId      String
  snapshotDate         DateTime      @db.Date
  sku                  String
  fnsku                String        @default("")
  age0to90             Int?
  age91to180           Int?
  age181to270          Int?
  age271to365          Int?
  age365plus           Int?
  age0to30             Int?
  age31to60            Int?
  age61to90            Int?
  age366to455          Int?
  age456plus           Int?
  ageSurchargeEstimate Decimal?      @db.Decimal(20, 6)
  sourceUpdatedAt      DateTime
  syncedAt             DateTime      @default(now())
  sourceReportJobId    String?
  sourceRecordId       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount        SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, sku, fnsku, snapshotDate], map: "InventoryAgeSnapshot_uq")
  @@index([tenantId, sellerAccountId, snapshotDate], map: "InventoryAgeSnapshot_store_date_idx")
  @@index([sellerAccountId], map: "InventoryAgeSnapshot_store_idx")
}

// 库存规划快照（R-08 全字段 + R-17 推荐移除列）。R-17 只写 removalReport* 三列，不覆盖 R-08 自带的 recommendedRemovalQty。
// 全部报告列允许为空（空 = 报告没有给）；报告新增的列不报错，按样例文件补充时在迁移检查里列出。
model InventoryPlanningSnapshot {
  id                              String        @id @default(cuid())
  tenantId                        String
  sellerAccountId                 String
  snapshotDate                    DateTime      @db.Date
  sku                             String
  fnsku                           String        @default("")
  asin                            String        @default("")
  productName                     String?
  condition                       String?
  currency                        String?
  available                       Int?
  pendingRemovalQty               Int?
  age0to90                        Int?
  age91to180                      Int?
  age181to270                     Int?
  age271to365                     Int?
  age365plus                      Int?
  age0to30                        Int?
  age31to60                       Int?
  age61to90                       Int?
  age366to455                     Int?
  age456plus                      Int?
  unitsShippedT7                  Int?
  unitsShippedT30                 Int?
  unitsShippedT60                 Int?
  unitsShippedT90                 Int?
  alert                           String?
  yourPrice                       Decimal?      @db.Decimal(20, 6)
  salesPrice                      Decimal?      @db.Decimal(20, 6)
  recommendedAction               String?
  sellThrough                     Decimal?      @db.Decimal(12, 6)
  itemVolume                      Decimal?      @db.Decimal(20, 6)
  volumeUnit                      String?
  storageType                     String?
  daysOfSupply                    Decimal?      @db.Decimal(12, 2)
  estimatedExcessQty              Int?
  weeksOfCoverT7                  Decimal?      @db.Decimal(12, 6)
  weeksOfCoverT30                 Decimal?      @db.Decimal(12, 6)
  weeksOfCoverT60                 Decimal?      @db.Decimal(12, 6)
  weeksOfCoverT90                 Decimal?      @db.Decimal(12, 6)
  estimatedStorageCostNextMonth   Decimal?      @db.Decimal(20, 6)
  inboundQty                      Int?
  inboundWorking                  Int?
  inboundShipped                  Int?
  inboundReceived                 Int?
  noSaleLast6Months               Int?
  reservedQty                     Int?
  reservedFcTransfer              Int?
  reservedFcProcessing            Int?
  reservedCustomerOrder           Int?
  unfulfillableQty                Int?
  historicalDaysOfSupply          Decimal?      @db.Decimal(12, 2)
  shortTermHistoricalDaysOfSupply Decimal?      @db.Decimal(12, 2)
  longTermHistoricalDaysOfSupply  Decimal?      @db.Decimal(12, 2)
  seasonality                     String?
  fbaMinimumInventoryLevel        Int?
  amazonHealthStatus              String?
  lowInventoryLevelFeeApplied     String?
  lowInventoryLevelFee            Decimal?      @db.Decimal(20, 6)
  recommendedShipInQty            Int?
  recommendedShipInDate           DateTime?     @db.Date
  recommendedSalesPrice           Decimal?      @db.Decimal(20, 6)
  recommendedSaleDurationDays     Int?
  recommendedRemovalQty           Int?
  estimatedCostSavings            Decimal?      @db.Decimal(20, 6)
  aisEst181To210                  Decimal?      @db.Decimal(20, 6)
  aisEst211To240                  Decimal?      @db.Decimal(20, 6)
  aisEst241To270                  Decimal?      @db.Decimal(20, 6)
  aisEst271To300                  Decimal?      @db.Decimal(20, 6)
  aisEst301To330                  Decimal?      @db.Decimal(20, 6)
  aisEst331To365                  Decimal?      @db.Decimal(20, 6)
  aisEst365Plus                   Decimal?      @db.Decimal(20, 6)
  ltsfQty6Mo                      Int?
  ltsfProjected6Mo                Decimal?      @db.Decimal(20, 6)
  ltsfQty12Mo                     Int?
  ltsfProjected12Mo               Decimal?      @db.Decimal(20, 6)
  removalReportQty                Int?
  removalReportReason             String?
  removalReportUpdatedAt          DateTime?
  sourceUpdatedAt                 DateTime
  syncedAt                        DateTime      @default(now())
  sourceReportJobId               String?
  sourceRecordId                  String?
  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt
  tenant                          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount                   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, sku, fnsku, snapshotDate], map: "InventoryPlanningSnapshot_uq")
  @@index([tenantId, sellerAccountId, snapshotDate], map: "InventoryPlanningSnapshot_store_date_idx")
  @@index([sellerAccountId], map: "InventoryPlanningSnapshot_store_idx")
}

// 仓储容量与利用率：来源 REPORT（仓储费报告里的利用率）或 FILE_IMPORT（P2a-09 的限额文件导入）。报告只给利用率，不给限额与已用量。
model StorageCapacitySnapshot {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  snapshotDate      DateTime      @db.Date
  storageType       String
  limitQty          Decimal?      @db.Decimal(20, 6)
  usedQty           Decimal?      @db.Decimal(20, 6)
  utilizationPct    Decimal?      @db.Decimal(12, 6)
  sourceKind        String        @default("REPORT")
  sourceFileId      String?
  sourceFileName    String?
  importedBy        String?
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, snapshotDate, storageType], map: "StorageCapacitySnapshot_uq")
  @@index([sellerAccountId], map: "StorageCapacitySnapshot_store_idx")
}

// 仓储类费用（R-20～R-22）：feeKind 取 STORAGE / OVERAGE / LONGTERM / UTILIZATION；没有运营中心时 fulfillmentCenter 存空串。
model StorageFeeRecord {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  chargeMonth       DateTime      @db.Date
  feeKind           String
  fnsku             String
  fulfillmentCenter String        @default("")
  asin              String        @default("")
  sku               String        @default("")
  amount            Decimal       @db.Decimal(20, 6)
  currency          String        @default("USD")
  volume            Decimal?      @db.Decimal(20, 6)
  rate              Decimal?      @db.Decimal(20, 6)
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, chargeMonth, fnsku, fulfillmentCenter, feeKind], map: "StorageFeeRecord_uq")
  @@index([tenantId, sellerAccountId, chargeMonth], map: "StorageFeeRecord_store_month_idx")
  @@index([sellerAccountId], map: "StorageFeeRecord_store_idx")
}

// 移除订单明细（R-18）：type 取 RETURN / DISPOSAL / OTHER。
model RemovalOrder {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  orderId           String
  type              String        @default("OTHER")
  status            String        @default("")
  requestDate       DateTime      @db.Date
  lastUpdatedDate   DateTime?     @db.Date
  serviceSpeed      String?
  sku               String
  fnsku             String        @default("")
  disposition       String        @default("")
  requestedQty      Int           @default(0)
  shippedQty        Int           @default(0)
  disposedQty       Int           @default(0)
  cancelledQty      Int           @default(0)
  inProcessQty      Int           @default(0)
  fee               Decimal?      @db.Decimal(20, 6)
  currency          String?
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, orderId, sku, fnsku, disposition], map: "RemovalOrder_uq")
  @@index([tenantId, sellerAccountId, requestDate], map: "RemovalOrder_store_date_idx")
  @@index([sellerAccountId], map: "RemovalOrder_store_idx")
}

// 移除货件明细（R-19）：官方报告没有货件编号列，shipmentId 取运单号，没有运单号时取 NOTRACK-发货日期（见 CR）。
model RemovalShipment {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  orderId           String
  shipmentId        String
  sku               String
  fnsku             String        @default("")
  disposition       String        @default("")
  carrier           String?
  trackingNumber    String?
  shippedQty        Int           @default(0)
  shipDate          DateTime?     @db.Date
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, orderId, shipmentId, sku, fnsku], map: "RemovalShipment_uq")
  @@index([tenantId, sellerAccountId, orderId], map: "RemovalShipment_store_order_idx")
  @@index([sellerAccountId], map: "RemovalShipment_store_idx")
}

// 移除退回件的收货核对（P2a-09）：人工登记，应收取自 RemovalOrder.shippedQty；同一天同一 SKU 再次登记视为更正当天的登记（审计留前后值）。
model RemovalReceipt {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  removalOrderId  String
  sku             String
  receivedQty     Int
  sellableQty     Int
  damagedQty      Int
  note            String?
  receivedAt      DateTime      @db.Date
  receivedBy      String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, removalOrderId, sku, receivedAt], map: "RemovalReceipt_uq")
  @@index([sellerAccountId], map: "RemovalReceipt_store_idx")
}

// 亚马逊官方补货建议（R-16）：与我方补货计算（P2a-07）做双源核对用；报告没有日期列，snapshotDate 取同步当天（企业数据口径时区）。
model AmazonRestockRecommendation {
  id                  String        @id @default(cuid())
  tenantId            String
  sellerAccountId     String
  snapshotDate        DateTime      @db.Date
  sku                 String
  fnsku               String        @default("")
  asin                String        @default("")
  recommendedQty      Int?
  recommendedShipDate DateTime?     @db.Date
  alertReason         String?
  recommendedAction   String?
  daysOfSupply        Int?
  daysOfSupplyAtFba   Int?
  availableQty        Int?
  inboundQty          Int?
  unitsSold30d        Int?
  salesLast30d        Decimal?      @db.Decimal(20, 6)
  currency            String?
  sourceUpdatedAt     DateTime
  syncedAt            DateTime      @default(now())
  sourceReportJobId   String?
  sourceRecordId      String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount       SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, sku, fnsku, snapshotDate], map: "AmazonRestockRecommendation_uq")
  @@index([tenantId, sellerAccountId, snapshotDate], map: "AmazonRestockRecommendation_store_date_idx")
  @@index([sellerAccountId], map: "AmazonRestockRecommendation_store_idx")
}

// 补货策略版本（P2a-06 先落企业级，P2a-07 扩展品类与 SKU 级）：库存健康规则引擎读取“当前生效的最新版本”，不使用固定阈值。
// 只增不改：每次保存新增一行（versionNo + 1），旧版本留作历史；level 取 TENANT / CATEGORY / SKU（本包只用 TENANT，levelRef 固定 'ALL'）。
// 风险判定参数：提前期（采购 + 国内运输 + 头程 + 入仓接收）、上游仓储调拨时效（可空）、安全库存天数、目标覆盖天数、冗余倍数、计入可售天数的在途类别、库龄风险起算天数。
model ReplenishmentPolicy {
  id                         String   @id @default(cuid())
  tenantId                   String
  level                      String   @default("TENANT")
  levelRef                   String   @default("ALL")
  versionNo                  Int
  leadTimeDays               Int
  awdLeadTimeDays            Int?
  safetyDays                 Int
  coverageDays               Int
  redundancyMultiplier       Decimal  @db.Decimal(6, 2)
  inboundCounted             String[]
  agingFromDays              Int      @default(271)
  // P2a-07 补货计算链参数（全部可空：旧版本没有这些参数，补货建议会提示“补货参数尚未配置”）。
  // 提前期拆分：生产、国内运输、入仓接收；头程按运输方式放在 transportOptionsJson（[{mode, transitDays, unitCost}]）。
  productionDays             Int?
  domesticDays               Int?
  receivingDays              Int?
  serviceLevel               Decimal? @db.Decimal(5, 4)
  transportPreference        String?
  transportOptionsJson       Json?
  casePackQty                Int?
  moq                        Int?
  minOrderValue              Decimal? @db.Decimal(20, 6)
  // P6-09：是否把“必断货量”（用最快运输方式也补不上的缺口）计入建议量，默认不计入；属于策略版本，旧版本一律是 false。
  includeUnavoidableShortage Boolean  @default(false)
  effectiveFrom              DateTime @db.Date
  changeReason               String
  createdBy                  String
  createdAt                  DateTime @default(now())
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, level, levelRef, versionNo], map: "ReplenishmentPolicy_uq")
  @@index([tenantId, level, levelRef, effectiveFrom], map: "ReplenishmentPolicy_effective_idx")
}

// 人工预测规则（P6-09，16 章第 4 节）：按时间段覆盖模型预测。scopeType = SKU（scopeId 是卖家 SKU，所有店铺的这个 SKU 都适用）或
// CATEGORY（scopeId 是商品类型）；mode = FIXED（时间段内固定日销 value 件/天）或 YOY_FACTOR（去年同期日均 × value）。
// 同一对象的时间段不允许重叠（服务里校验）；SKU 规则优先于品类规则。from、to 是 SQL 保留字，列名用 fromDate、toDate（含首尾）。
model ForecastOverride {
  id        String   @id @default(cuid())
  tenantId  String
  scopeType String
  scopeId   String
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  mode      String
  value     Decimal  @db.Decimal(14, 4)
  note      String?
  version   Int      @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, scopeType, scopeId, fromDate], map: "ForecastOverride_scope_idx")
}

// 外部货号映射（P6-11，16 章第 5.1 节）：供应商装箱单里的货号（或条码、品名）对应到我们的 SKU。
// supplierId 为空表示通用映射（所有供应商的装箱单都可用）；有供应商的映射优先于通用映射。
// 唯一键 (tenantId, supplierId, externalCode)；supplierId 为空时 PostgreSQL 视为互不相同，另有部分唯一索引兜底（见迁移）。
// source = MANUAL（人工新增或装箱单里“记住这个对应关系”）或 IMPORT（文件导入）；sku 是卖家 SKU，不加外键（SKU 属于店铺，同一 SKU 可在多个店铺）。
model SkuAlias {
  id           String    @id @default(cuid())
  tenantId     String
  supplierId   String?
  externalCode String
  sku          String
  source       String    @default("MANUAL")
  version      Int       @default(1)
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([tenantId, supplierId, externalCode], map: "SkuAlias_uq")
  @@index([tenantId, sku], map: "SkuAlias_sku_idx")
  @@index([supplierId], map: "SkuAlias_supplier_idx")
}

// 供应商装箱单的列映射（P6-11）：每个供应商一份。columns 是“标准列 → 该供应商装箱单里的表头文字”（按表头文字而不是列序号，供应商调整列顺序不受影响），
// units 是尺寸与重量的单位（{ length: 'CM'|'IN', weight: 'KG'|'LB' }），没填时取装箱单表头里的提示，再没有就按厘米与千克。
model PackingListMapping {
  id         String   @id @default(cuid())
  tenantId   String
  supplierId String
  columns    Json
  units      Json?
  version    Int      @default(1)
  updatedBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([tenantId, supplierId], map: "PackingListMapping_uq")
  @@index([supplierId], map: "PackingListMapping_supplier_idx")
}

// 标签模板（P6-12，16 章第 5.1、5.2 节）：自定义箱标签与箱号规则。options 是勾选项与排序（原产地、SKU、品名、FNSKU、件数、我方箱号、任务名称页、是否追加到原标签、排序方式），
// paper = THERMAL_4X6 / A4_2UP / A4_4UP，boxNoRule 是箱号规则（前缀、是否带计划号、位数、起始、后缀、连接符）。
// 全企业至多一个默认模板（部分唯一索引写在迁移里）；改动带乐观锁版本号；同一企业内名称唯一。
model LabelTemplate {
  id        String          @id @default(cuid())
  tenantId  String
  name      String
  options   Json
  paper     String
  boxNoRule Json
  isDefault Boolean         @default(false)
  version   Int             @default(1)
  createdBy String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  printLogs LabelPrintLog[]

  @@unique([tenantId, name], map: "LabelTemplate_uq")
}

// 退货原因映射（P6-13，16 章第 6 节）：亚马逊退货原因代码 → 中文释义 → 大类（约 12 个，含“未分类”）。
// 预置的代码在代码里（契约 RETURN_REASON_PRESETS），本表只存企业改过的预置项（isSystem = true）、自己加的项，
// 以及导入退货报告时发现的、预置里没有的新代码（自动加入，大类为“未分类”，isSystem = false）。主键 (tenantId, code)。
model ReturnReasonMap {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  labelZh   String
  category  String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

// 标签生成记录（P6-12）：自定义箱标签（kind = BOX_CUSTOM）与商品标签（kind = ITEM）每成功生成一份文件记一行，用来按货件统计次数。
// 记的是“生成了几次文件”，不是实体打印机上真正打印了几次（系统看不到打印机）。shipmentId 是我方货件行编号，整个计划的商品标签为空。
model LabelPrintLog {
  id          String              @id @default(cuid())
  tenantId    String
  planId      String
  shipmentId  String?
  templateId  String?
  kind        String
  labelCount  Int
  exportJobId String?
  printedBy   String
  printedAt   DateTime            @default(now())
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        FbaInboundPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  shipment    FbaInboundShipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  template    LabelTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId, shipmentId, printedAt], map: "LabelPrintLog_shipment_idx")
  @@index([planId])
  @@index([shipmentId])
  @@index([templateId])
}

// 订阅省卖家指标（I-19，Replenishment API v2022-11-07 getSellingPartnerMetrics）：没给的指标保持空，不写 0。
model SubscribeSaveMetric {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  metricDate        DateTime      @db.Date
  granularity       String        @default("DAY")
  activeSubscribers Int?
  shippedUnits      Int?
  revenue           Decimal?      @db.Decimal(20, 6)
  currency          String?
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, granularity, metricDate], map: "SubscribeSaveMetric_uq")
  @@index([sellerAccountId], map: "SubscribeSaveMetric_store_idx")
}

// 订阅省报价快照（I-19，listOffers 加 listOfferMetrics）：官方没有报价编号，用 SKU + ASIN + 快照日定位。
// forecastNext*：官方给出的未来订阅出货件数预测（确定性需求，补货第 1 步用）；shippedUnitsPrevMonth：上一个完整自然月的订阅出货件数（用来从历史销量里扣掉订阅部分，避免重复计算）。
model SubscribeSaveOffer {
  id                    String        @id @default(cuid())
  tenantId              String
  sellerAccountId       String
  snapshotDate          DateTime      @db.Date
  sku                   String
  asin                  String        @default("")
  eligibility           String?
  fulfillment           String?
  sellerFundedBasePct   Decimal?      @db.Decimal(6, 2)
  price                 Decimal?      @db.Decimal(20, 6)
  currency              String?
  inventory             Int?
  stockRisk             String?
  subscriptions         Int?
  forecastNext15        Int?
  forecastNext30        Int?
  forecastNext60        Int?
  forecastNext90        Int?
  shippedUnitsPrevMonth Int?
  prevMonthStart        DateTime?     @db.Date
  prevMonthDays         Int?
  sourceUpdatedAt       DateTime
  syncedAt              DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount         SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, sku, snapshotDate], map: "SubscribeSaveOffer_uq")
  @@index([sellerAccountId], map: "SubscribeSaveOffer_store_idx")
}

// 补货建议批次（P2a-07）：一次计算 = 一个批次，冻结当时的全部输入（snapshotJson、policyVersionsJson）。
// status：PENDING_REVIEW 待审、CONFIRMED 已确认（有采纳或调整）、DRAFTED 已生成草稿、CLOSED 已结束（每条建议都已处理）；COMPUTING 预留给异步计算。
model ReplenishmentBatch {
  id                 String                        @id @default(cuid())
  tenantId           String
  batchNo            String
  status             String                        @default("PENDING_REVIEW")
  today              DateTime                      @db.Date
  storeIdsJson       Json
  policyVersionsJson Json
  snapshotJson       Json
  skuTotal           Int
  recommendedCount   Int
  computedAt         DateTime                      @default(now())
  computedBy         String
  createdAt          DateTime                      @default(now())
  tenant             Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recommendations    ReplenishmentRecommendation[]
  actions            ReplenishmentAction[]

  @@unique([tenantId, batchNo], map: "ReplenishmentBatch_uq")
  @@index([tenantId, computedAt], map: "ReplenishmentBatch_time_idx")
}

// 补货建议（每个批次每个店铺 SKU 一条）：calcStepsJson 是 8 步计算链的完整展开，shipmentsJson 是按运输方式拆分后的发运批次。
model ReplenishmentRecommendation {
  id               String                 @id @default(cuid())
  tenantId         String
  batchId          String
  sellerAccountId  String
  sku              String
  asin             String                 @default("")
  fnsku            String?
  channel          String                 @default("PURCHASE")
  riskLevel        String?
  recommendedQty   Int
  purchaseQty      Int
  dueDate          DateTime               @db.Date
  shipDate         DateTime?              @db.Date
  arriveDate       DateTime?              @db.Date
  stockoutDate     DateTime?              @db.Date
  confidence       Decimal                @db.Decimal(5, 4)
  calcStepsJson    Json
  shipmentsJson    Json
  capitalAmount    Decimal?               @db.Decimal(20, 6)
  amazonRestockQty Int?
  amazonShipDate   DateTime?              @db.Date
  diffReason       String?
  createdAt        DateTime               @default(now())
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch            ReplenishmentBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sellerAccount    SellerAccount          @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  actions          ReplenishmentAction[]
  outcomes         ReplenishmentOutcome[]

  @@unique([batchId, sellerAccountId, sku, channel], map: "ReplenishmentRecommendation_uq")
  @@index([sellerAccountId], map: "ReplenishmentRecommendation_store_idx")
  @@index([tenantId, sku], map: "ReplenishmentRecommendation_sku_idx")
}

// 补货动作（只增不改）：采纳 / 调整 / 忽略 / 三类草稿。草稿目标模块（入仓计划、上游仓储）尚未上线时 status=PENDING_TARGET，不伪造单据编号。
model ReplenishmentAction {
  id               String                      @id @default(cuid())
  tenantId         String
  batchId          String
  recommendationId String
  action           String
  finalQty         Int?
  status           String                      @default("DONE")
  targetDocType    String?
  targetDocId      String?
  reason           String?
  actorId          String
  createdAt        DateTime                    @default(now())
  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch            ReplenishmentBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recommendation   ReplenishmentRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt], map: "ReplenishmentAction_tenant_idx")
  @@index([batchId, createdAt], map: "ReplenishmentAction_batch_idx")
  @@index([recommendationId], map: "ReplenishmentAction_rec_idx")
}

// 结果回看：建议执行一段时间后，用实际销量与断货天数对照当时的预测，算预测误差。
model ReplenishmentOutcome {
  id               String                      @id @default(cuid())
  tenantId         String
  recommendationId String
  evaluatedAt      DateTime                    @db.Date
  windowStart      DateTime                    @db.Date
  windowEnd        DateTime                    @db.Date

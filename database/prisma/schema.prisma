  cartAddMedianPrice    Decimal?      @db.Decimal(14, 4)
  purchaseMedianPrice   Decimal?      @db.Decimal(14, 4)
  currency              String?
  sourceReportJobId     String?
  sourceUpdatedAt       DateTime
  syncedAt              DateTime      @default(now())
  createdAt             DateTime      @default(now())

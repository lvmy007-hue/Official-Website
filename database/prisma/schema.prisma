  recommendation   ReplenishmentRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, evaluatedAt], map: "ReplenishmentOutcome_uq")
  @@index([tenantId, evaluatedAt], map: "ReplenishmentOutcome_tenant_idx")
}


generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  email String @unique
  displayName String
  passwordHash String
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  sessions Session[]
  oauthStates OAuthState[]
  auditEvents AuditEvent[]
  reportJobs FbaReportJob[]
}
model Tenant {
  id String @id @default(cuid())
  name String
  slug String @unique
  mode String @default("LIVE")
  timezone String @default("Asia/Shanghai")
  defaultCurrency String @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  roles Role[]
  legalEntities LegalEntity[]
  sellerAccounts SellerAccount[]
  connections PlatformConnection[]
  syncJobs SyncJob[]
  orders Order[]
  inventory InventorySnapshot[]
  fbaProducts FbaProduct[]
  fbaInventory FbaInventoryRecord[]
  fbaInboundPlans FbaInboundPlan[]
  fbaFeeEvents FbaFeeEvent[]
  fbaReturns FbaReturnCase[]
  auditEvents AuditEvent[]
  reportJobs FbaReportJob[]
  adsProfiles AdsProfile[]
  adsCampaigns AdsCampaign[]
  adsReportJobs AdsReportJob[]
  orderItems OrderItem[]
  fbaSettlements FbaSettlement[]
  fbaFinancialTransactions FbaFinancialTransaction[]
  adMetrics AdsMetric[]
  suppliers Supplier[]
  purchaseOrders PurchaseOrder[]
  warehouses Warehouse[]
  inventoryMovements InventoryMovement[]
}
model Role {
  id String @id @default(cuid())
  tenantId String?
  name String
  permissions Json
  resourceScope Json
  system Boolean @default(false)
  version Int @default(1)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, name])
}
model Membership {
  id String @id @default(cuid())
  userId String
  tenantId String
  roleId String
  status String @default("ACTIVE")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, tenantId])
  @@index([tenantId, status])
}
model Session {
  id String @id @default(cuid())
  userId String
  refreshTokenHash String
  userAgent String?
  ipHash String?
  expiresAt DateTime
  revokedAt DateTime?
  lastSeenAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, revokedAt])
}
model LegalEntity {
  id String @id @default(cuid())
  tenantId String
  name String
  registeredCountry String
  registrationNo String?
  status String @default("ACTIVE")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccounts SellerAccount[]
  oauthStates OAuthState[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, name])
}
model SellerAccount {
  id String @id @default(cuid())
  tenantId String
  legalEntityId String
  provider String @default("AMAZON_SP_API")
  sellerId String
  logicalRegion String
  displayName String
  marketplaceIds Json
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  connections PlatformConnection[]
  orders Order[]
  inventory InventorySnapshot[]
  fbaProducts FbaProduct[]
  fbaInventory FbaInventoryRecord[]
  fbaInboundPlans FbaInboundPlan[]
  fbaFeeEvents FbaFeeEvent[]
  fbaReturns FbaReturnCase[]
  reportJobs FbaReportJob[]
  orderItems OrderItem[]
  fbaSettlements FbaSettlement[]
  fbaFinancialTransactions FbaFinancialTransaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, provider, sellerId, logicalRegion])
  @@index([tenantId, logicalRegion])
}
model PlatformConnection {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String?
  adsProfileId String?
  provider String
  state String @default("NOT_CONFIGURED")
  externalAccountId String?
  encryptedRefreshToken String?
  refreshTokenUpdatedAt DateTime?
  grantedScopes Json
  lastSuccessfulSyncAt DateTime?
  lastHealthCheckedAt DateTime?
  lastErrorCode String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount SellerAccount? @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  adsProfile AdsProfile? @relation(fields: [adsProfileId], references: [id], onDelete: SetNull)
  oauthStates OAuthState[]
  healthChecks ConnectionHealth[]
  syncJobs SyncJob[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, provider, state])
  @@index([tenantId, adsProfileId])
}
model OAuthState {
  id String @id @default(cuid())
  tenantId String
  connectionId String
  initiatedById String?
  legalEntityId String?
  stateHash String @unique
  redirectUri String
  expiresAt DateTime
  consumedAt DateTime?
  connection PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  initiatedBy User? @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([tenantId, expiresAt, consumedAt])
  @@index([legalEntityId])
}
model ConnectionHealth {
  id String @id @default(cuid())
  connectionId String
  status String
  checks Json
  requestId String
  checkedAt DateTime @default(now())
  connection PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@index([connectionId, checkedAt])
}
model Order {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String
  amazonOrderId String
  marketplaceId String
  purchaseDate DateTime
  status String
  fulfillment String?
  currency String
  amount Decimal? @db.Decimal(20, 6)
  itemCount Int?
  sourceUpdatedAt DateTime
  sourceRecordId String
  piiCiphertext String?
  shippedAt DateTime?
  piiExpiresAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  items OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sellerAccountId, amazonOrderId])
  @@index([tenantId, purchaseDate])
  @@index([piiExpiresAt])
}
model InventorySnapshot {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String
  sku String
  title String?
  available Int @default(0)
  inbound Int @default(0)
  reserved Int @default(0)
  sourceUpdatedAt DateTime
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  @@unique([sellerAccountId, sku])
  @@index([tenantId, available])
}
model SyncJob {
  id String @id @default(cuid())
  tenantId String
  connectionId String
  type String
  status String @default("PENDING")
  progressCurrent Int @default(0)
  progressTotal Int @default(0)
  attempts Int @default(0)
  failureCode String?
  requestId String
  context Json?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
}
model AuditEvent {
  id String @id @default(cuid())
  tenantId String
  actorId String?
  action String
  resourceType String
  resourceId String?
  requestId String
  result String
  detail Json?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([tenantId, createdAt])
}
model ContactRequest {
  id String @id @default(cuid())
  name String
  company String
  email String
  message String
  phone String?
  topic String?
  storeBand String?
  status String @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt])
  @@index([status, createdAt])
}

model FbaProduct {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String
  marketplaceId String @default("ATVPDKIKX0DER")
  asin String
  sellerSku String
  fnsku String?
  title String
  brand String?
  productType String?
  listingStatus String @default("ACTIVE")
  fulfillmentChannel String @default("AFN")
  sizeTier String?
  packageLengthCm Decimal? @db.Decimal(12, 4)
  packageWidthCm Decimal? @db.Decimal(12, 4)
  packageHeightCm Decimal? @db.Decimal(12, 4)
  packageWeightKg Decimal? @db.Decimal(12, 4)
  price Decimal? @db.Decimal(20, 6)
  currency String @default("USD")
  sourceUpdatedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  @@unique([sellerAccountId, marketplaceId, sellerSku])
  @@index([tenantId, marketplaceId, asin])
}

model FbaInventoryRecord {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String
  marketplaceId String @default("ATVPDKIKX0DER")
  asin String
  sellerSku String
  fnsku String?
  fulfillableQuantity Int @default(0)
  inboundWorkingQuantity Int @default(0)
  inboundShippedQuantity Int @default(0)
  inboundReceivingQuantity Int @default(0)
  reservedQuantity Int @default(0)
  unfulfillableQuantity Int @default(0)
  researchQuantity Int @default(0)
  daysOfSupply Decimal? @db.Decimal(12, 2)
  inventoryAgeDays Int?
  strandedReason String?
  healthStatus String @default("HEALTHY")
  sourceUpdatedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  @@unique([sellerAccountId, marketplaceId, sellerSku])
  @@index([tenantId, healthStatus, daysOfSupply])
}

model FbaInboundPlan {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String
  marketplaceId String @default("ATVPDKIKX0DER")
  externalPlanId String?
  name String
  status String @default("DRAFT")
  sourceAddress String
  items Json?
  placementOption String?
  totalUnits Int @default(0)
  shipmentCount Int @default(0)
  sourceUpdatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  shipments FbaInboundShipment[]
  @@index([tenantId, status, createdAt])
}

model FbaInboundShipment {
  id String @id @default(cuid())
  planId String
  shipmentId String
  status String @default("WORKING")
  destinationFc String?
  placementOption String?
  transportStatus String?
  trackingNumber String?
  unitsExpected Int @default(0)
  unitsReceived Int @default(0)
  discrepancyQuantity Int @default(0)
  sourceUpdatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan FbaInboundPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@unique([planId, shipmentId])
  @@index([status, destinationFc])
}

model FbaFeeEvent {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String
  marketplaceId String @default("ATVPDKIKX0DER")
  settlementId String?
  amazonOrderId String?
  asin String?
  sellerSku String?
  eventType String
  amount Decimal @db.Decimal(20, 6)
  currency String @default("USD")
  postedAt DateTime
  description String?
  sourceEventId String?
  sourceUpdatedAt DateTime
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  @@index([tenantId, postedAt, eventType])
  @@index([sellerAccountId, settlementId])
  @@unique([sellerAccountId, sourceEventId])
}

model FbaReturnCase {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String
  marketplaceId String @default("ATVPDKIKX0DER")
  amazonOrderId String
  returnId String?
  asin String
  sellerSku String
  quantity Int @default(1)
  disposition String?
  reason String?
  refundAmount Decimal? @db.Decimal(20, 6)
  reimbursementStatus String @default("NOT_REVIEWED")
  status String @default("OPEN")
  returnDate DateTime
  sourceUpdatedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  @@unique([sellerAccountId, amazonOrderId, asin, returnDate])
  @@index([tenantId, status, returnDate])
}

model FbaReportJob {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String?
  marketplaceId String @default("ATVPDKIKX0DER")
  reportType String
  fromDate DateTime?
  toDate DateTime?
  status String @default("PENDING")
  externalReportId String?
  documentId String?
  downloadUrl String?
  expiresAt DateTime?
  failureCode String?
  requestId String
  createdById String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount SellerAccount? @relation(fields: [sellerAccountId], references: [id], onDelete: SetNull)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([sellerAccountId, reportType])
}

model AdsProfile {
  id String @id @default(cuid())
  tenantId String
  profileId String
  accountId String?
  marketplaceId String @default("ATVPDKIKX0DER")
  countryCode String @default("US")
  currencyCode String @default("USD")
  timezone String?
  displayName String?
  status String @default("ACTIVE")
  sourceUpdatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connections PlatformConnection[]
  campaigns AdsCampaign[]
  reports AdsReportJob[]
  metrics AdsMetric[]
  @@unique([tenantId, profileId])
  @@index([tenantId, marketplaceId, status])
}

model AdsCampaign {
  id String @id @default(cuid())
  tenantId String
  adsProfileId String
  externalCampaignId String
  adProduct String
  name String
  state String
  budget Decimal? @db.Decimal(20, 6)
  currency String @default("USD")
  startDate DateTime?
  endDate DateTime?
  sourceUpdatedAt DateTime
  raw Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile AdsProfile @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  @@unique([adsProfileId, externalCampaignId, adProduct])
  @@index([tenantId, state, sourceUpdatedAt])
}

model AdsReportJob {
  id String @id @default(cuid())
  tenantId String
  adsProfileId String
  reportType String
  adProduct String @default("SPONSORED_PRODUCTS")
  status String @default("PENDING")
  externalReportId String?
  downloadUrl String?
  fromDate DateTime?
  toDate DateTime?
  expiresAt DateTime?
  failureCode String?
  requestId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile AdsProfile @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  @@index([tenantId, status, createdAt])
  metrics AdsMetric[]
  @@index([adsProfileId, reportType])
}


model OrderItem {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String
  orderId String
  amazonOrderId String
  orderItemId String
  asin String?
  sellerSku String?
  title String?
  quantityOrdered Int @default(0)
  quantityShipped Int @default(0)
  itemPrice Decimal? @db.Decimal(20, 6)
  currency String @default("USD")
  fulfillmentNetwork String?
  condition String?
  sourceUpdatedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([sellerAccountId, orderItemId])
  @@index([tenantId, amazonOrderId])
  @@index([sellerAccountId, sellerSku])
}

model FbaSettlement {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String
  marketplaceId String @default("ATVPDKIKX0DER")
  externalSettlementId String
  settlementStartDate DateTime?
  settlementEndDate DateTime?
  depositDate DateTime?
  totalAmount Decimal? @db.Decimal(20, 6)
  currency String @default("USD")
  status String @default("RECEIVED")
  sourceUpdatedAt DateTime
  raw Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  transactions FbaFinancialTransaction[]
  @@unique([sellerAccountId, externalSettlementId])
  @@index([tenantId, depositDate])
}

model FbaFinancialTransaction {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String
  settlementId String?
  marketplaceId String @default("ATVPDKIKX0DER")
  externalTransactionId String
  amazonOrderId String?
  transactionType String?
  transactionStatus String?
  amount Decimal @db.Decimal(20, 6)
  currency String @default("USD")
  postedAt DateTime
  description String?
  raw Json?
  sourceUpdatedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  settlement FbaSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  @@unique([sellerAccountId, externalTransactionId])
  @@index([tenantId, postedAt, transactionType])
}

model AdsMetric {
  id String @id @default(cuid())
  tenantId String
  adsProfileId String
  reportJobId String?
  reportDate DateTime
  adProduct String @default("SPONSORED_PRODUCTS")
  externalCampaignId String?
  campaignName String?
  impressions Int @default(0)
  clicks Int @default(0)
  cost Decimal? @db.Decimal(20, 6)
  sales Decimal? @db.Decimal(20, 6)
  purchases Int @default(0)
  currency String @default("USD")
  raw Json?
  sourceUpdatedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile AdsProfile @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  reportJob AdsReportJob? @relation(fields: [reportJobId], references: [id], onDelete: SetNull)
  @@unique([adsProfileId, reportDate, adProduct, externalCampaignId])
  @@index([tenantId, reportDate])
}

model Supplier {
  id String @id @default(cuid())
  tenantId String
  code String
  name String
  contactName String?
  email String?
  phone String?
  currency String @default("USD")
  status String @default("ACTIVE")
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model PurchaseOrder {
  id String @id @default(cuid())
  tenantId String
  supplierId String
  number String
  status String @default("DRAFT")
  currency String @default("USD")
  totalAmount Decimal? @db.Decimal(20, 6)
  expectedDate DateTime?
  notes String?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines PurchaseOrderLine[]
  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
}

model PurchaseOrderLine {
  id String @id @default(cuid())
  purchaseOrderId String
  sellerSku String
  asin String?
  title String?
  quantity Int @default(0)
  receivedQuantity Int @default(0)
  unitCost Decimal? @db.Decimal(20, 6)
  currency String @default("USD")
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  @@index([purchaseOrderId, sellerSku])
}

model Warehouse {
  id String @id @default(cuid())
  tenantId String
  code String
  name String
  countryCode String @default("US")
  kind String @default("FBA")
  status String @default("ACTIVE")
  address Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]
  @@unique([tenantId, code])
  @@index([tenantId, kind, status])
}

model InventoryMovement {
  id String @id @default(cuid())
  tenantId String
  sellerAccountId String?
  warehouseId String?
  sellerSku String
  asin String?
  movementType String
  quantity Int
  referenceType String?
  referenceId String?
  occurredAt DateTime
  notes String?
  raw Json?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  @@index([tenantId, sellerSku, occurredAt])
  @@index([tenantId, movementType, occurredAt])
}

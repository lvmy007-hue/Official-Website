// P2a-13：入仓接收差异与不合规问题。
// kind：SHORT 少收、OVER 多收（来源 RECEIPT，由货件接收数量算出）、NONCOMPLIANCE 不合规（来源 REPORT，不合规报告 R-25）。
// shipmentRef 是来源给出的货件编号：RECEIPT 取我方货件编号 shipmentId，REPORT 取报告里的货件编号（FBA 开头确认号），读取时两个编号都匹配。
// 差异消除后不删除，写 resolvedAt；problemKey 少收与多收固定空串，不合规取问题类型（唯一键不能含空值）。amount 只有不合规报告里有（费用）。
model ReceivingDiscrepancy {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  planId          String?
  shipmentRef     String
  sku             String
  kind            String
  qty             Int?
  problemKey      String        @default("")
  problemType     String?
  source          String
  amount          Decimal?      @db.Decimal(20, 6)
  currency        String?
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  resolvedAt      DateTime?
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, shipmentRef, sku, kind, problemKey], map: "ReceivingDiscrepancy_uq")
  @@index([sellerAccountId], map: "ReceivingDiscrepancy_store_idx")
  @@index([tenantId, shipmentRef], map: "ReceivingDiscrepancy_ship_idx")
}

// P2a-13：赔付机会（07 章 7.3 的 7 类规则，本包只产出第 1 类入仓差异，其余由 P2b-03 接入）。
// ruleCode：INBOUND_DISCREPANCY、LEDGER_LOST、LEDGER_DAMAGED、REFUND_NO_RETURN、RETURN_DISPOSITION、FEE_OVERCHARGE、REMOVAL_LOST。
// status：PENDING 待处理、CASE_CREATED 已生成案件、IGNORED 已忽略、EXPIRED 已过期、RESOLVED 差异已消除（冻结里没有，见 CR-036）。
// estimatedAmount 空表示没有商品成本无法估算（不是 0）。evidenceRefsJson 是证据引用 [{kind, id, label}]，页面据此跳转。
model ReimbursementOpportunity {
  id               String              @id @default(cuid())
  tenantId         String
  sellerAccountId  String
  ruleCode         String
  dedupKey         String
  evidenceRefsJson Json
  estimatedAmount  Decimal?            @db.Decimal(20, 6)
  currency         String?
  deadlineAt       DateTime?           @db.Date
  status           String              @default("PENDING")
  detectedAt       DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  // P2b-03：SKU 与数量（7 类机会共用，页面列表直接显示）、忽略原因、乐观锁版本
  sku              String?
  qty              Int?
  note             String?
  version          Int                 @default(1)
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount    SellerAccount       @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  cases            ReimbursementCase[]

  @@unique([tenantId, sellerAccountId, ruleCode, dedupKey], map: "ReimbursementOpp_uq")
  @@index([sellerAccountId], map: "ReimbursementOpp_store_idx")
  @@index([tenantId, status, deadlineAt], map: "ReimbursementOpp_status_idx")
}

// P2b-03：赔付案件（07 章 7.3，独立对象）。status：OPPORTUNITY 待提交、SUBMITTED 已提交、IN_PROGRESS 处理中、APPROVED 已批准、PARTIAL 部分批准、REJECTED 拒绝、PAID 已到账。
// 亚马逊的卖家支持接口不能创建案件：提交在卖家后台完成，之后把案件编号回填到 amazonCaseId。
// expectedAmount 应收（空表示没有商品成本无法估算，不是 0）；approvedAmount 亚马逊批准的金额（人工回填）；receivedAmount 实收，只由赔付报告匹配累加，不允许手填。
// opportunityId 唯一：一条机会最多一个案件。evidenceRefsJson 建案件时从机会复制（之后机会变化不影响已建案件）。
model ReimbursementCase {
  id               String                    @id @default(cuid())
  tenantId         String
  sellerAccountId  String
  caseNo           String
  opportunityId    String?
  ruleCode         String
  status           String                    @default("OPPORTUNITY")
  sku              String?
  qty              Int?
  expectedAmount   Decimal?                  @db.Decimal(20, 6)
  approvedAmount   Decimal?                  @db.Decimal(20, 6)
  receivedAmount   Decimal                   @default(0) @db.Decimal(20, 6)
  currency         String?
  ownerId          String
  amazonCaseId     String?
  submittedAt      DateTime?
  decidedAt        DateTime?
  paidAt           DateTime?
  deadlineAt       DateTime?                 @db.Date
  evidenceRefsJson Json
  note             String?
  version          Int                       @default(1)
  createdBy        String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount    SellerAccount             @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  opportunity      ReimbursementOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  records          ReimbursementRecord[]
  evidencePacks    EvidencePack[]

  @@unique([tenantId, caseNo], map: "ReimbursementCase_no_uq")
  @@unique([opportunityId], map: "ReimbursementCase_opp_uq")
  @@index([sellerAccountId], map: "ReimbursementCase_store_idx")
  @@index([tenantId, status, createdAt], map: "ReimbursementCase_status_idx")
  @@index([tenantId, amazonCaseId], map: "ReimbursementCase_amz_idx")
}

// P2b-03（CR-002）：亚马逊官方赔付明细（R-27，GET_FBA_REIMBURSEMENTS_DATA）。每行是亚马逊已经赔付的一笔；金额可为负（赔付冲回）。
// 匹配到我方案件时写 matchedCaseId 与 matchBasis（CASE_ID 案件编号、ORDER_SKU 订单加 SKU、SKU_REASON 同店铺同 SKU 且原因吻合且只有一个候选）；没有对应案件的保留，进入“未归属赔付”。
model ReimbursementRecord {
  id                String             @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  reimbursementId   String
  sku               String
  fnsku             String             @default("")
  asin              String?
  reason            String             @default("")
  quantity          Int                @default(0)
  amount            Decimal            @db.Decimal(20, 6)
  currency          String
  approvedAt        DateTime
  originalOrderId   String?
  amazonCaseId      String?
  matchedCaseId     String?
  matchBasis        String?
  matchedAt         DateTime?
  sourceReportJobId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount      @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  matchedCase       ReimbursementCase? @relation(fields: [matchedCaseId], references: [id], onDelete: SetNull)

  @@unique([sellerAccountId, reimbursementId, sku, fnsku], map: "ReimbursementRecord_uq")
  @@index([matchedCaseId], map: "ReimbursementRecord_case_idx")
  @@index([tenantId, sellerAccountId, approvedAt], map: "ReimbursementRecord_date_idx")
}

// P2b-03：证据包（每次导出一份快照）。contentManifestJson 是生成当时的证据行与附件清单，导出文件按它生成，之后证据变化不影响已导出的包。
// 文件本身是导出中心的导出任务（exportJobId），保留 7 天；这里只留清单，所以没有冻结里的 objectKey。
model EvidencePack {
  id                  String            @id @default(cuid())
  tenantId            String
  caseId              String
  exportJobId         String?
  contentManifestJson Json
  lineCount           Int               @default(0)
  generatedAt         DateTime          @default(now())
  generatedBy         String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reimbursementCase   ReimbursementCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, generatedAt], map: "EvidencePack_uq")
  @@index([tenantId, generatedAt], map: "EvidencePack_tenant_idx")
}

// P2b-04：亚马逊支持案件（07 章 7.4，I-20，只读同步；所有修改都在卖家后台进行）。
// status 原样保存亚马逊的取值（RESOLVED、TRANSFERRED、PENDING_MERCHANT_ACTION、PENDING_AMAZON_ACTION），不加检查约束：亚马逊新增取值时同步不能因此失败。
// 不保存案件的主邮箱与抄送邮箱，预约回电只保存时间窗与状态、不保存电话号码（个人信息，页面用不到）。
// 与赔付案件、货件、商品的关联不落库：读取时按亚马逊案件编号（ReimbursementCase.amazonCaseId）与主题里的货件编号推算，赔付案件回填编号后立刻生效。
// contactsForUpdatedAt：取沟通记录时案件的更新时间，与当前更新时间一致就不再重取。
model SupportCase {
  id                   String           @id @default(cuid())
  tenantId             String
  sellerAccountId      String
  caseId               String
  subject              String
  status               String
  amazonCreatedAt      DateTime
  amazonUpdatedAt      DateTime
  amazonResolvedAt     DateTime?
  lastOutboundAt       DateTime?
  appointmentsJson     Json             @default("[]")
  contactsForUpdatedAt DateTime?
  contactCount         Int              @default(0)
  syncedAt             DateTime         @default(now())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount        SellerAccount    @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  contacts             SupportContact[]

  @@unique([sellerAccountId, caseId], map: "SupportCase_uq")
  @@index([tenantId, amazonUpdatedAt], map: "SupportCase_upd_idx")
  @@index([tenantId, amazonCreatedAt], map: "SupportCase_cre_idx")
}

// P2b-04：支持案件的沟通记录（邮件、电话备注、在线聊天），只增不改（亚马逊的沟通记录不可变）。
// direction：FROM_AMAZON 亚马逊发来、FROM_SELLER 我方发出、UNKNOWN 无法判断（电话备注与聊天记录）。
// attachmentsJson 只保存附件名称：亚马逊给的下载链接 15 分钟失效，保存没有意义。body 超过 20000 字时截断。
model SupportContact {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  supportCaseId   String
  contactId       String
  channel         String
  direction       String        @default("UNKNOWN")
  senderName      String?
  body            String        @default("")
  attachmentsJson Json          @default("[]")
  occurredAt      DateTime
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  supportCase     SupportCase   @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)

  @@unique([supportCaseId, contactId], map: "SupportContact_uq")
  @@index([sellerAccountId], map: "SupportContact_store_idx")
  @@index([tenantId, supportCaseId, occurredAt], map: "SupportContact_time_idx")
}

// P2b-06：费用核查基准快照（R-23 预估配送费报告、R-24 佣金预览报告各写自己的列，同一 SKU 同一天一行）。
// 尺寸与重量是亚马逊测量值，换算成厘米与千克；prevSizeTier 是该 SKU 更早一天快照里的尺寸分段，与 sizeTier 不同就是“尺寸分段变化”。
// 配送费与佣金都是单件金额；没给的列为空（不是 0）。只保留最近 90 天，由核查任务清理。
model FeeBaseline {
  id                     String        @id @default(cuid())
  tenantId               String
  sellerAccountId        String
  sku                    String
  asin                   String        @default("")
  snapshotDate           DateTime      @db.Date
  currency               String        @default("USD")
  sizeTier               String?
  prevSizeTier           String?
  lengthCm               Decimal?      @db.Decimal(12, 4)
  widthCm                Decimal?      @db.Decimal(12, 4)
  heightCm               Decimal?      @db.Decimal(12, 4)
  weightKg               Decimal?      @db.Decimal(12, 4)
  salesPrice             Decimal?      @db.Decimal(20, 6)
  expectedFulfillmentFee Decimal?      @db.Decimal(20, 6)
  expectedReferralFee    Decimal?      @db.Decimal(20, 6)
  sourceReportJobId      String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount          SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, sku, snapshotDate], map: "FeeBaseline_uq")
  @@index([tenantId, snapshotDate], map: "FeeBaseline_day_idx")
}

// P2b-06：费用核查结果（07 章 7.6）。feeKind：FULFILLMENT 配送费、COMMISSION 佣金、STORAGE 仓储费、INBOUND_PLACEMENT 入仓配置费。
// 一行 = 一个核查对象（SKU，入仓配置费是货件）在一个核查日（snapshotDate，UTC 日）的结果；页面只看每个店铺最近一个核查日。
// expectedAmount 应收、actualAmount 实收都是正数（费用的绝对值），diffAmount = 实收 - 应收；overchargeAmount 是多收行的差额合计（累计差额），
// occurrences 是多收的行数（发生次数），checkedCount 是参与核对的行数。status：NORMAL 正常、SUSPECTED 疑似多收、APPEALED 已转为赔付机会。
// basisJson 是依据（文字与明细证据）；opportunityId 是转出的赔付机会（不加外键：机会是另一个域的表，这里只做指向）。
model FeeAudit {
  id               String        @id @default(cuid())
  tenantId         String
  sellerAccountId  String
  feeKind          String
  subjectKey       String
  sku              String?
  asin             String?
  shipmentRef      String?
  snapshotDate     DateTime      @db.Date
  currency         String        @default("USD")
  expectedAmount   Decimal       @db.Decimal(20, 6)
  actualAmount     Decimal       @db.Decimal(20, 6)
  diffAmount       Decimal       @db.Decimal(20, 6)
  overchargeAmount Decimal       @default(0) @db.Decimal(20, 6)
  occurrences      Int           @default(0)
  checkedCount     Int           @default(0)
  firstSeenAt      DateTime?
  lastSeenAt       DateTime?
  status           String        @default("NORMAL")
  basisJson        Json          @default("{}")
  opportunityId    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount    SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, feeKind, subjectKey, snapshotDate], map: "FeeAudit_uq")
  @@index([tenantId, snapshotDate, feeKind], map: "FeeAudit_list_idx")
}

// ---- M-P4-01：销售与流量 ----

// 店铺级销售与流量（P4-01，D-01、R-34）：店铺 × 日期 × 粒度（日、周、月）× 来源，按月分区（分区列 date）。
// date 是亚马逊美国站的日历日；周与月粒度的 date 是该周（周日起）或该月的第一天。两个来源同键各存一行（数据中心优先，报告补充；差异记在 SalesTrafficDiff，不覆盖）。
// 比率列（buyBoxPct、unitSessionPct、refundRate）存 0 到 1 的小数（官方给百分数，导入时除以 100）；可空列为空 = 官方没给（不是 0）。
// ordersCount 对应官方的 totalOrderItems（订单商品行数，不是订单数）。
model SalesTrafficDaily {
  id                String        @default(cuid())
  tenantId          String
  sellerAccountId   String
  date              DateTime      @db.Date
  granularity       String
  source            String        @default("DATA_KIOSK")
  orderedSales      Decimal?      @db.Decimal(20, 6)
  unitsOrdered      Int?
  ordersCount       Int?
  sessions          Int?
  pageViews         Int?
  buyBoxPct         Decimal?      @db.Decimal(12, 6)
  unitSessionPct    Decimal?      @db.Decimal(12, 6)
  unitsRefunded     Int?
  refundRate        Decimal?      @db.Decimal(12, 6)
  claimsGranted     Int?
  currency          String        @default("USD")
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@id([id, date])
  @@unique([tenantId, sellerAccountId, date, granularity, source], map: "SalesTrafficDaily_uq")
  @@index([tenantId, date], map: "SalesTrafficDaily_date_idx")
  @@index([sellerAccountId], map: "SalesTrafficDaily_store_idx")
}

// ASIN 级销售与流量（P4-01，D-02、D-03、R-34）：店铺 × ASIN × 粒度（父体、子体、SKU）× 日期 × 来源，按月分区（分区列 date）。
// 与冻结的出入：唯一键多一个 sku（SKU 粒度时同一 ASIN 有多个 SKU；其他粒度为空串），多一列 parentAsin（子体与 SKU 行带父体，供父体分析用）；
// 父体粒度的 asin 是父体编号。口径同上：比率存小数、可空列为空 = 官方没给。units 对应订购件数，ordersCount 对应 totalOrderItems。
model SalesTrafficAsinDaily {
  id                String        @default(cuid())
  tenantId          String
  sellerAccountId   String
  date              DateTime      @db.Date
  asin              String
  asinGranularity   String
  sku               String        @default("")
  parentAsin        String?
  source            String        @default("DATA_KIOSK")
  orderedSales      Decimal?      @db.Decimal(20, 6)
  units             Int?
  ordersCount       Int?
  sessions          Int?
  pageViews         Int?
  buyBoxPct         Decimal?      @db.Decimal(12, 6)
  unitSessionPct    Decimal?      @db.Decimal(12, 6)
  b2bSales          Decimal?      @db.Decimal(20, 6)
  b2bUnits          Int?
  currency          String        @default("USD")
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  sourceReportJobId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@id([id, date])
  @@unique([tenantId, sellerAccountId, asin, asinGranularity, sku, date, source], map: "SalesTrafficAsinDaily_uq")
  @@index([tenantId, date], map: "SalesTrafficAsinDaily_date_idx")
  @@index([tenantId, sellerAccountId, date], map: "SalesTrafficAsinDaily_store_date_idx")
  @@index([sellerAccountId], map: "SalesTrafficAsinDaily_store_idx")
}

// 销售与流量的来源核对记录（P4-01，R-34 的 ST_SOURCE_DIFF）：报告补充来源与数据中心同键数据差异超过阈值时记一行，只记录不覆盖。
// level 是 DAY（店铺日粒度）或 PARENT、CHILD、SKU（ASIN 粒度，asin 与 sku 有值，其余为空串）；再次核对时差异消失的行会被删除。
model SalesTrafficDiff {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  level           String
  date            DateTime      @db.Date
  asin            String        @default("")
  sku             String        @default("")
  metric          String
  kioskValue      Decimal       @db.Decimal(20, 6)
  reportValue     Decimal       @db.Decimal(20, 6)
  delta           Decimal       @db.Decimal(20, 6)
  relativeDiff    Decimal?      @db.Decimal(12, 6)
  detectedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, level, date, asin, sku, metric], map: "SalesTrafficDiff_uq")
  @@index([tenantId, date], map: "SalesTrafficDiff_date_idx")
  @@index([sellerAccountId], map: "SalesTrafficDiff_store_idx")
}

// M-P4-04 品牌分析（R-35 至 R-39）。比率与份额存 0 到 1 的小数；官方没给的值是空，不是 0。
model BrandSearchQueryPerformance {
  id                    String        @id @default(cuid())
  tenantId              String
  sellerAccountId       String
  reportPeriod          String
  periodStart           DateTime      @db.Date
  periodEnd             DateTime      @db.Date
  asin                  String
  searchQuery           String
  searchQueryScore      Int?
  searchVolume          Int?
  impressionsTotal      Int?
  impressionsOwn        Int?
  impressionShare       Decimal?      @db.Decimal(12, 6)
  clicksTotal           Int?
  clicksOwn             Int?
  clickShare            Decimal?      @db.Decimal(12, 6)
  cartAddsTotal         Int?
  cartAddsOwn           Int?
  cartAddShare          Decimal?      @db.Decimal(12, 6)
  purchasesTotal        Int?
  purchasesOwn          Int?
  purchaseShare         Decimal?      @db.Decimal(12, 6)
  clickPriceTotal       Decimal?      @db.Decimal(14, 4)
  clickPriceOwn         Decimal?      @db.Decimal(14, 4)
  cartAddPriceTotal     Decimal?      @db.Decimal(14, 4)
  cartAddPriceOwn       Decimal?      @db.Decimal(14, 4)
  purchasePriceTotal    Decimal?      @db.Decimal(14, 4)
  purchasePriceOwn      Decimal?      @db.Decimal(14, 4)
  currency              String?
  purchasesSameDayTotal Int?
  purchasesSameDayOwn   Int?
  purchasesOneDayTotal  Int?
  purchasesOneDayOwn    Int?
  purchasesTwoDayTotal  Int?
  purchasesTwoDayOwn    Int?
  sourceReportJobId     String?
  sourceUpdatedAt       DateTime
  syncedAt              DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount         SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, reportPeriod, periodStart, asin, searchQuery], map: "BrandSqp_uq")
  @@index([tenantId, reportPeriod, periodStart], map: "BrandSqp_period_idx")
  @@index([sellerAccountId], map: "BrandSqp_store_idx")
}

model BrandSearchCatalogPerformance {
  id                    String        @id @default(cuid())
  tenantId              String
  sellerAccountId       String
  reportPeriod          String
  periodStart           DateTime      @db.Date
  periodEnd             DateTime      @db.Date
  asin                  String
  impressions           Int?
  clicks                Int?
  cartAdds              Int?
  purchases             Int?
  clickRate             Decimal?      @db.Decimal(12, 6)
  conversionRate        Decimal?      @db.Decimal(12, 6)
  searchTrafficSales    Decimal?      @db.Decimal(20, 6)
  impressionMedianPrice Decimal?      @db.Decimal(14, 4)

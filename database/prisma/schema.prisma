  expirationJson           Json?
  sourceUpdatedAt          DateTime
  syncedAt                 DateTime      @default(now())
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  tenant                   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount            SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, sku, snapshotDate], map: "AwdInventory_uq")
  @@index([sellerAccountId], map: "AwdInventory_store_idx")
}


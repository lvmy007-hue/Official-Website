model FbaProduct {
  id                 String        @id @default(cuid())
  tenantId           String
  sellerAccountId    String
  marketplaceId      String        @default("ATVPDKIKX0DER")
  asin               String
  sellerSku          String
  fnsku              String?
  title              String
  brand              String?
  productType        String?
  listingStatus      String        @default("ACTIVE")
  fulfillmentChannel String        @default("AFN")
  sizeTier           String?
  packageLengthCm    Decimal?      @db.Decimal(12, 4)
  packageWidthCm     Decimal?      @db.Decimal(12, 4)
  packageHeightCm    Decimal?      @db.Decimal(12, 4)
  packageWeightKg    Decimal?      @db.Decimal(12, 4)
  price              Decimal?      @db.Decimal(20, 6)
  currency           String        @default("USD")
  sourceUpdatedAt    DateTime
  syncedAt           DateTime      @default(now())
  sourceReportJobId  String?
  sourceRecordId     String?
  // P2a-14：商品目录同步器（I-09）写入的身份区字段；ownerUserId、tagIds 是系统内数据（不写亚马逊）
  parentAsin         String?
  imageUrl           String?
  categoryPath       String?
  ownerUserId        String?
  tagIds             String[]      @default([])
  catalogStatus      String?
  catalogSyncedAt    DateTime?
  // P4-03：变体维度名到取值（例如 {"color":"Red","size":"L"}），目录同步器写入；目录没给出就为空
  variantAttributes  Json?
  // P4-07：负责人与标签的乐观锁版本号（同步器从不改它，也不改 ownerUserId、tagIds）
  version            Int           @default(1)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount      SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, marketplaceId, sellerSku])
  @@index([tenantId, marketplaceId, asin])
  @@index([tenantId, parentAsin], map: "FbaProduct_parent_idx")
  @@index([tenantId, ownerUserId], map: "FbaProduct_owner_idx")
}

// 父子变体关系（P2a-14，I-09）：每次目录同步整体对账（同一父体下已不存在的子体会被删除）。
model ProductVariantRelation {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  parentAsin      String
  childAsin       String
  variationTheme  String?
  sourceUpdatedAt DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, parentAsin, childAsin], map: "ProductVariantRelation_uq")
  @@index([sellerAccountId], map: "ProductVariantRelation_store_idx")
  @@index([tenantId, sellerAccountId, childAsin], map: "ProductVariantRelation_child_idx")
}

// 销售排名快照（P2a-14，I-09）：按 ASIN × 分类 × 日，每个同步日留存一份，保留历史以便看排名走势。
model SalesRankSnapshot {
  id                 String        @id @default(cuid())
  tenantId           String
  sellerAccountId    String
  asin               String
  classificationId   String
  classificationName String
  rank               Int
  snapshotDate       DateTime      @db.Date
  createdAt          DateTime      @default(now())
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount      SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, asin, classificationId, snapshotDate], map: "SalesRankSnapshot_uq")
  @@index([sellerAccountId], map: "SalesRankSnapshot_store_idx")
  @@index([tenantId, sellerAccountId, asin, snapshotDate], map: "SalesRankSnapshot_asin_idx")
}

model FbaInventoryRecord {
  id                       String        @id @default(cuid())
  tenantId                 String
  sellerAccountId          String
  marketplaceId            String        @default("ATVPDKIKX0DER")
  asin                     String
  sellerSku                String
  fnsku                    String?
  fulfillableQuantity      Int           @default(0)
  inboundWorkingQuantity   Int           @default(0)
  inboundShippedQuantity   Int           @default(0)
  inboundReceivingQuantity Int           @default(0)
  reservedQuantity         Int           @default(0)
  unfulfillableQuantity    Int           @default(0)
  researchQuantity         Int           @default(0)
  daysOfSupply             Decimal?      @db.Decimal(12, 2)
  inventoryAgeDays         Int?
  strandedReason           String?
  // P2a-05：数据来源（API 接口汇总 / NOTIFICATION 库存可售变化推送）与最近一次实时更新的时间；不再保存固定阈值判断的健康状态（库存健康由 P2a-06 的规则引擎按版本计算）。
  source                   String        @default("API")
  realtimeSyncedAt         DateTime?
  sourceUpdatedAt          DateTime
  syncedAt                 DateTime      @default(now())
  sourceReportJobId        String?
  sourceRecordId           String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  tenant                   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount            SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, marketplaceId, sellerSku])
  @@index([tenantId, daysOfSupply])
}

model FbaInboundPlan {
  id                        String                    @id @default(cuid())
  tenantId                  String
  sellerAccountId           String
  marketplaceId             String                    @default("ATVPDKIKX0DER")
  externalPlanId            String?
  name                      String
  status                    String                    @default("DRAFT")
  sourceAddress             String
  items                     Json?
  placementOption           String?
  totalUnits                Int                       @default(0)
  shipmentCount             Int                       @default(0)
  sourceUpdatedAt           DateTime?
  syncedAt                  DateTime                  @default(now())
  sourceReportJobId         String?
  sourceRecordId            String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  // P2a-12 入仓计划（v2024-03-20）：我方状态链、来源、待处理操作、已选方案、作废窗口、成本估算与卖家自理成本。预处理方与贴标方固定为卖家（检查约束）。
  stage                     String                    @default("DRAFT")
  sourceType                String                    @default("MANUAL")
  sourceRefId               String?
  prepOwner                 String                    @default("SELLER")
  labelOwner                String                    @default("SELLER")
  pendingOp                 String?
  selectedPackingOptionId   String?
  selectedPlacementOptionId String?
  shippingMode              String?
  transportConfirmedAt      DateTime?
  voidDeadlineAt            DateTime?
  shippedAt                 DateTime?
  estimateJson              Json?
  prepCost                  Decimal?                  @db.Decimal(20, 6)
  labelCost                 Decimal?                  @db.Decimal(20, 6)
  costCurrency              String                    @default("USD")
  lastErrorCode             String?
  lastErrorMessage          String?
  version                   Int                       @default(1)
  createdBy                 String?
  // P6-08：补货批次转来的草稿记下用了哪个发货地址（被计划用过的地址删不掉，只能停用）
  shipFromAddressId         String?
  tenant                    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount             SellerAccount             @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  shipFromAddress           ShipFromAddress?          @relation(fields: [shipFromAddressId], references: [id], onDelete: Restrict)
  shipments                 FbaInboundShipment[]
  planItems                 InboundPlanItem[]
  eligibilityChecks         InboundEligibilityCheck[]
  packingOptions            PackingOption[]
  packingGroups             PackingGroup[]
  boxes                     InboundBox[]
  placementOptions          PlacementOption[]
  transportOptions          TransportOption[]
  deliveryWindows           DeliveryWindow[]
  shipmentItems             ShipmentItem[]
  trackingEvents            TrackingEvent[]
  labelJobs                 LabelPrintJob[]
  labelPrintLogs            LabelPrintLog[]
  operations                InboundOperation[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, stage, updatedAt], map: "FbaInboundPlan_stage_idx")
  @@index([sellerAccountId])
  @@index([shipFromAddressId])
}

// 发货地址（P6-08）：入仓接口要求的发货方地址，按店铺维护，每个店铺至多一个默认地址（部分唯一索引写在迁移里）。
// 被入仓计划用过的地址不能删除（外键 RESTRICT），只能停用；停用的地址不能当默认。
model ShipFromAddress {
  id              String           @id @default(cuid())
  tenantId        String
  sellerAccountId String
  name            String
  addressLine1    String
  addressLine2    String?
  city            String
  stateOrProvince String
  postalCode      String
  countryCode     String
  phone           String
  isDefault       Boolean          @default(false)
  status          String           @default("ACTIVE")
  version         Int              @default(1)
  createdBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount    @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  inboundPlans    FbaInboundPlan[]

  @@unique([tenantId, sellerAccountId, name])
  @@index([sellerAccountId])
}

model FbaInboundShipment {
  id                        String          @id @default(cuid())
  planId                    String
  shipmentId                String
  status                    String          @default("WORKING")
  destinationFc             String?
  placementOption           String?
  transportStatus           String?
  trackingNumber            String?
  unitsExpected             Int             @default(0)
  unitsReceived             Int             @default(0)
  discrepancyQuantity       Int             @default(0)
  sourceUpdatedAt           DateTime?
  syncedAt                  DateTime        @default(now())
  sourceReportJobId         String?
  sourceRecordId            String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  // P2a-12：亚马逊货件确认号（FBA 开头，打标签与查接收用）、首次接收与接收完成时间、承运商、追踪明细与已选的运输方案
  shipmentConfirmationId    String?
  receivedFirstAt           DateTime?
  receivedDoneAt            DateTime?
  carrier                   String?
  boxCount                  Int?
  trackingJson              Json?
  selectedTransportOptionId String?
  selectedWindowId          String?
  plan                      FbaInboundPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  labelPrintLogs            LabelPrintLog[]

  @@unique([planId, shipmentId])
  @@index([status, destinationFc])
}

// 按月分区表（分区列 postedAt，见 M-P1-27）。
model FbaFeeEvent {
  id                   String        @default(cuid())
  tenantId             String
  sellerAccountId      String
  marketplaceId        String        @default("ATVPDKIKX0DER")
  settlementId         String?
  amazonOrderId        String?
  asin                 String?
  sellerSku            String?
  eventType            String
  amount               Decimal       @db.Decimal(20, 6)
  currency             String        @default("USD")
  postedAt             DateTime
  description          String?
  sourceEventId        String?
  sourceUpdatedAt      DateTime
  syncedAt             DateTime      @default(now())
  sourceReportJobId    String?
  sourceRecordId       String?
  createdAt            DateTime      @default(now())
  // P2b-05：9 类费用分类（外加 NON_FEE：销售收入、税、运费收入等不是费用的明细）、子类型（路径最后一段）、来源交易状态、对账状态与备注、乐观锁版本。
  feeCategory          String        @default("OTHER")
  feeSubtype           String?
  transactionStatus    String?
  reconciliationStatus String        @default("UNRECONCILED")
  reconciliationNote   String?
  reconciledBy         String?
  reconciledAt         DateTime?
  version              Int           @default(1)
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount        SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@id([id, postedAt])
  @@unique([sellerAccountId, sourceEventId, postedAt])
  @@index([tenantId, postedAt, eventType])
  @@index([sellerAccountId, settlementId])
  @@index([tenantId, amazonOrderId])
  @@index([tenantId, feeCategory, postedAt])
}

model FbaReturnCase {
  id                        String        @id @default(cuid())
  tenantId                  String
  sellerAccountId           String
  marketplaceId             String        @default("ATVPDKIKX0DER")
  amazonOrderId             String
  returnId                  String?
  asin                      String
  sellerSku                 String
  quantity                  Int           @default(1)
  disposition               String?
  reason                    String?
  refundAmount              Decimal?      @db.Decimal(20, 6)
  reimbursementStatus       String        @default("NOT_REVIEWED")
  status                    String        @default("OPEN")
  returnDate                DateTime
  sourceUpdatedAt           DateTime
  syncedAt                  DateTime      @default(now())
  sourceReportJobId         String?
  sourceRecordId            String?
  // P2b-02（R-26 客户退货报告）：退货件编号（LPN）、FNSKU、配送中心、报告里的处理状态、买家备注、处置明细、关联赔付案件（P2b-03 回填）。
  // disposition 是我方归并后的处置分组（SELLABLE、DAMAGED、CARRIER_DAMAGED…），detailedDisposition 是报告原值。
  fnsku                     String        @default("")
  licensePlateNumber        String        @default("")
  detailedDisposition       String?
  fulfillmentCenterId       String?
  reportStatus              String?
  // P6-14：买家备注加密保存（与订单买家信息同一套密钥 buyer-pii 与保留期）。customerComments 是升级前的明文列，已废弃：
  // 代码不再读写它，只有 worker 的回填任务（maintenance/return-comments.ts）读出来加密后清空；确认存量清空后由 database/ops/drop-return-comment-plaintext.sql 删除。
  customerComments          String?
  customerCommentsCipher    String?
  customerCommentsExpiresAt DateTime?
  customerCommentsKinds     String?
  reimbursementCaseId       String?
  // P6-13：下单时间与发货时间的冗余列（退货周期、跨月退货、队列退货率要用）。同步退货报告后按订单回填，订单还没同步下来时保持为空（不是 0，也不用退货时间代替），
  // 页面单独计数“无法计算周期 N 条”；订单晚到时由下一次退货报告导入或回填任务补上。
  orderPurchasedAt          DateTime?
  orderShippedAt            DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  tenant                    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount             SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, amazonOrderId, asin, sellerSku, fnsku, licensePlateNumber, returnDate], map: "FbaReturnCase_report_uq")
  @@index([tenantId, orderPurchasedAt], map: "FbaReturnCase_orderdate_idx")
  @@index([customerCommentsExpiresAt], map: "FbaReturnCase_commentexp_idx")
  @@index([tenantId, status, returnDate])
  @@index([tenantId, amazonOrderId], map: "FbaReturnCase_order_idx")
  @@index([tenantId, returnDate], map: "FbaReturnCase_date_idx")
}

model FbaReportJob {
  id               String         @id @default(cuid())
  tenantId         String
  sellerAccountId  String?
  marketplaceId    String         @default("ATVPDKIKX0DER")
  reportType       String
  fromDate         DateTime?
  toDate           DateTime?
  status           String         @default("PENDING")
  externalReportId String?
  documentId       String?
  downloadUrl      String?
  expiresAt        DateTime?
  failureCode      String?
  requestId        String
  createdById      String?
  // M-P5-03 报表中心：关联的同步任务、导入统计（没导入过是空，不是 0）、报告文件的字段名（与上一份同类报告对比出字段变化）、解析警告、
  // 中文失败原因、状态时间线（最多 40 条）、重试关系（重试建新任务指向被重试的任务，没有外键）、起止时间。
  syncJobId        String?
  readRows         Int?
  importedRows     Int?
  skippedRows      Int?
  columnsJson      Json?
  warningsJson     Json?
  failureMessage   String?
  timelineJson     Json?
  retryOfId        String?
  attempt          Int            @default(1)
  startedAt        DateTime?
  finishedAt       DateTime?
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount    SellerAccount? @relation(fields: [sellerAccountId], references: [id], onDelete: SetNull)
  createdBy        User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([sellerAccountId, reportType])
  @@index([createdById])
  @@index([tenantId, reportType, createdAt], map: "FbaReportJob_type_idx")
  @@index([tenantId, retryOfId], map: "FbaReportJob_retry_idx")
}

model AdsProfile {
  id                   String                       @id @default(cuid())
  tenantId             String
  profileId            String
  accountId            String?
  marketplaceId        String                       @default("ATVPDKIKX0DER")
  countryCode          String                       @default("US")
  currencyCode         String                       @default("USD")
  timezone             String?
  displayName          String?
  status               String                       @default("ACTIVE")
  // 绑定的店铺（P1-12）：AUTO_MATCHED 自动匹配 / MANUAL 人工绑定 / UNBOUND 未绑定。未绑定的广告账户只有“全部范围”的成员可见。
  sellerAccountId      String?
  bindingStatus        String                       @default("UNBOUND")
  boundBy              String?
  // M-P3-02：统一接口的全球广告账户编号（请求头 Amazon-Ads-AccountId）与旧接口的档案范围编号（Amazon-Advertising-API-Scope，迁移时回填为 profileId）。
  // adsAccountId 在统一接口发现账户之前为空（旧数据没有办法推出它），同一企业内唯一。
  adsAccountId         String?
  legacyScopeId        String?
  // M-P3-15：已取得日级数据的最早日期（只由完成的日粒度报告任务登记，只往前推）与登记时间；是实测值，不是亚马逊承诺的保留期。
  historyFrom          DateTime?                    @db.Date
  historyProbedAt      DateTime?
  sourceUpdatedAt      DateTime?
  syncedAt             DateTime                     @default(now())
  sourceReportJobId    String?
  sourceRecordId       String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount        SellerAccount?               @relation(fields: [sellerAccountId], references: [id], onDelete: SetNull)
  connections          PlatformConnection[]
  campaigns            AdsCampaign[]
  reports              AdsReportJob[]
  metrics              AdsMetric[]
  termMetrics          AdsTermMetric[]
  recommendations      AdsRecommendation[]
  forecastRuns         AdsForecastRun[]
  parityState          AdsParityState?
  parityRuns           AdsParityRun[]
  accounts             AdsAccount[]
  portfolios           AdsPortfolio[]
  adGroups             AdsAdGroup[]
  ads                  AdsAd[]
  targets              AdsTarget[]
  keywords             AdsKeyword[]
  negativeTargets      AdsNegativeTarget[]
  creatives            AdsCreative[]
  budgetRules          AdsBudgetRule[]
  daypartingStrategies DaypartingStrategy[]
  automationRules      AdsAutomationRule[]
  entitySnapshots      AdsEntitySnapshot[]
  changeLogs           AdsChangeLog[]
  writeRuns            AdsWriteRun[]
  placementMetrics     AdsPlacementMetric[]
  advertisedMetrics    AdsAdvertisedProductMetric[]
  convertedDaily       AdsConvertedProductDaily[]
  hourlyMetrics        AdsPerformanceHourly[]
  dailySummaries       AdsDailySummary[]

  @@unique([tenantId, profileId])
  @@unique([tenantId, adsAccountId], map: "AdsProfile_account_uq")
  @@index([tenantId, marketplaceId, status])
  @@index([sellerAccountId])
}

model AdsCampaign {
  id                 String      @id @default(cuid())
  tenantId           String
  adsProfileId       String
  externalCampaignId String
  adProduct          String
  name               String
  state              String
  budget             Decimal?    @db.Decimal(20, 6)
  currency           String      @default("USD")
  startDate          DateTime?
  endDate            DateTime?
  sourceUpdatedAt    DateTime
  syncedAt           DateTime    @default(now())
  sourceReportJobId  String?
  sourceRecordId     String?
  raw                Json?
  // M-P3-02：统一接口的账户编号、所属广告组合、投放方式（AUTO 自动 / MANUAL 手动）、竞价策略、投放状态（与 state 不同：state 是用户设置，servingStatus 是实际是否在投）、预算类型。
  // 全部可空：旧接口同步不给这些字段，没给就是空，不是默认值。
  adsAccountId       String?
  portfolioId        String?
  targetingType      String?
  bidStrategy        String?
  servingStatus      String?
  budgetType         String?
  // M-P3-07：系统内标签与负责人（只存本系统，不写亚马逊）；同步器从不改这三列，version 是修改它们时的乐观锁。
  tags               String[]    @default([])
  ownerId            String?
  version            Int         @default(1)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile         AdsProfile  @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  account            AdsAccount? @relation(fields: [tenantId, adsAccountId], references: [tenantId, adsAccountId], onDelete: Cascade, map: "AdsCampaign_account_fkey")

  @@unique([adsProfileId, externalCampaignId, adProduct])
  @@index([tenantId, state, sourceUpdatedAt])
  @@index([tenantId, adsAccountId, portfolioId], map: "AdsCampaign_portfolio_idx")
}

model AdsReportJob {
  id               String          @id @default(cuid())
  tenantId         String
  adsProfileId     String
  reportType       String
  adProduct        String          @default("SPONSORED_PRODUCTS")
  status           String          @default("PENDING")
  externalReportId String?
  downloadUrl      String?
  fromDate         DateTime?
  toDate           DateTime?
  expiresAt        DateTime?
  failureCode      String?
  requestId        String
  // M-P3-15：新报告接口（V1）任务的规格与结果；旧版（LEGACY）任务这些列保持默认。重试建新任务并指向被重试的任务（retryOfId）。
  source           String          @default("LEGACY")
  templateKey      String?
  granularity      String?
  dimensions       String[]        @default([])
  metricKeys       String[]        @default([])
  importedRows     Int?
  skippedRows      Int?
  warningSignals   Json?
  failureMessage   String?
  retryOfId        String?
  attempt          Int             @default(1)
  requestedBy      String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile       AdsProfile      @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  metrics          AdsMetric[]
  termMetrics      AdsTermMetric[]

  @@index([tenantId, status, createdAt])
  @@index([adsProfileId, reportType])
  @@index([tenantId, source, createdAt], map: "AdsReportJob_source_idx")
}

// 按月分区表（分区列 orderPurchaseDate，取值等于所属订单的 purchaseDate，见 M-P1-27）。
model OrderItem {
  id                 String        @default(cuid())
  tenantId           String
  sellerAccountId    String
  orderId            String
  orderPurchaseDate  DateTime
  amazonOrderId      String
  orderItemId        String
  asin               String?
  sellerSku          String?
  title              String?
  quantityOrdered    Int           @default(0)
  quantityShipped    Int           @default(0)
  itemPrice          Decimal?      @db.Decimal(20, 6)
  currency           String        @default("USD")
  fulfillmentNetwork String?
  condition          String?
  marketplaceId      String        @default("ATVPDKIKX0DER")
  promotionDiscount  Decimal?      @db.Decimal(20, 6)
  taxAmount          Decimal?      @db.Decimal(20, 6)
  itemStatus         String?
  sourceUpdatedAt    DateTime
  syncedAt           DateTime      @default(now())
  sourceReportJobId  String?
  sourceRecordId     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount      SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  order              Order         @relation(fields: [orderId, orderPurchaseDate], references: [id, purchaseDate], onDelete: Cascade)

  @@id([id, orderPurchaseDate])
  @@unique([sellerAccountId, orderItemId, orderPurchaseDate])
  @@index([tenantId, amazonOrderId])
  @@index([sellerAccountId, sellerSku])
  @@index([orderId, orderPurchaseDate])
}

model FbaSettlement {
  id                   String                    @id @default(cuid())
  tenantId             String
  sellerAccountId      String
  marketplaceId        String                    @default("ATVPDKIKX0DER")
  externalSettlementId String
  settlementStartDate  DateTime?
  settlementEndDate    DateTime?
  depositDate          DateTime?
  totalAmount          Decimal?                  @db.Decimal(20, 6)
  currency             String                    @default("USD")
  status               String                    @default("RECEIVED")
  sourceUpdatedAt      DateTime
  syncedAt             DateTime                  @default(now())
  sourceReportJobId    String?
  sourceRecordId       String?
  raw                  Json?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  // P2b-07 结算交易：期初余额（上期保留金余额）、打款金额、报告明细条数、对账状态与差额、各类别合计、列表排序时间（打款日，没有则周期结束日，再没有则建立时间）。
  openingBalance       Decimal?                  @db.Decimal(20, 6)
  disbursementAmount   Decimal?                  @db.Decimal(20, 6)
  txnCount             Int                       @default(0)
  reconciliationStatus String                    @default("PENDING")
  diffAmount           Decimal?                  @db.Decimal(20, 6)
  summaryJson          Json?
  sortAt               DateTime                  @default(now())
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount        SellerAccount             @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  transactions         FbaFinancialTransaction[]
  lines                SettlementLine[]
  reconciliation       Reconciliation?
  disbursement         Disbursement?

  @@unique([sellerAccountId, externalSettlementId])
  @@index([tenantId, depositDate])
  @@index([tenantId, sortAt], map: "FbaSettlement_sort_idx")
}

// 结算报告明细（P2b-07，R-28）：报告里每一行金额一行，只存结构化列，原始文件另存对象存储。一份结算单的行序号固定，重复导入按（结算单, 行序号）覆盖。
model SettlementLine {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  settlementId      String
  lineNo            Int
  transactionType   String        @default("")
  amountType        String        @default("")
  amountDescription String        @default("")
  category          String
  amazonOrderId     String?
  shipmentId        String?
  sku               String?
  quantity          Int?
  postedAt          DateTime?
  amount            Decimal       @db.Decimal(20, 6)
  currency          String        @default("USD")
  sourceReportJobId String?
  createdAt         DateTime      @default(now())
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  settlement        FbaSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([settlementId, lineNo], map: "SettlementLine_uq")
  @@index([tenantId, amazonOrderId], map: "SettlementLine_order_idx")
  @@index([sellerAccountId], map: "SettlementLine_store_idx")
}

// 到账手工登记（P2b-08；冻结 Disbursement）：财务在银行流水里看到打款后登记，与结算报告的打款日、打款总额对照。一张结算单一条（改正走乐观锁更新，不另起一行）。
// 银行收到的可能是另一个币种（亚马逊按收款账户币种结汇），所以登记自带币种，币种不同不比较金额。bankLast4 只存收款账户末四位，不存完整账号。
model Disbursement {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  settlementId    String        @unique
  disbursedAt     DateTime      @db.Date
  amount          Decimal       @db.Decimal(20, 6)
  currency        String
  bankLast4       String?
  note            String?
  version         Int           @default(1)
  createdBy       String
  updatedBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  settlement      FbaSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([tenantId, disbursedAt], map: "Disbursement_date_idx")
  @@index([sellerAccountId], map: "Disbursement_store_idx")
}

// 销售税汇总（P2b-12；冻结 SalesTaxSummary）：税务文档库报告（R-33）按（店铺、日期、州、辖区、税种）汇总的代收代缴税额。
// 一份报告导入时，先删掉它覆盖的日期范围内同店铺同来源的旧汇总再写新的（重复导入不翻倍）。taxableSales 为空表示报告没给应税销售额列。
// 与冻结的出入：taxPeriod 是日（不是月）——报告可以分段生成，按日存才不会让后一份报告覆盖前一份的半个月；页面按月汇总。
// source 目前只写 TAX_LIBRARY；订单接口的税额直接读 OrderCharge（订单接口不给州，存成汇总没有意义），发货报告 SHIPMENT_REPORT 尚未接入。
model SalesTaxSummary {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  taxPeriod         DateTime      @db.Date
  state             String
  jurisdictionKey   String        @default("")
  taxKind           String        @default("SALES_TAX")
  source            String
  taxableSales      Decimal?      @db.Decimal(20, 6)
  taxCollected      Decimal       @db.Decimal(20, 6)
  lineCount         Int           @default(0)
  currency          String        @default("USD")
  sourceReportJobId String?
  syncedAt          DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, taxPeriod, state, jurisdictionKey, taxKind, source], map: "SalesTaxSummary_uq")
  @@index([tenantId, taxPeriod], map: "SalesTaxSummary_period_idx")
  @@index([sellerAccountId], map: "SalesTaxSummary_store_idx")
}

// 会计期间（P2b-13，07 章 7.12；冻结 AccountingPeriod）：一个店铺一个自然月一行，走 开放 → 关账中 → 已关账 →（重新开账 → 关账中 → 已关账）。
// status: OPEN（开放）、CLOSING（关账中：完整性检查已通过，等审批与锁定；这期间利润日表对该店铺该期间停止重算，审批看到的就是锁定的）、CLOSED（已关账）、REOPENED（重新开账）。
// checklistJson 是最近一次完整性检查的结果（含放行确认）；approvalDecision 为 APPROVED 或 REJECTED，每次重新检查都会清空，必须重新审批；
// closeCount 是已关账次数，也是下一份快照的修订号减一。periodStart、periodEnd 是企业数据口径时区的日历日（含首尾），与利润日表的 profitDate 同口径。
model AccountingPeriod {
  id               String           @id @default(cuid())
  tenantId         String
  sellerAccountId  String
  periodStart      DateTime         @db.Date
  periodEnd        DateTime         @db.Date
  status           String           @default("OPEN")
  version          Int              @default(1)
  checklistJson    Json             @default("{}")
  checkedBy        String?
  checkedAt        DateTime?
  approvalDecision String?
  approvedBy       String?
  approvedAt       DateTime?
  approvalComment  String?
  closeCount       Int              @default(0)
  closedBy         String?
  closedAt         DateTime?
  reopenedBy       String?
  reopenedAt       DateTime?
  reopenReason     String?
  createdBy        String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount    SellerAccount    @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  snapshots        PeriodSnapshot[]

  @@unique([tenantId, sellerAccountId, periodStart], map: "AccountingPeriod_uq")
  @@index([sellerAccountId], map: "AccountingPeriod_store_idx")
}

// 期间快照（P2b-13；冻结 PeriodSnapshot）：每次关账锁定时写一份，只追加、从不修改（重新开账后再关账是新的修订号）。
// 三份快照：利润日表（三种收入确认口径各一份合计与逐 SKU 汇总）、期间内的汇率、期间内生效过的成本版本；diffJson 是与上一修订的差异报告（第一次关账为空）。
model PeriodSnapshot {
  id                        String           @id @default(cuid())
  tenantId                  String
  periodId                  String
  revision                  Int
  profitSnapshotJson        Json
  fxSnapshotJson            Json
  costVersionSnapshotJson   Json
  diffJson                  Json?
  /// P6-19：关账时各类口径版本（先写分摊规则；P6-31 补其余类型）。旧快照为空，表示关账时还没有口径版本。
  metricVersionSnapshotJson Json?
  lockedBy                  String
  lockedAt                  DateTime         @default(now())
  tenant                    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period                    AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, revision], map: "PeriodSnapshot_uq")
  @@index([tenantId, lockedAt], map: "PeriodSnapshot_tenant_idx")
}

// 结算核对结果（P2b-07；冻结 Reconciliation）：一张结算单一行。scopeKind 目前只有 SETTLEMENT，DATE 留给官方经济数据对账（P2b-11）。
// 与冻结的出入：唯一键用 settlementId（冻结是店铺 + 口径 + 起止日期，不同结算单周期可能相同）。
model Reconciliation {
  id              String                    @id @default(cuid())
  tenantId        String
  sellerAccountId String
  scopeKind       String                    @default("SETTLEMENT")
  settlementId    String?                   @unique
  rangeStart      DateTime                  @db.Date
  rangeEnd        DateTime                  @db.Date
  currency        String                    @default("USD")
  officialAmount  Decimal                   @db.Decimal(20, 6)
  systemAmount    Decimal                   @db.Decimal(20, 6)
  diffAmount      Decimal                   @db.Decimal(20, 6)
  status          String                    @default("PENDING")
  pendingReason   String?
  detailJson      Json                      @default("{}")
  computedAt      DateTime
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount             @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  settlement      FbaSettlement?            @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  exceptions      ReconciliationException[]

  @@index([tenantId, scopeKind, rangeStart], map: "Reconciliation_range_idx")
  @@index([sellerAccountId], map: "Reconciliation_store_idx")
}

// 核对异常（P2b-07；冻结 ReconciliationException）：一个“订单（或账户级）”一行，系统生成；下一轮核对不再出现就标为已消除。
model ReconciliationException {
  id               String         @id @default(cuid())
  tenantId         String
  reconciliationId String
  kind             String
  category         String
  refKey           String
  amazonOrderId    String?
  currency         String         @default("USD")
  reportAmount     Decimal        @default(0) @db.Decimal(20, 6)
  apiAmount        Decimal        @default(0) @db.Decimal(20, 6)
  amount           Decimal        @db.Decimal(20, 6)
  absAmount        Decimal        @db.Decimal(20, 6)
  note             String?
  status           String         @default("OPEN")
  resolvedBy       String?
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@unique([reconciliationId, refKey], map: "ReconciliationException_uq")
  @@index([tenantId, reconciliationId, status], map: "ReconciliationException_list_idx")
  @@index([reconciliationId, absAmount], map: "ReconciliationException_sort_idx")
}

// 按月分区表（分区列 postedAt，见 M-P1-27）。
model FbaFinancialTransaction {
  id                    String         @default(cuid())
  tenantId              String
  sellerAccountId       String
  settlementId          String?
  marketplaceId         String         @default("ATVPDKIKX0DER")
  externalTransactionId String
  amazonOrderId         String?
  transactionType       String?
  transactionStatus     String?
  relatedIdentifiers    Json?
  reconciliationStatus  String         @default("UNRECONCILED")
  // P2b-08：递延交易的预计释放日（接口 DeferredContext.maturityDate）；接口没给就是空，不推测
  maturityAt            DateTime?
  amount                Decimal        @db.Decimal(20, 6)
  currency              String         @default("USD")
  postedAt              DateTime
  description           String?
  raw                   Json?
  sourceUpdatedAt       DateTime
  syncedAt              DateTime       @default(now())
  sourceReportJobId     String?
  sourceRecordId        String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount         SellerAccount  @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  settlement            FbaSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@id([id, postedAt])
  @@unique([sellerAccountId, externalTransactionId, postedAt], map: "FbaFinancialTransaction_dedupe_key")
  @@index([tenantId, postedAt, transactionType])
  @@index([settlementId])
  @@index([tenantId, amazonOrderId])
}

// 按月分区表（分区列 reportDate，见 M-P1-27）。
model AdsMetric {
  id                 String        @default(cuid())
  tenantId           String
  adsProfileId       String
  reportJobId        String?
  reportDate         DateTime
  adProduct          String        @default("SPONSORED_PRODUCTS")
  externalCampaignId String?
  campaignName       String?
  impressions        Int           @default(0)
  clicks             Int           @default(0)
  cost               Decimal?      @db.Decimal(20, 6)
  sales              Decimal?      @db.Decimal(20, 6)
  purchases          Int           @default(0)
  currency           String        @default("USD")
  raw                Json?
  // M-P3-02：指标的对象维度。entityType 取 CAMPAIGN、AD_GROUP、AD、TARGET、KEYWORD（旧数据都是 CAMPAIGN，entityId = externalCampaignId）。
  // 冻结文档的 spend 与 orders 在本表沿用原列名 cost 与 purchases（不改名，避免动全部读写方）；units 与 warningSignals 是新列，没给就是空。
  adsAccountId       String?
  entityType         String        @default("CAMPAIGN")
  entityId           String?
  units              Int?
  warningSignals     Json?
  sourceUpdatedAt    DateTime
  syncedAt           DateTime      @default(now())
  sourceReportJobId  String?
  sourceRecordId     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile         AdsProfile    @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  reportJob          AdsReportJob? @relation(fields: [reportJobId], references: [id], onDelete: SetNull)
  account            AdsAccount?   @relation(fields: [tenantId, adsAccountId], references: [tenantId, adsAccountId], onDelete: Cascade, map: "AdsMetric_account_fkey")

  @@id([id, reportDate])
  @@unique([adsProfileId, reportDate, adProduct, externalCampaignId])
  @@unique([tenantId, adsAccountId, entityType, entityId, reportDate, adProduct], map: "AdsMetric_entity_uq")
  @@index([tenantId, reportDate])
  @@index([reportJobId])
}

// 按月分区表（分区列 reportDate，见 M-P1-27）。
model AdsTermMetric {
  id                      String        @default(cuid())
  tenantId                String
  adsProfileId            String
  reportJobId             String?
  reportDate              DateTime
  adProduct               String        @default("SPONSORED_PRODUCTS")
  level                   String
  externalCampaignId      String?
  campaignName            String?
  adGroupId               String?
  adGroupName             String?
  keywordId               String?
  keywordText             String?
  matchType               String?
  searchTerm              String?
  rowKey                  String
  impressions             Int           @default(0)
  clicks                  Int           @default(0)
  cost                    Decimal?      @db.Decimal(20, 6)
  sales                   Decimal?      @db.Decimal(20, 6)
  purchases               Int           @default(0)
  currency                String        @default("USD")
  raw                     Json?
  // M-P3-02：关联投放对象（旧数据回填为 keywordId）、搜索词命中的投放表达式、低于亚马逊披露阈值被归入“其他”的标记。
  adsAccountId            String?
  targetId                String?
  matchedTargetExpression String?
  otherBucket             Boolean       @default(false)
  sourceUpdatedAt         DateTime
  syncedAt                DateTime      @default(now())
  sourceReportJobId       String?
  sourceRecordId          String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile              AdsProfile    @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  reportJob               AdsReportJob? @relation(fields: [reportJobId], references: [id], onDelete: SetNull)
  account                 AdsAccount?   @relation(fields: [tenantId, adsAccountId], references: [tenantId, adsAccountId], onDelete: Cascade, map: "AdsTermMetric_account_fkey")

  @@id([id, reportDate])
  @@unique([adsProfileId, reportDate, adProduct, level, rowKey], map: "AdsTermMetric_dedupe_key")
  @@index([tenantId, reportDate, level], map: "AdsTermMetric_tenant_date_level_idx")
  @@index([adsProfileId, externalCampaignId], map: "AdsTermMetric_profile_campaign_idx")
  @@index([reportJobId])
}

model Supplier {
  id              String               @id @default(cuid())
  tenantId        String
  code            String
  name            String
  contactName     String?
  email           String?
  phone           String?
  currency        String               @default("USD")
  status          String               @default("ACTIVE")
  notes           String?
  // 乐观锁版本号（P2a-10）；表现指标由系统在收货、质检、关闭采购单后重算（口径见契约 supplierRating），null 表示样本不足而不是 0
  version         Int                  @default(1)
  onTimeRate      Decimal?             @db.Decimal(7, 4)
  qualityPassRate Decimal?             @db.Decimal(7, 4)
  avgLeadDays     Int?
  rating          String?
  metricsAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
  skuAliases      SkuAlias[]
  packingMappings PackingListMapping[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model PurchaseOrder {
  id               String                  @id @default(cuid())
  tenantId         String
  supplierId       String
  number           String
  status           String                  @default("DRAFT")
  currency         String                  @default("USD")
  totalAmount      Decimal?                @db.Decimal(20, 6)
  expectedDate     DateTime?
  notes            String?
  createdById      String?
  // 乐观锁版本号：更新必须带 where version = ?，成功后加一（P1-15）
  version          Int                     @default(1)
  // P2a-10：审批、付款、收货进度与时间点。状态取值见契约 PO_STATUSES；approvalStatus: NONE、PENDING、APPROVED、REJECTED；paymentStatus: UNPAID、PARTIAL、PAID
  approvalStatus   String                  @default("NONE")
  paymentStatus    String                  @default("UNPAID")
  receivedQtyTotal Int                     @default(0)
  submittedAt      DateTime?
  orderedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier         Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines            PurchaseOrderLine[]
  receipts         PurchaseReceipt[]
  inspections      QualityInspection[]
  payments         PurchasePayment[]
  approvals        PurchaseApproval[]
  firstMileItems   FirstMileShipmentItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  sellerSku        String
  asin             String?
  title            String?
  quantity         Int           @default(0)
  receivedQuantity Int           @default(0)
  unitCost         Decimal?      @db.Decimal(20, 6)
  currency         String        @default("USD")
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId, sellerSku])
}

model Warehouse {
  id                 String              @id @default(cuid())
  tenantId           String
  code               String
  name               String
  countryCode        String              @default("US")
  kind               String              @default("FBA")
  status             String              @default("ACTIVE")
  address            Json?
  // P2a-10：国内仓的库存计价方法（WEIGHTED_AVERAGE、FIFO）；kind 取值 DOMESTIC（国内仓）、TRANSIT（头程中转仓），其余为旧数据
  costMethod         String              @default("WEIGHTED_AVERAGE")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements          InventoryMovement[]
  receipts           PurchaseReceipt[]
  stockCounts        StockCount[]
  firstMileShipments FirstMileShipment[]

  @@unique([tenantId, code])
  @@index([tenantId, kind, status])
}

model InventoryMovement {
  id                String     @id @default(cuid())
  tenantId          String
  sellerAccountId   String?
  warehouseId       String?
  sellerSku         String
  asin              String?
  movementType      String
  quantity          Int
  referenceType     String?
  referenceId       String?
  occurredAt        DateTime
  notes             String?
  raw               Json?
  // P2a-10 国内仓流水：原因码、占用（正数加锁、负数解锁，已分配给发货或头程）、入库成本（计价用，没有成本的入库留空）、操作人
  reasonCode        String?
  lockedForShipment Int        @default(0)
  unitCost          Decimal?   @db.Decimal(20, 6)
  currency          String?
  createdBy         String?
  createdAt         DateTime   @default(now())
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([tenantId, sellerSku, occurredAt])
  @@index([tenantId, movementType, occurredAt])
  @@index([warehouseId])
}

// P2a-10：采购收货（分批）。lines 为 [{lineId, sellerSku, quantity, batchNo?, unitCost?}]；收货同时在国内仓记入库流水。
model PurchaseReceipt {
  id              String        @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  warehouseId     String?
  receiptNo       String
  receivedAt      DateTime      @db.Date
  linesJson       Json
  totalQty        Int
  note            String?
  receivedBy      String
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  warehouse       Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@unique([tenantId, receiptNo], map: "PurchaseReceipt_uq")
  @@index([purchaseOrderId], map: "PurchaseReceipt_po_idx")
  @@index([warehouseId], map: "PurchaseReceipt_wh_idx")
}

// P2a-10：质检登记。result: PASS、CONCESSION（让步接收）、FAIL；抽检比例 = sampleQty / lotQty，不良率 = defectQty / sampleQty。
model QualityInspection {
  id              String        @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  receiptId       String?
  result          String
  lotQty          Int
  sampleQty       Int
  defectQty       Int
  handling        String?
  note            String?
  inspectorId     String
  inspectedAt     DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId], map: "QualityInspection_po_idx")
  @@index([tenantId, inspectedAt], map: "QualityInspection_tenant_idx")
}

// P2a-10：付款。kind: DEPOSIT、BALANCE、OTHER；status: PLANNED（计划）、PAID（已付）；paidAt 为空表示还没付。
model PurchasePayment {
  id                  String        @id @default(cuid())
  tenantId            String
  purchaseOrderId     String
  kind                String
  amount              Decimal       @db.Decimal(20, 6)
  currency            String
  method              String?
  status              String        @default("PLANNED")
  plannedAt           DateTime?     @db.Date
  paidAt              DateTime?     @db.Date
  voucherAttachmentId String?
  note                String?
  createdBy           String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId], map: "PurchasePayment_po_idx")
  @@index([tenantId, status], map: "PurchasePayment_tenant_idx")
}

// P2a-10：审批记录。每次提交审批新增一行（step 逐次递增）；pending 时 approverId 为空。decision: PENDING、APPROVED、REJECTED。
model PurchaseApproval {
  id              String        @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  step            Int
  submittedBy     String
  approverId      String?
  decision        String        @default("PENDING")
  comment         String?
  decidedAt       DateTime?
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, step], map: "PurchaseApproval_uq")
  @@index([tenantId, decision], map: "PurchaseApproval_tenant_idx")
}

// P2a-10：附件（采购单、供应商）。文件放对象存储（objectKey），同一对象下按内容摘要去重。
model Attachment {
  id          String   @id @default(cuid())
  tenantId    String
  entityType  String
  entityId    String
  fileName    String
  contentType String
  objectKey   String
  sizeBytes   Int
  sha256      String
  uploadedBy  String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, entityId, sha256], map: "Attachment_uq")
  @@index([tenantId, entityType, entityId], map: "Attachment_entity_idx")
}

// P2a-10：盘点单。linesJson 为 [{sellerSku, systemQty, countedQty, diff}]（systemQty 是录入时刻的账面数）；审批后才按差异调整库存。
// status: COUNTING（盘点中，含被驳回退回）、PENDING_APPROVAL（待审）、POSTED（已过账）。
model StockCount {
  id          String    @id @default(cuid())
  tenantId    String
  warehouseId String
  status      String    @default("COUNTING")
  countedAt   DateTime  @db.Date
  linesJson   Json
  note        String?
  reviewNote  String?
  createdBy   String
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, warehouseId, countedAt], map: "StockCount_uq")
  @@index([warehouseId], map: "StockCount_wh_idx")
}

// P2a-10：成本版本（收货后自动生成草稿，生效与替换由商品成本页面 P2b-14 负责）。
// 与冻结文档的差异：采购不分店铺，所以唯一键是 (tenantId, sku, versionNo)，没有 storeId；头程分摊、其他成本留空表示尚未分摊（不是 0）。
// source: PURCHASE_RECEIPT、FIRST_MILE_ALLOCATION、MANUAL、FILE_IMPORT；status: DRAFT、ACTIVE、REPLACED。
model CostVersion {
  id                String    @id @default(cuid())
  tenantId          String
  sku               String
  versionNo         Int
  effectiveFrom     DateTime  @db.Date
  currency          String
  unitProductCost   Decimal?  @db.Decimal(20, 6)
  unitFirstMileCost Decimal?  @db.Decimal(20, 6)
  unitOtherCost     Decimal?  @db.Decimal(20, 6)
  source            String
  status            String    @default("DRAFT")
  sourceDocId       String?
  // P2b-14：关税、备注、乐观锁版本号、录入人、生效与被替换的留痕。四项成本为空表示“没有这一项”，不是 0；至少有一项。
  unitDutyCost      Decimal?  @db.Decimal(20, 6)
  note              String?
  version           Int       @default(1)
  createdBy         String?
  activatedBy       String?
  activatedAt       DateTime?
  replacedById      String?
  replacedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  allocations LandedCostAllocation[]

  @@unique([tenantId, sku, versionNo], map: "CostVersion_uq")
  @@unique([tenantId, source, sourceDocId, sku], map: "CostVersion_source_uq")
  @@index([tenantId, sku, status], map: "CostVersion_sku_status_idx")
}

// 财务口径版本（P2b-15；冻结 FinancePolicyVersion，09 章 9.12）：收入确认口径、存货计价方法、汇率折算规则、广告分摊规则、店铺级费用分摊规则。
// 修改要经审批：发起时是 PENDING（待审批），另一位有权限的成员通过后变 ACTIVE 并替换旧的 ACTIVE，驳回或撤回是 REJECTED；每个企业同时只有一份 PENDING、一份 ACTIVE。
// 版本只追加：已审批的版本不再改动，要改就提交新版本。version 是乐观锁。
model FinancePolicyVersion {
  id                  String    @id @default(cuid())
  tenantId            String
  versionNo           Int
  effectiveFrom       DateTime  @db.Date
  revenueRecognition  String
  inventoryCostMethod String
  fxRateRule          String    @default("SALE_DAY")
  adsAllocationMode   String
  storeFeeAllocation  String
  status              String    @default("PENDING")
  reason              String
  version             Int       @default(1)
  createdBy           String
  createdAt           DateTime  @default(now())
  decidedBy           String?
  decidedAt           DateTime?
  decisionComment     String?
  replacedAt          DateTime?
  updatedAt           DateTime  @updatedAt
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, versionNo], map: "FinancePolicyVersion_uq")
  @@index([tenantId, status], map: "FinancePolicyVersion_status_idx")
}

// ---- M-P3-02：广告数据模型 ----
// 广告账户（统一接口的全球账户）。一个广告档案（AdsProfile，旧接口的“站点档案”）对应一个账户；账户下的实体与指标都挂 (tenantId, adsAccountId)。
// 实体与指标表同时带 adsProfileId（范围过滤：档案绑定店铺后按店铺过滤）与 (tenantId, adsAccountId) 外键（删除账户级联删除全部子数据）。
// 同步表统一字段 sourceUpdatedAt、syncedAt、sourceReportJobId、sourceRecordId（10.1）。
model AdsAccount {
  id                String                       @id @default(cuid())
  tenantId          String
  adsProfileId      String
  adsAccountId      String
  name              String
  entityId          String?
  status            String                       @default("ACTIVE")
  currency          String                       @default("USD")
  timezone          String?
  sourceUpdatedAt   DateTime
  syncedAt          DateTime                     @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile        AdsProfile                   @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  campaigns         AdsCampaign[]
  metrics           AdsMetric[]
  termMetrics       AdsTermMetric[]
  recommendations   AdsRecommendation[]
  forecastRuns      AdsForecastRun[]
  portfolios        AdsPortfolio[]
  adGroups          AdsAdGroup[]
  ads               AdsAd[]
  targets           AdsTarget[]
  keywords          AdsKeyword[]
  negativeTargets   AdsNegativeTarget[]
  creatives         AdsCreative[]
  budgetRules       AdsBudgetRule[]
  placementMetrics  AdsPlacementMetric[]
  advertisedMetrics AdsAdvertisedProductMetric[]
  convertedDaily    AdsConvertedProductDaily[]
  hourlyMetrics     AdsPerformanceHourly[]

  @@unique([tenantId, adsAccountId], map: "AdsAccount_uq")
  @@index([adsProfileId], map: "AdsAccount_profile_idx")
}

// 广告组合：预算上限与已花费（币种单独存，冻结表没有这一列，但没有币种的预算没有意义）。budgetPeriod 的取值以亚马逊返回为准，不做检查约束。
// M-P3-11：budgetStart、budgetEnd 是“指定日期范围”预算的起止日（按月预算不用），冻结表没有这两列，但没有起止日就算不出预算节奏；没给就是空。
model AdsPortfolio {
  id                String     @id @default(cuid())
  tenantId          String
  adsProfileId      String
  adsAccountId      String
  portfolioId       String
  name              String
  budgetCap         Decimal?   @db.Decimal(20, 6)
  budgetPeriod      String?
  budgetStart       DateTime?  @db.Date
  budgetEnd         DateTime?  @db.Date
  spent             Decimal    @default(0) @db.Decimal(20, 6)
  currency          String     @default("USD")
  status            String
  sourceUpdatedAt   DateTime
  syncedAt          DateTime   @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile        AdsProfile @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  account           AdsAccount @relation(fields: [tenantId, adsAccountId], references: [tenantId, adsAccountId], onDelete: Cascade, map: "AdsPortfolio_account_fkey")

  @@unique([tenantId, adsAccountId, portfolioId], map: "AdsPortfolio_uq")
  @@index([adsProfileId], map: "AdsPortfolio_profile_idx")
}

// 广告预算规则（P3-11，冻结 AdsBudgetRule）：亚马逊广告统一接口里“预算规则”资源（大促日、节假日临时提高预算）的本地副本。
// 该资源仍是测试版（verification-log 第 10 节），页面只在功能开关 ADS_BUDGET_RULES_BETA 打开时读取；目前没有任何同步器写这张表。
// paramsJson 原样保存接口返回的规则参数；status 取值以亚马逊返回为准。
model AdsBudgetRule {
  id                String     @id @default(cuid())
  tenantId          String
  adsProfileId      String
  adsAccountId      String
  campaignId        String
  ruleType          String
  paramsJson        Json
  status            String
  sourceUpdatedAt   DateTime
  syncedAt          DateTime   @default(now())
  sourceReportJobId String?
  sourceRecordId    String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile        AdsProfile @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  account           AdsAccount @relation(fields: [tenantId, adsAccountId], references: [tenantId, adsAccountId], onDelete: Cascade, map: "AdsBudgetRule_account_fkey")

  @@unique([tenantId, adsAccountId, campaignId, ruleType], map: "AdsBudgetRule_uq")
  @@index([adsProfileId], map: "AdsBudgetRule_profile_idx")
}

// 分时策略（P3-12，冻结 DaypartingStrategy）：系统自己的数据，同步器从不写。一个策略属于一个广告档案（亚马逊的写接口与时区都按档案），
// 作用对象是同一档案下的活动或广告组（scopeJson = { ids: [系统编号] }）；hourlyMultipliersJson 是 168 个数（周一 0 点起，每周 7 × 24 个小时格）：
// kind = BID_MULTIPLIER 时是竞价系数（0.1 至 3），kind = ON_OFF 时 1 表示启用、0 表示暂停；baseBid 只给竞价系数用（空表示以执行时对象的当前竞价为基准）。
// 与冻结的出入：冻结按店铺（storeId）建键，这里按广告档案（档案可能没绑店铺，范围过滤经 AdsProfile.sellerAccountId）；多了 kind、targetLevel、baseBid、version（乐观锁）与操作人。
model DaypartingStrategy {
  id                    String          @id @default(cuid())
  tenantId              String
  adsProfileId          String
  name                  String
  kind                  String
  targetLevel           String
  scopeJson             Json
  hourlyMultipliersJson Json
  baseBid               Decimal?        @db.Decimal(20, 6)
  timezone              String
  status                String
  version               Int             @default(1)
  createdBy             String
  updatedBy             String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile            AdsProfile      @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  runs                  DaypartingRun[]

  @@unique([tenantId, adsProfileId, name], map: "DaypartingStrategy_uq")
  @@index([adsProfileId], map: "DaypartingStrategy_profile_idx")
}

// 分时策略的执行记录（P3-12 建表，P3-17 执行器写入）：每次调度对每个对象一行。executed = 是否真的写到了亚马逊；
// outcome：QUEUED 已提交写入、等亚马逊确认（writeRunId 关联 AdsWriteRun）、APPLIED 亚马逊确认后（executed=true）、SKIPPED 按设计跳过（开关关闭、策略已暂停、系数没变）、FAILED 失败（message 写原因）。
// 与冻结的出入：冻结只有 campaignId 与 hour，这里的 entityId 是活动或广告组的系统编号，多了 outcome、message 与 writeRunId。
model DaypartingRun {
  id                String             @id @default(cuid())
  tenantId          String
  strategyId        String
  entityId          String
  hour              Int
  appliedMultiplier Decimal            @db.Decimal(8, 4)
  executed          Boolean            @default(false)
  outcome           String
  message           String?
  writeRunId        String?
  runAt             DateTime
  createdAt         DateTime           @default(now())
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  strategy          DaypartingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([strategyId, entityId, runAt], map: "DaypartingRun_uq")
  @@index([tenantId, runAt], map: "DaypartingRun_tenant_idx")
  @@index([writeRunId], map: "DaypartingRun_write_idx")
}

// 广告自动规则（P3-13，冻结 AdsAutomationRule）：系统自己的数据，同步器从不写。一条规则属于一个广告档案（与分时策略相同，范围过滤经档案绑定的店铺）。
// level：CAMPAIGN 活动、TARGET 投放词、SEARCH_TERM 搜索词；mode：SUGGEST 建议（命中生成待办）、AUTO 自动执行（P3-17：活动与投放词提交写入，搜索词层级只生成待办）。
// scopeJson = { campaignIds: [...] }（空数组 = 账户下全部活动，系统编号）；conditionJson = { conditions: [...], textFilters: [...] }；actionJson = 动作；guardrailJson = 护栏。
// 与冻结的出入：冻结按店铺（storeId）建键，这里按广告档案；多了 level、frequency、guardrailJson、lastEvaluated、lastMatched、version、createdBy、updatedBy。
model AdsAutomationRule {
  id            String             @id @default(cuid())
  tenantId      String
  adsProfileId  String
  name          String
  level         String
  mode          String
  status        String
  frequency     String
  scopeJson     Json
  conditionJson Json
  actionJson    Json
  guardrailJson Json
  lastRunAt     DateTime?
  lastEvaluated Int?
  lastMatched   Int?
  version       Int                @default(1)
  createdBy     String
  updatedBy     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile    AdsProfile         @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)
  runs          AdsAutomationRun[]

  @@unique([tenantId, adsProfileId, name], map: "AdsAutomationRule_uq")
  @@index([adsProfileId], map: "AdsAutomationRule_profile_idx")
}

// 自动规则的执行记录（P3-13 建表，定时评估写入）：每次评估对每个命中的对象一行。outcome：SUGGESTED 已生成待办、QUEUED 已提交写入等亚马逊确认（writeRunId 关联）、APPLIED 亚马逊确认后（P3-17）、
// SKIPPED 按设计跳过（超过每日上限、已有未处理的待办等，message 写原因）、FAILED 失败。executed = 是否真的写到了亚马逊。entityKey 是对象的稳定标识
// （活动、投放词用外部编号，搜索词用“活动编号|词”）；workItemId 是生成的待办（不加外键：待办可被清理，记录要留着）。
model AdsAutomationRun {
  id           String            @id @default(cuid())
  tenantId     String
  ruleId       String
  ruleVersion  Int
  entityKey    String
  entityLabel  String?
  actionType   String
  beforeValue  String?
  afterValue   String?
  executed     Boolean           @default(false)
  outcome      String
  message      String?
  workItemId   String?
  evidenceJson Json
  writeRunId   String?
  runAt        DateTime
  createdAt    DateTime          @default(now())
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule         AdsAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, entityKey, runAt], map: "AdsAutomationRun_uq")
  @@index([tenantId, runAt], map: "AdsAutomationRun_tenant_idx")
  @@index([ruleId, runAt], map: "AdsAutomationRun_rule_idx")
  @@index([writeRunId], map: "AdsAutomationRun_write_idx")
}

// 广告实体快照（P3-14，冻结 AdsEntitySnapshot）：worker 定时读已同步的广告实体（活动、广告组、投放对象、关键词、广告组合）的“用户可改的字段”，
// 状态变了才存一行（同一对象的状态哈希没变就不存），用来识别亚马逊侧或其他工具做的外部变更。entityId 是对象的系统编号（不是亚马逊外部编号），
// stateJson 是“字段 → 规整后的文字或空”，hash 是它的 sha256。与冻结的出入：冻结按 adsAccountId 建键，这里按广告档案（档案可能还没有统一接口的账户编号），键里多了 tenantId。
model AdsEntitySnapshot {
  id           String     @id @default(cuid())
  tenantId     String
  adsProfileId String
  entityType   String
  entityId     String
  snapshotAt   DateTime
  stateJson    Json
  hash         String
  createdAt    DateTime   @default(now())
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile   AdsProfile @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, adsProfileId, entityType, entityId, snapshotAt], map: "AdsEntitySnapshot_uq")
  @@index([adsProfileId], map: "AdsEntitySnapshot_profile_idx")
}

// 广告变更记录（P3-14，冻结 AdsChangeLog）：一行 = 一个对象的一个字段改了一次。actorKind：MANUAL 手动（本系统里的人）、AUTO_RULE 自动规则、DAYPARTING 分时策略
// （这三类由 P3-17 的广告写入记录，writeRunId 关联那次写入）、EXTERNAL 外部变更（worker 对比快照识别，operator 不可知）。
// 外部变更的 occurredAt 是“检测到的时间”，sinceAt 是上一次快照的时间（真正的改动发生在这两个时间之间）。changedField 为 __created 表示对象是新出现的（afterValue 放名称）。
// 与冻结的出入：按广告档案建键；多了 entityLabel（当时的名称）、actorId、sinceAt。
model AdsChangeLog {
  id           String     @id @default(cuid())
  tenantId     String
  adsProfileId String
  entityType   String
  entityId     String
  entityLabel  String?
  changedField String
  beforeValue  String?
  afterValue   String?
  actorKind    String
  actorId      String?
  occurredAt   DateTime
  sinceAt      DateTime?
  writeRunId   String?
  createdAt    DateTime   @default(now())
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile   AdsProfile @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, adsProfileId, entityType, entityId, changedField, occurredAt], map: "AdsChangeLog_uq")
  @@index([tenantId, occurredAt], map: "AdsChangeLog_tenant_idx")
  @@index([adsProfileId], map: "AdsChangeLog_profile_idx")
}

// 广告写入记录（P3-17）：一行 = 一次对一个广告对象的写入（手动、自动规则、分时策略共用）。接口服务受理时建（PENDING），后台任务调用亚马逊并回写（SUCCEEDED / FAILED）。
// entityType：被修改的对象类型（CAMPAIGN / AD_GROUP / TARGET；新增类写入是父对象），entityId 是系统编号，externalId 是亚马逊侧的对象编号（调用接口用）。
// requestJson = 本次写入的取值（kind 之外的字段，见 AdsWriteOp）；自动规则与分时策略的来源信息（规则编号、版本、对象键、触发证据等）也放在里面，不含令牌与个人信息。
// 与 AdsChangeLog.writeRunId、AdsAutomationRun.writeRunId 的关系：它们存的是这张表的 id（审计里的 writeRunId 是流程编号，两者不同）。
model AdsWriteRun {
  id           String     @id @default(cuid())
  tenantId     String
  adsProfileId String
  kind         String
  source       String
  entityType   String
  entityId     String
  externalId   String
  entityLabel  String?
  requestJson  Json
  beforeValue  String?
  afterValue   String
  status       String
  failureCode  String?
  syncJobId    String?
  requestId    String?
  requestedBy  String?
  createdAt    DateTime   @default(now())
  finishedAt   DateTime?
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adsProfile   AdsProfile @relation(fields: [adsProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt], map: "AdsWriteRun_tenant_idx")
  @@index([adsProfileId], map: "AdsWriteRun_profile_idx")
  @@index([tenantId, entityId, createdAt], map: "AdsWriteRun_entity_idx")
}

model AdsAdGroup {

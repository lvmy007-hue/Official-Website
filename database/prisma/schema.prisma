model Role {
  id               String             @id @default(cuid())
  tenantId         String?
  name             String
  permissions      Json
  resourceScope    Json
  system           Boolean            @default(false)
  version          Int                @default(2)
  // P5-08：自定义角色的用途说明
  description      String?
  tenant           Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships      Membership[]
  fieldPermissions FieldPermission[]
  invitations      MemberInvitation[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // 预设角色（tenantId 为空且 system 为真）由数据库触发器保护，不可修改、不可删除。
  // system 即“预设角色不可删”的标记，version 即权限版本号（每次改动权限时加一，用于使缓存失效）。
  @@unique([tenantId, name])
}

// 字段级敏感权限（成本、利润、买家信息）：显式允许或拒绝，拒绝优先于旧权限映射产生的字段权限。
model FieldPermission {
  id        String  @id @default(cuid())
  roleId    String
  fieldKey  String
  allowed   Boolean
  // P5-08：仅负责人可见（allowed 为真时才有意义）
  ownerOnly Boolean @default(false)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, fieldKey])
}

// 成员邀请（P1-19 使用）：只保存令牌哈希，72 小时有效，只能使用一次。
model MemberInvitation {
  id            String    @id @default(cuid())
  tenantId      String
  email         String
  roleId        String
  scopeSnapshot Json
  status        String    @default("PENDING")
  tokenHash     String    @unique
  expiresAt     DateTime
  invitedBy     String
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([tenantId, email, status])
  @@index([roleId])
}

model Membership {
  id             String            @id @default(cuid())
  userId         String
  tenantId       String
  roleId         String
  status         String            @default("ACTIVE")
  // P5-08：停用信息（状态只允许 ACTIVE、DISABLED）
  disabledAt     DateTime?
  disabledReason String?
  disabledBy     String?
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role           Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopes         MembershipScope[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([roleId])
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  refreshTokenHash  String
  userAgent         String?
  ipHash            String?
  expiresAt         DateTime
  revokedAt         DateTime?
  lastSeenAt        DateTime  @default(now())
  // 刷新凭据轮换（P1-17）：每次刷新签发一个新会话行，旧行作废；同一次登录产生的所有行共享 rotationChainId。
  rotationChainId   String
  rotatedFromId     String?
  // 旧凭据在宽限期之外再次出现时记录检测时间，并吊销整条轮换链
  reuseDetectedAt   DateTime?
  deviceFingerprint String?
  // 展示用的脱敏地址（例如 203.0.113.*），原始地址不落库，只存 ipHash
  ipMasked          String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([rotationChainId])
  @@index([rotatedFromId])
}

// 多因素认证因子（P1-17）：每个用户最多一个动态验证码因子和一组恢复码；密文由应用层加密保存。
model MfaFactor {
  id               String    @id @default(cuid())
  userId           String
  // TOTP：动态验证码密钥；RECOVERY_CODE：未使用恢复码的哈希列表
  kind             String
  secretCiphertext String
  keyVersion       Int       @default(1)
  // 动态验证码因子：用户输入第一次正确验证码后才算绑定完成
  verifiedAt       DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

// 数据密钥（P1-24）：按用途一把、带版本，被主密钥包裹后存放；平台级数据，不属于任何企业，只允许系统连接访问。
// 密文里记录所用版本；轮换时新版本接手新写入，旧版本退役但仍用于解密。数据库里永远没有明文数据密钥。
model DataEncryptionKey {
  id          String    @id @default(cuid())
  // amazon-token：亚马逊刷新令牌；buyer-pii：买家个人信息；mfa：多因素认证密钥
  purpose     String
  version     Int
  // 被主密钥（环境变量或云密钥管理）包裹后的数据密钥
  wrappedKey  String
  // 包裹它的主密钥编号，主密钥轮换后据此判断是否需要重新包裹
  masterKeyId String
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  retiredAt   DateTime?

  @@unique([purpose, version])
}

// 平台运营账号（M-P1-19）：与租户成员完全分离，强制多因素认证；只允许系统连接访问。
// role：PLATFORM_OWNER 平台所有者、PLATFORM_OPS 平台运营、PLATFORM_SUPPORT 平台支持；status：ACTIVE、DISABLED。
// tokenValidAfter：此时间之前签发的访问令牌一律失效（注销与停用账号时更新）。
model PlatformAdmin {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                String
  status              String    @default("ACTIVE")
  mfaRequired         Boolean   @default(true)
  mfaSecretCiphertext String?
  mfaKeyVersion       Int?
  mfaVerifiedAt       DateTime?
  mfaLastStep         Int?
  tokenValidAfter     DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// 企业开通邀请（M-P1-19）：只存令牌哈希，72 小时有效，只能使用一次；系统连接专用。
// status：PENDING、ACCEPTED、EXPIRED、REVOKED。
model TenantInvitation {
  id                       String    @id @default(cuid())
  tenantId                 String
  email                    String
  tokenHash                String    @unique
  status                   String    @default("PENDING")
  expiresAt                DateTime
  createdByPlatformAdminId String
  acceptedAt               DateTime?
  createdAt                DateTime  @default(now())
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// 初始化向导进度（M-P1-19）：每个企业一行。step：当前所在步骤；stepStateJson：各步骤保存的内容与完成情况。
model TenantOnboarding {
  id            String    @id @default(cuid())
  tenantId      String    @unique
  step          String    @default("PROFILE")
  stepStateJson Json
  version       Int       @default(1)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// 生命周期事件（M-P1-19）：状态每变化一次记一行；租户只读。detailJson 放注销流程的结果与删除证明。
model TenantLifecycleEvent {
  id                   String   @id @default(cuid())
  tenantId             String
  fromStatus           String
  toStatus             String
  reason               String
  actorPlatformAdminId String?
  detailJson           Json?
  createdAt            DateTime @default(now())
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// 配额（M-P1-19）：由平台按报价设置，租户只读。quotaKey：stores 店铺数、members 成员数、backfillDays 历史回补天数。
// usedValue 只在平台查看用量时刷新，实际占用以实时统计为准。
model TenantQuota {
  id         String    @id @default(cuid())
  tenantId   String
  quotaKey   String
  limitValue Int
  usedValue  Int       @default(0)
  resetAt    DateTime?
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, quotaKey])
}

// 限时支持访问授权（M-P1-19）：企业所有者先授权（grantedByUserId），平台支持人员领取后（platformAdminId、claimedAt）才能以只读方式进入；
// 到期、撤销或领取者被停用后立即失效。授权期限不超过 7 天。
model PlatformSupportAccess {
  id              String    @id @default(cuid())
  tenantId        String
  platformAdminId String?
  grantedByUserId String
  reason          String
  startsAt        DateTime
  expiresAt       DateTime
  revokedAt       DateTime?
  claimedAt       DateTime?
  scope           String    @default("READ_ONLY")
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresAt])
}

model LegalEntity {
  id                String            @id @default(cuid())
  tenantId          String
  name              String
  registeredCountry String
  registrationNo    String?
  status            String            @default("ACTIVE")
  // P5-07：乐观锁版本号，只由 PATCH /entities/:id 推进
  version           Int               @default(1)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccounts    SellerAccount[]
  oauthStates       OAuthState[]
  membershipScopes  MembershipScope[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([tenantId, name])
}

// 成员的数据范围（P1-12）：一行表示授予一个范围。
//   两列都为空 = 该租户下全部主体与店铺；只有主体 = 该主体下全部店铺；有店铺 = 指定店铺。
// 没有任何记录的成员没有任何数据访问权（宁可拒绝，不默认放开）。
model MembershipScope {
  id              String         @id @default(cuid())
  tenantId        String
  membershipId    String
  legalEntityId   String?
  sellerAccountId String?
  grantedBy       String
  note            String?
  createdAt       DateTime       @default(now())
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership      Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  legalEntity     LegalEntity?   @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount? @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([membershipId, legalEntityId, sellerAccountId])
  @@index([tenantId, membershipId])
  @@index([legalEntityId])
  @@index([sellerAccountId])
}


// P4-05 促销与优惠券（04 章 4.8，importers.md I-17）：亚马逊 Promotions API v2025-12-01 的只读同步（接口只有三个查询操作，没有创建、修改、取消，所以本系统不写入）。
// 一行 = 一个店铺的一个促销（类型 DEAL 秒杀 / COUPON 优惠券 / PRICE_DISCOUNT 价格折扣 / BASKET_BUILDING 满减）。promotionId 是亚马逊的促销编号，同店铺唯一。
// mappingId 来自接口的 trackingId，与促销绩效报告（R-40）和优惠券绩效报告（R-41）里的编号按“映射编号”关联；该对应关系是依据官方文档的假设，尚未用真实报告核对（见 CR-080）。
// startAt 不为空：接口没给开始时间的促销用创建时间代替（再没有就用更新时间），列表按它排序。
// itemCount 为空 = 尚未取得商品清单（不是 0）；itemsTruncated = 商品太多，只同步了前若干条。CATALOG 类型（全店商品）亚马逊不提供商品清单，selectionType 记为 CATALOG、itemCount 为空。
// benefitJson / feeJson 是接口返回的折扣力度与费用预览的原样子集；issuesJson 是促销级的错误与警告（code、message、severity）。
model Promotion {
  id                String          @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  promotionId       String
  marketplaceId     String          @default("ATVPDKIKX0DER")
  promotionType     String
  couponType        String?
  title             String
  status            String
  revisionStatus    String?
  startAt           DateTime
  endAt             DateTime?
  amazonCreatedAt   DateTime?
  amazonUpdatedAt   DateTime
  mappingId         String?
  budgetType        String?
  budgetValue       Decimal?        @db.Decimal(20, 6)
  budgetCurrency    String?
  benefitJson       Json?
  feeJson           Json?
  selectionType     String?
  selectionId       String?
  selectionRevision Int?
  itemCount         Int?
  itemsForUpdatedAt DateTime?
  itemsTruncated    Boolean         @default(false)
  issuesJson        Json            @default("[]")
  errorCount        Int             @default(0)
  warningCount      Int             @default(0)
  syncedAt          DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount   @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  items             PromotionItem[]

  @@unique([sellerAccountId, promotionId], map: "Promotion_uq")
  @@index([tenantId, startAt], map: "Promotion_start_idx")
  @@index([tenantId, status], map: "Promotion_status_idx")
  @@index([tenantId, sellerAccountId, mappingId], map: "Promotion_mapping_idx")
}

// P4-05：促销的商品清单（只有 ITEMS 类型有）。benefitType：FIXED_PRICE 固定价 / DISCOUNTED_PRICE 折扣价；discountType：PERCENTAGE_OFF / AMOUNT_OFF / FREE_ITEM。
// sku 为空串 = 亚马逊只给了 ASIN。每次重新取清单时先删后写，所以没有“上次的残留”。
model PromotionItem {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  promotionRowId  String
  asin            String        @default("")
  sku             String        @default("")
  benefitType     String?
  discountType    String?
  percentOff      Decimal?      @db.Decimal(12, 6)
  amountOff       Decimal?      @db.Decimal(20, 6)
  fixedPrice      Decimal?      @db.Decimal(20, 6)
  currency        String?
  perCustomerUses Int?
  budgetType      String?
  budgetValue     Decimal?      @db.Decimal(20, 6)
  issuesJson      Json          @default("[]")
  syncedAt        DateTime      @default(now())
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  promotion       Promotion     @relation(fields: [promotionRowId], references: [id], onDelete: Cascade)

  @@unique([promotionRowId, asin, sku], map: "PromotionItem_uq")
  @@index([sellerAccountId], map: "PromotionItem_store_idx")
  @@index([tenantId, sellerAccountId, asin], map: "PromotionItem_asin_idx")
}

// P4-05：促销绩效报告（R-40 GET_PROMOTION_PERFORMANCE_REPORT）按 映射编号 × ASIN × 日 的明细。列名与粒度依据文档整理、尚未用真实报告核对（CR-080）。
// units / sales / redemptions 为空 = 报告没给这一列（不是 0）。重复导入按唯一键覆盖。
model PromotionMetric {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  mappingId         String
  asin              String        @default("")
  metricDate        DateTime      @db.Date
  units             Int?
  sales             Decimal?      @db.Decimal(20, 6)
  redemptions       Int?
  currency          String        @default("USD")
  sourceReportJobId String?
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, mappingId, asin, metricDate], map: "PromotionMetric_uq")
  @@index([tenantId, sellerAccountId, metricDate], map: "PromotionMetric_date_idx")
  @@index([sellerAccountId], map: "PromotionMetric_store_idx")
}

// P4-05：优惠券绩效报告（R-41 GET_COUPON_PERFORMANCE_REPORT）按 映射编号 × 日 的明细。clips 领取次数、redemptions 使用次数、budgetSpent 已用预算、sales 销售额；为空 = 报告没给。
model CouponMetric {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  mappingId         String
  metricDate        DateTime      @db.Date
  clips             Int?
  redemptions       Int?
  budgetSpent       Decimal?      @db.Decimal(20, 6)
  sales             Decimal?      @db.Decimal(20, 6)
  currency          String        @default("USD")
  sourceReportJobId String?
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, mappingId, metricDate], map: "CouponMetric_uq")
  @@index([tenantId, sellerAccountId, metricDate], map: "CouponMetric_date_idx")
  @@index([sellerAccountId], map: "CouponMetric_store_idx")
}

// P4-10：刊登当前状态（刊登接口 I-10 每日同步，一个 店铺 × SKU 一行，不是冻结里的“每日快照”）。status：ACTIVE（亚马逊状态含 BUYABLE）/ INACTIVE（其余）；
// statusSince 是本系统观察到这个状态的起点（状态变化时重置）；amazonStatuses 是亚马逊状态原文（可能为空数组）。itemName、mainImageUrl 用来发现他人修改。
model ListingSnapshot {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  marketplaceId   String        @default("ATVPDKIKX0DER")
  sellerSku       String
  asin            String        @default("")
  productType     String?
  conditionType   String?
  status          String
  amazonStatuses  String[]      @default([])
  statusSince     DateTime
  itemName        String?
  mainImageUrl    String?
  syncedAt        DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, marketplaceId, sellerSku], map: "ListingSnapshot_uq")
  @@index([tenantId, status, statusSince], map: "ListingSnapshot_status_idx")
  @@index([sellerAccountId], map: "ListingSnapshot_store_idx")
}

// P4-10：刊登问题（I-10 问题项、R-32 被搜索抑制、推送 N-09）。issueKind：ISSUE 刊登问题 / SEARCH_SUPPRESSED 搜索抑制 / COMPLIANCE 合规；severity 只存 ERROR、WARNING；
// impact：NONE / SEARCH_SUPPRESSED / ATTRIBUTE_SUPPRESSED / LISTING_SUPPRESSED（取自亚马逊的执法动作）；category：亚马逊的问题类别（MISSING_ATTRIBUTE、INVALID_ATTRIBUTE 或空）。
// 问题在后续同步里消失就写 resolvedAt（解决时间是同步发现的时间）；再次出现则清空 resolvedAt 并把 firstSeenAt 重置为现在。handlingStatus：OPEN / IN_PROGRESS（本系统已提交修复）。
model ListingIssue {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  sellerSku       String
  asin            String        @default("")
  issueKind       String
  issueCode       String
  attributeName   String        @default("")
  category        String        @default("")
  severity        String
  impact          String        @default("NONE")
  message         String
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  resolvedAt      DateTime?
  handlingStatus  String        @default("OPEN")
  handlingRunId   String?
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, sellerSku, issueKind, issueCode, attributeName], map: "ListingIssue_uq")
  @@index([tenantId, resolvedAt, firstSeenAt], map: "ListingIssue_open_idx")
  @@index([tenantId, sellerAccountId, sellerSku], map: "ListingIssue_sku_idx")
  @@index([sellerAccountId], map: "ListingIssue_store_idx")
}

// P4-10：刊登变更事件。changeKind：PRODUCT_TYPE_CHANGE / CONTENT_CHANGE；actorKind：SELF 本系统 / AMAZON / OTHER / UNKNOWN（同步比对发现、没有本系统写入能解释的变化记 UNKNOWN）。
// fieldPath：内容字段（item_name、main_image），商品类型变更为空串。sourceRef 保证同一次发现不重复写入（同步按日期，推送按事件编号）。
model ListingChangeEvent {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  sellerSku       String        @default("")
  asin            String        @default("")
  changeKind      String
  fieldPath       String        @default("")
  beforeText      String?
  afterText       String?
  actorKind       String
  occurredAt      DateTime
  writeRunId      String?
  sourceRef       String        @default("")
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, sellerSku, changeKind, fieldPath, sourceRef], map: "ListingChangeEvent_uq")
  @@index([tenantId, changeKind, occurredAt], map: "ListingChangeEvent_time_idx")
  @@index([sellerAccountId, occurredAt], map: "ListingChangeEvent_store_time_idx")
  @@index([sellerAccountId], map: "ListingChangeEvent_store_idx")
}

// P4-10：刊登写入与查询任务记录。kind：VALIDATE 校验预览 / PATCH 修改刊登 / BATCH 批量刊登任务（Feeds API）/ RESTRICTIONS 刊登限制查询（结果带 expiresAt，1 小时后页面不再显示）。
// status：PENDING / RUNNING / SUBMITTED（批量文件已提交）/ PROCESSING（亚马逊处理中）/ SUCCEEDED / PARTIAL / FAILED。requestJson 只含修改项与 SKU（不含令牌与个人信息）；
// issuesJson 是校验预览或提交返回的问题，resultJson 是批量任务逐行结果或限制查询结果。requestHash 用来核对“提交的修改与校验过的一致”。
model ListingWriteRun {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  kind            String
  sellerSku       String?
  productType     String?
  requestJson     Json
  requestHash     String        @default("")
  previewRunId    String?
  status          String        @default("PENDING")
  validation      String?
  issuesJson      Json          @default("[]")
  resultJson      Json?
  feedId          String?
  feedDocumentId  String?
  pollCount       Int           @default(0)
  itemCount       Int           @default(0)
  failureCode     String?
  requestedBy     String?
  requestId       String        @default("")
  syncJobId       String?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  finishedAt      DateTime?
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, createdAt], map: "ListingWriteRun_kind_idx")
  @@index([tenantId, sellerAccountId, sellerSku, status], map: "ListingWriteRun_sku_idx")
  @@index([sellerAccountId], map: "ListingWriteRun_store_idx")
}

// P4-11：我方价格快照（刊登接口报价）。只在价格变化或距上一条超过 24 小时（心跳）时写入，不是每次同步一条。source：LISTING_API 同步 / WRITE_SUBMITTED 改价提交成功（下一次同步以接口为准）。
model PriceSnapshot {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  marketplaceId   String        @default("ATVPDKIKX0DER")
  sellerSku       String
  asin            String        @default("")
  price           Decimal       @db.Decimal(20, 6)
  currency        String        @default("USD")
  source          String
  observedAt      DateTime
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, marketplaceId, sellerSku, observedAt], map: "PriceSnapshot_uq")
  @@index([tenantId, sellerAccountId, sellerSku, observedAt], map: "PriceSnapshot_sku_idx")
  @@index([sellerAccountId], map: "PriceSnapshot_store_idx")
}

// P4-11：推荐报价预期价格（getFeaturedOfferExpectedPriceBatch，按 SKU）。resultStatus 是亚马逊原值；expectedPrice 为空表示接口没给（例如没有竞争报价、不具备资格）。同样只在变化或心跳时写入。
model FeaturedOfferExpectedPrice {
  id                   String        @id @default(cuid())
  tenantId             String
  sellerAccountId      String
  marketplaceId        String        @default("ATVPDKIKX0DER")
  sellerSku            String
  asin                 String        @default("")
  expectedPrice        Decimal?      @db.Decimal(20, 6)
  currentFeaturedPrice Decimal?      @db.Decimal(20, 6)
  currency             String        @default("USD")
  resultStatus         String
  observedAt           DateTime
  createdAt            DateTime      @default(now())
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount        SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, marketplaceId, sellerSku, observedAt], map: "FeaturedOfferExpectedPrice_uq")
  @@index([tenantId, sellerAccountId, sellerSku, observedAt], map: "FeaturedOfferExpectedPrice_sku_idx")
  @@index([sellerAccountId], map: "FeaturedOfferExpectedPrice_store_idx")
}

// P4-11：竞争摘要（getCompetitiveSummary，按 ASIN）：推荐报价的价格与履约、我方是不是获得方、会员与非会员的浏览权重、参考价与最低报价。featuredOfferJson 存推荐购买选项的精简内容。
model CompetitiveSummarySnapshot {
  id                  String        @id @default(cuid())
  tenantId            String
  sellerAccountId     String
  marketplaceId       String        @default("ATVPDKIKX0DER")
  asin                String
  featuredPrice       Decimal?      @db.Decimal(20, 6)
  featuredFulfillment String?
  featuredIsOwn       Boolean?
  viewWeightMember    Decimal?      @db.Decimal(12, 6)
  viewWeightNonMember Decimal?      @db.Decimal(12, 6)
  referencePrice      Decimal?      @db.Decimal(20, 6)
  referencePriceType  String?
  lowestPrice         Decimal?      @db.Decimal(20, 6)
  currency            String        @default("USD")
  featuredOfferJson   Json          @default("{}")
  observedAt          DateTime
  createdAt           DateTime      @default(now())
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount       SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, marketplaceId, asin, observedAt], map: "CompetitiveSummarySnapshot_uq")
  @@index([tenantId, sellerAccountId, asin, observedAt], map: "CompetitiveSummarySnapshot_asin_idx")
  @@index([sellerAccountId], map: "CompetitiveSummarySnapshot_store_idx")
}

// P4-11：竞争报价（竞争摘要里最低价的几个报价与推荐报价）。offerKey 是卖家编号的哈希（不存别家卖家编号原文）；isOwn 是我方；同一时刻最多保留最低的 30 个。
model CompetitiveOffer {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  marketplaceId   String        @default("ATVPDKIKX0DER")
  asin            String
  offerKey        String
  isOwn           Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  price           Decimal       @db.Decimal(20, 6)
  shipping        Decimal?      @db.Decimal(20, 6)
  condition       String        @default("")
  fulfillment     String        @default("")
  observedAt      DateTime
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, marketplaceId, asin, offerKey, observedAt], map: "CompetitiveOffer_uq")
  @@index([tenantId, sellerAccountId, asin, observedAt], map: "CompetitiveOffer_asin_idx")
  @@index([sellerAccountId], map: "CompetitiveOffer_store_idx")
}

// P4-11：推荐报价（购物车）观察。source：SYNC 同步 / PUSH_ANY_OFFER / PUSH_PRICING_HEALTH（推送接收端暂缓，处理器已注册）。lostReason：PRICE（因价格失去资格，来自价格健康通知）。
model BuyBoxSnapshot {
  id               String        @id @default(cuid())
  tenantId         String
  sellerAccountId  String
  marketplaceId    String        @default("ATVPDKIKX0DER")
  asin             String
  sellerSku        String        @default("")
  hasFeaturedOffer Boolean
  ownIsFeatured    Boolean?
  featuredPrice    Decimal?      @db.Decimal(20, 6)
  lostReason       String?
  source           String
  observedAt       DateTime
  createdAt        DateTime      @default(now())
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount    SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, marketplaceId, asin, sellerSku, source, observedAt], map: "BuyBoxSnapshot_uq")
  @@index([tenantId, sellerAccountId, asin, observedAt], map: "BuyBoxSnapshot_asin_idx")
  @@index([sellerAccountId], map: "BuyBoxSnapshot_store_idx")
}

// P4-11：价格护栏。scope：STORE / CATEGORY / ASIN / SKU；STORE 的 scopeRef 为空串。同一字段多层护栏时取最具体的一层里有值的那个。version 乐观锁。
model PriceGuardrail {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  scope           String
  scopeRef        String        @default("")
  minPrice        Decimal?      @db.Decimal(20, 6)
  maxPrice        Decimal?      @db.Decimal(20, 6)
  minMarginPct    Decimal?      @db.Decimal(12, 6)
  maxChangePct    Decimal?      @db.Decimal(12, 6)
  enabled         Boolean       @default(true)
  version         Int           @default(1)
  updatedBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, scope, scopeRef], map: "PriceGuardrail_uq")
  @@index([sellerAccountId], map: "PriceGuardrail_store_idx")
}

// P4-11：定价规则。mode：MANUAL 只生成建议 / AUTO 自动执行（需要开关 sw.pricing.rule.auto 与 sw.pricing.update）；strategy：FOLLOW_EXPECTED / TARGET_MARGIN / MATCH_LOWEST；
// status：ACTIVE / PAUSED / BREAKER（熔断暂停，breakerReason 写原因）。maxChangePct 单次调幅上限、dailyLimit 每个 SKU 每天最多几次；breaker* 是熔断阈值（冻结模型里没有这几列，规则的保护要能查询与编辑）。
model PricingRule {
  id                    String           @id @default(cuid())
  tenantId              String
  sellerAccountId       String
  name                  String
  mode                  String
  strategy              String
  paramsJson            Json             @default("{}")
  targetScopeJson       Json             @default("{}")
  scenarioMatrix        Json?
  status                String           @default("PAUSED")
  maxChangePct          Decimal          @default(0.05) @db.Decimal(12, 6)
  dailyLimit            Int              @default(1)
  breakerFailures       Int              @default(3)
  breakerConversionDrop Decimal?         @db.Decimal(12, 6)
  breakerMinMargin      Decimal?         @db.Decimal(12, 6)
  breakerReason         String?
  breakerAt             DateTime?
  lastEvaluatedAt       DateTime?
  version               Int              @default(1)
  createdBy             String
  updatedBy             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount         SellerAccount    @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  runs                  PricingRuleRun[]

  @@unique([tenantId, sellerAccountId, name], map: "PricingRule_uq")
  @@index([tenantId, status], map: "PricingRule_status_idx")
  @@index([sellerAccountId], map: "PricingRule_store_idx")
}

// P4-11：定价规则的执行记录（手动规则生成建议、自动规则执行或被拦截）。outcome：SUGGESTED 待确认 / QUEUED 已提交 / APPLIED 已执行 / FAILED / BLOCKED 被护栏拦截 / SKIPPED / DISMISSED 已忽略。
// currentPrice 是评估时的当前价，rawPrice 是策略算出的价，suggestedPrice 是收窄调幅后的价；guardrailResult 是护栏结论代码；executed 为真表示已被亚马逊确认；writeRunId 指向 ListingWriteRun（PRICE_PATCH）。
model PricingRuleRun {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  ruleId          String
  ruleVersion     Int           @default(1)
  sku             String
  asin            String        @default("")
  currentPrice    Decimal?      @db.Decimal(20, 6)
  rawPrice        Decimal?      @db.Decimal(20, 6)
  suggestedPrice  Decimal?      @db.Decimal(20, 6)
  guardrailResult String
  outcome         String
  message         String?
  executed        Boolean       @default(false)
  writeRunId      String?
  workItemId      String?
  runAt           DateTime
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  rule            PricingRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, sku, runAt], map: "PricingRuleRun_uq")
  @@index([tenantId, outcome, runAt], map: "PricingRuleRun_outcome_idx")
  @@index([tenantId, sellerAccountId, sku, runAt], map: "PricingRuleRun_sku_idx")
  @@index([sellerAccountId], map: "PricingRuleRun_store_idx")
  @@index([ruleId], map: "PricingRuleRun_rule_idx")
}

// P6-17：跟卖监控——我方 Listing（店铺 × SKU）上出现过的其他报价方。数据只来自官方竞争摘要（定价同步器每次读到摘要就刷新），不抓前台。
// sellerId 是对方卖家编号的哈希（与 CompetitiveOffer.offerKey 同一算法，不存别家卖家编号原文）；firstSeenAt 是这次出现的时间（消失后重新出现会重置）；
// lastSeenAt 是最近一次在摘要里看到；goneAt 不为空表示最近一次摘要里已经没有这个报价方（消失；报价只记价格最低的 30 个，排到 30 名之外也算消失）。
model OfferCompetitor {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  sku             String
  asin            String        @default("")
  sellerId        String
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  goneAt          DateTime?
  price           Decimal       @db.Decimal(20, 6)
  currency        String        @default("USD")
  isFba           Boolean       @default(false)
  hasBuybox       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, sku, sellerId])
  @@index([tenantId, sellerAccountId, goneAt, firstSeenAt], map: "OfferCompetitor_active_idx")
  @@index([tenantId, sellerId], map: "OfferCompetitor_seller_idx")
  @@index([sellerAccountId], map: "OfferCompetitor_store_idx")
}

// P6-17：跟卖白名单（企业级）。白名单里的卖家（例如自己的其他店铺）出现在我方 Listing 上不算跟卖，列表默认不显示、预警不计入。
// sellerId 是卖家编号的哈希（与 OfferCompetitor.sellerId 同一算法）；sellerHint 是录入时留下的前两位与后两位，方便人认出是哪一个，不是原文。
model HijackWhitelist {
  id         String   @id @default(cuid())
  tenantId   String
  sellerId   String
  sellerHint String   @default("")
  note       String?
  createdBy  String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerId])
}

// P6-18：利润项目字典（三层：原始交易类型 → 二级项目 → 一级项目；最多三级）。level 1 是一级项目，group 与 sign 在一级项目上选定，子项目沿用 group。
// isSystem 的项目不能删除、只能改名；systemKey 是系统项目对应的利润桥项目（BridgeKey）或 'EXCLUDED'（代收代缴税，不计入利润），自定义项目为空。
// 自定义项目计入利润时沿用最近一个带 systemKey 的祖先的口径（没有就按 group 的默认口径），所以改映射不会让利润日表各列与净利润对不上。
model ProfitItem {
  id              String              @id @default(cuid())
  tenantId        String
  parentId        String?
  level           Int
  name            String
  group           String
  sign            Int
  isSystem        Boolean             @default(false)
  systemKey       String?
  sort            Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          ProfitItem?         @relation("ProfitItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        ProfitItem[]        @relation("ProfitItemTree")
  mappings        ProfitItemMapping[]
  allocationRules AllocationRule[]
  estimatedFees   EstimatedFee[]

  @@unique([tenantId, parentId, name], map: "ProfitItem_name_uq")
  @@unique([tenantId, systemKey], map: "ProfitItem_systemKey_uq")
  @@index([tenantId, parentId, sort], map: "ProfitItem_tree_idx")
  @@index([parentId], map: "ProfitItem_parent_idx")
}

// P6-18：交易类型到项目的映射。transactionType 是“费用分类/子类型”（例如 COMMISSION/ReferralFee、NON_FEE/Principal；没有子类型时只有分类）。
// 没有映射的交易类型仍按默认口径计入利润日表（不丢），同时在“未映射”里单独列出提醒补全。
model ProfitItemMapping {
  id              String     @id @default(cuid())
  tenantId        String
  transactionType String
  itemId          String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item            ProfitItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, transactionType], map: "ProfitItemMapping_uq")
  @@index([itemId], map: "ProfitItemMapping_item_idx")
}

// P6-19：店铺级费用分摊规则。一行 = 某费用项（ProfitItem）从 effectiveMonth（当月第一天）起的分摊依据；同一费用项取 effectiveMonth 不晚于所算月份的最近一条。
// basis：SALES_AMOUNT / SALES_UNITS / SHIPMENT_RECEIVED_UNITS / REMOVAL_ORDER_SKU / MANUAL；manualWeights 只在 MANUAL 时有值（{ sku: 权重 }）。version 是乐观锁。
model AllocationRule {
  id             String     @id @default(cuid())
  tenantId       String
  feeItemId      String
  basis          String
  manualWeights  Json?
  effectiveMonth DateTime   @db.Date
  version        Int        @default(1)
  createdBy      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeItem        ProfitItem @relation(fields: [feeItemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feeItemId, effectiveMonth], map: "AllocationRule_uq")
  @@index([feeItemId], map: "AllocationRule_item_idx")
}

// P6-20：预估与自定义费用。一行 = 某费用项（ProfitItem）在某范围（店铺、SKU、品类）从 from 到 to（含，空 = 一直有效）的预估口径。
// scopeType：STORE（scopeId 是店铺编号）/ SKU（卖家 SKU）/ CATEGORY（商品类型或类目路径）；mode：FIXED（固定金额 value，币种 currency，按 period 的日或月）
// / PERCENT_OF_SALES（销售额比例 value，单位 %）；status：ACTIVE / INACTIVE；version 是乐观锁。利润日表重算时按规则生成估算金额计入利润，实际费用出账后自动冲销。
model EstimatedFee {
  id        String     @id @default(cuid())
  tenantId  String
  itemId    String
  scopeType String
  scopeId   String
  mode      String
  value     Decimal    @db.Decimal(20, 6)
  currency  String     @default("USD")
  period    String
  from      DateTime   @db.Date
  to        DateTime?  @db.Date
  status    String     @default("ACTIVE")
  note      String?
  version   Int        @default(1)
  createdBy String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      ProfitItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, scopeType, scopeId, from], map: "EstimatedFee_scope_idx")
  @@index([itemId], map: "EstimatedFee_item_idx")
}

// P6-18：口径版本（P6-31 接入利润公式、业务口径、分摊规则；本包先建表并让利润项目字典使用 PROFIT_DICTIONARY）。
// versionNo 是版本号（不叫 version：version 是乐观锁列）；每家企业每种 kind 同一时刻至多一个 ACTIVE（部分唯一索引，见迁移）。
// config 存该版本的完整快照；字典的 config 是 { items, mappings }。
model MetricVersion {
  id            String    @id @default(cuid())
  tenantId      String
  kind          String
  versionNo     Int
  config        Json
  status        String    @default("ACTIVE")
  effectiveFrom DateTime?
  approvedBy    String?
  createdBy     String?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, versionNo], map: "MetricVersion_uq")
  @@index([tenantId, kind, status], map: "MetricVersion_status_idx")
}

// P4-12：竞品监控的关注清单。一行 = 某个店铺为我方某个 ASIN（可为空串，表示没有指定对应商品）关注的一个竞品 ASIN。
// reason：SEARCH_TERM（来自热门搜索词点击前三的商品，note 记搜索词）/ MANUAL（手工添加）。官方接口没有“竞争摘要里的其他 ASIN”，所以没有 COMPETITIVE_SUMMARY 来源（见 CR-087）。
model WatchedAsin {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  marketplaceId   String        @default("ATVPDKIKX0DER")
  asin            String
  ownAsin         String        @default("")
  reason          String
  note            String?
  addedBy         String?
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, asin, ownAsin], map: "WatchedAsin_uq")
  @@index([tenantId, sellerAccountId, asin], map: "WatchedAsin_asin_idx")
  @@index([sellerAccountId], map: "WatchedAsin_store_idx")
}

// P4-12：竞品快照（商品目录接口 + 竞争摘要接口，只用官方接口）。只在可见属性变化、或距上一条超过 24 小时（心跳）时才写；字段为空表示这次没取到（不是 0，也不是“没有”）。
// featuredStatus：HAS_FEATURED（这个 ASIN 现在有推荐报价）/ NONE（没有推荐报价）；memberEligible：推荐报价是否对会员展示；rank 取展示组排名（没有就取第一个分类排名），分类放在 rankClassification*。
model CompetitorSnapshot {
  id                     String        @id @default(cuid())
  tenantId               String
  sellerAccountId        String
  marketplaceId          String        @default("ATVPDKIKX0DER")
  asin                   String
  title                  String?
  brand                  String?
  imageCount             Int?
  price                  Decimal?      @db.Decimal(20, 6)
  currency               String        @default("USD")
  featuredStatus         String?
  fulfillment            String?
  memberEligible         Boolean?
  rank                   Int?
  rankClassificationId   String?
  rankClassificationName String?
  observedAt             DateTime
  createdAt              DateTime      @default(now())
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount          SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, marketplaceId, asin, observedAt], map: "CompetitorSnapshot_uq")
  @@index([tenantId, sellerAccountId, asin, observedAt], map: "CompetitorSnapshot_asin_idx")
  @@index([sellerAccountId], map: "CompetitorSnapshot_store_idx")
}

// P4-13：评分与评分数的文件导入快照（亚马逊官方没有这两项的接口，来源只有文件导入）。一行 = 某个店铺的某个 ASIN 在某个采集日期的评分；avgRating 与 ratingCount 至少有一个。
// sourceFileId 是导入批次编号，sourceFileName 是导入文件名，importedBy 是导入人；同一 (店铺, ASIN, 采集日期) 再次导入时覆盖。distributionJson 是 1 到 5 星的人数分布（可选，键为 "1" 到 "5"）。
model ReviewMetricSnapshot {
  id               String        @id @default(cuid())
  tenantId         String
  sellerAccountId  String
  asin             String
  avgRating        Decimal?      @db.Decimal(4, 2)
  ratingCount      Int?
  distributionJson Json?
  captureDate      DateTime      @db.Date
  sourceKind       String        @default("FILE_IMPORT")
  sourceFileId     String
  sourceFileName   String        @default("")
  importedBy       String
  createdAt        DateTime      @default(now())
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount    SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, asin, captureDate], map: "ReviewMetricSnapshot_uq")
  @@index([tenantId, sellerAccountId, asin, captureDate], map: "ReviewMetricSnapshot_asin_idx")
  @@index([sellerAccountId], map: "ReviewMetricSnapshot_store_idx")
}

// P4-13：商品评论主题（客户反馈接口 I-15，前 10 正面、前 10 负面）。sentiment：POSITIVE / NEGATIVE；rank 是该情感下的名次（1 到 10）；mentionRange、reviewCountBucket 原样存接口给的区间文字（没给就为空，不估算）。
model ReviewTopic {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  asin              String
  browseNodeId      String?
  browseNodeName    String?
  topicKey          String
  sentiment         String
  rank              Int
  mentionRange      String?
  reviewCountBucket String?
  snapshotDate      DateTime      @db.Date
  createdAt         DateTime      @default(now())
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, asin, topicKey, snapshotDate], map: "ReviewTopic_uq")
  @@index([tenantId, sellerAccountId, asin, snapshotDate], map: "ReviewTopic_asin_idx")
  @@index([sellerAccountId], map: "ReviewTopic_store_idx")
}

// P4-13：类目（浏览节点）评论主题的月度占比趋势（I-15）。scope：ALL（类目全部商品）/ TOP25（类目前 25% 商品）；rate 是 0 到 1 的小数。
model BrowseNodeReviewTrend {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  browseNodeId    String
  browseNodeName  String?
  scope           String
  month           DateTime      @db.Date
  topicKey        String
  sentiment       String
  rate            Decimal       @db.Decimal(10, 6)
  syncedAt        DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, browseNodeId, scope, month, topicKey], map: "BrowseNodeReviewTrend_uq")
  @@index([tenantId, sellerAccountId, browseNodeId, month], map: "BrowseNodeReviewTrend_node_idx")
  @@index([sellerAccountId], map: "BrowseNodeReviewTrend_store_idx")
}

// P4-13：类目退货主题的月度占比趋势（I-15，只到类目级，没有商品级退货主题）。rate 是 0 到 1 的小数。
model BrowseNodeReturnTrend {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  browseNodeId    String
  browseNodeName  String?
  scope           String
  month           DateTime      @db.Date
  returnTopicKey  String
  rate            Decimal       @db.Decimal(10, 6)
  syncedAt        DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, browseNodeId, scope, month, returnTopicKey], map: "BrowseNodeReturnTrend_uq")
  @@index([tenantId, sellerAccountId, browseNodeId, month], map: "BrowseNodeReturnTrend_node_idx")
  @@index([sellerAccountId], map: "BrowseNodeReturnTrend_store_idx")
}

// P4-13：请求评价记录（I-16）。每个店铺的每个订单只有一行（唯一键保证“每单只请求一次”）。
// status：QUEUED 已受理、还没发给亚马逊 / REQUESTED 已请求 / UNAVAILABLE 亚马逊说这单现在不可请求 / WINDOW_CLOSED 超出送达后第 5 至 30 天窗口 / FAILED 发送失败（只有它可以再次受理）。
// asins 是受理时订单里的 ASIN（用来看“请求后评分数增长”）；batchId 是后台任务编号；writeRunId 是写操作流程编号。
model SolicitationRequest {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  marketplaceId   String        @default("ATVPDKIKX0DER")
  amazonOrderId   String
  asins           String[]      @default([])
  status          String
  requestedAt     DateTime
  sentAt          DateTime?
  requestedBy     String
  writeRunId      String?
  batchId         String?
  failureCode     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([sellerAccountId, amazonOrderId], map: "SolicitationRequest_uq")
  @@index([tenantId, sellerAccountId, status, requestedAt], map: "SolicitationRequest_status_idx")
  @@index([tenantId, batchId], map: "SolicitationRequest_batch_idx")
  @@index([sellerAccountId], map: "SolicitationRequest_store_idx")
}

// P4-14：A+ 内容（I-18）。一条是一个店铺 × 站点 × 内容引用键；本地新建的草稿在亚马逊创建成功之前 contentReferenceKey 为空。
// status：DRAFT 草稿 / SUBMITTED 已提交审核 / APPROVED 已批准 / REJECTED 被拒 / PUBLISHED 已发布（已批准且发布记录里能查到关联 ASIN 的上线时间）；
// draftJson 是 { contentModuleList: [...] }，原样保存亚马逊返回（或我方提交）的模块结构；version 是乐观锁，每次受理写入时加 1；
// rejectionReason 是接口给的拒绝原文，接口没给就是空；amazonUpdatedAt 是接口里的更新时间，publishedAt 是首个 ASIN 的上线时间（来自发布记录）。
model AplusContent {
  id                  String              @id @default(cuid())
  tenantId            String
  sellerAccountId     String
  marketplaceId       String              @default("ATVPDKIKX0DER")
  contentReferenceKey String?
  name                String
  contentType         String              @default("EBC")
  locale              String              @default("en-US")
  status              String              @default("DRAFT")
  asinCount           Int                 @default(0)
  rejectionReason     String?
  draftJson           Json                @default("{}")
  amazonUpdatedAt     DateTime?
  publishedAt         DateTime?
  lastSyncedAt        DateTime?
  version             Int                 @default(1)
  createdBy           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount       SellerAccount       @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  asinRelations       AplusAsinRelation[]
  reviewEvents        AplusReviewEvent[]
  writeRuns           AplusWriteRun[]

  @@unique([sellerAccountId, marketplaceId, contentReferenceKey], map: "AplusContent_uq")
  @@index([tenantId, sellerAccountId, status, updatedAt], map: "AplusContent_status_idx")
  @@index([sellerAccountId], map: "AplusContent_store_idx")
}

// P4-14：A+ 内容与 ASIN 的关联。publishedAt 是发布记录里这个 ASIN 的上线时间（没有记录为空）；lastSeenAt 是最近一次同步看到这条关联的时间。
model AplusAsinRelation {
  id              String        @id @default(cuid())
  tenantId        String
  contentId       String
  sellerAccountId String
  asin            String
  publishedAt     DateTime?
  lastSeenAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  content         AplusContent  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([contentId, asin], map: "AplusAsinRelation_uq")
  @@index([tenantId, sellerAccountId, asin], map: "AplusAsinRelation_asin_idx")
  @@index([sellerAccountId], map: "AplusAsinRelation_store_idx")
}

// P4-14：A+ 审核状态事件（时间线）。status 取 AplusContent.status 的前四个（DRAFT、SUBMITTED、APPROVED、REJECTED）加 PUBLISHED；
// message 是亚马逊给的原文（被拒原因），没有为空；source：SYNC 同步发现 / LOCAL 本系统提交审核时记录。
model AplusReviewEvent {
  id         String       @id @default(cuid())
  tenantId   String
  contentId  String
  status     String
  message    String?
  source     String       @default("SYNC")
  occurredAt DateTime
  createdAt  DateTime     @default(now())
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  content    AplusContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, status, occurredAt], map: "AplusReviewEvent_uq")
  @@index([tenantId, occurredAt], map: "AplusReviewEvent_time_idx")
}

// P4-14：A+ 写入记录（创建、保存修改、关联 ASIN、上传图片、提交审核）。每次受理一条，由后台任务 APLUS_WRITE 调用亚马逊。
// kind：CREATE / UPDATE / ASSOCIATE / UPLOAD / SUBMIT；status：QUEUED 排队中 / RUNNING 处理中 / SUCCEEDED 已完成 / FAILED 失败。
// requestJson 只含这次要提交的内容（模块、ASIN 列表、图片文件的存储路径与尺寸），不含令牌；上传类 contentId 为空，resultJson 里有 uploadDestinationId；
// warningsJson 是亚马逊返回的警告原文（字符串数组）；failureCode 只留“来源 + 状态码”，亚马逊返回的原文不入库。
model AplusWriteRun {
  id              String        @id @default(cuid())
  tenantId        String
  sellerAccountId String
  marketplaceId   String        @default("ATVPDKIKX0DER")
  contentId       String?
  kind            String
  status          String        @default("QUEUED")
  requestJson     Json          @default("{}")
  resultJson      Json?
  warningsJson    Json          @default("[]")
  failureCode     String?
  requestedBy     String?
  requestId       String        @default("")
  syncJobId       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  finishedAt      DateTime?
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  content         AplusContent? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([tenantId, sellerAccountId, kind, createdAt], map: "AplusWriteRun_kind_idx")
  @@index([contentId, status], map: "AplusWriteRun_content_idx")
  @@index([sellerAccountId], map: "AplusWriteRun_store_idx")
}

// 账户健康快照（P5-02，09 章 9.2）：一行 = 某店铺某一天的一个指标（订单缺陷率、账户健康评级、政策投诉数、账户状态……）。
// metricKey 取报告里的指标名（再按配送方式加后缀，如 orderDefectRate.afn）；账户状态与评级用固定键 ACCOUNT_STATUS、ACCOUNT_HEALTH_RATING。
// value / target 按报告原值入库，空表示“报告没给”，页面显示“尚无记录”而不是 0；status 只在报告给了目标时才判定 MET / NOT_MET。
// 账户状态变更历史没有单独建表：同一店铺的 ACCOUNT_STATUS 按日取变化点即可（推送先到的当天以推送为准，见 source）。
model AccountHealthSnapshot {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  marketplaceId     String        @default("ATVPDKIKX0DER")
  snapshotDate      DateTime      @db.Date
  metricKey         String
  metricGroup       String
  accountStatus     String        @default("NORMAL")
  status            String        @default("UNKNOWN")
  value             Decimal?      @db.Decimal(20, 6)
  target            Decimal?      @db.Decimal(20, 6)
  targetCondition   String?
  unit              String?
  windowDays        Int?
  detailJson        Json          @default("{}")
  source            String        @default("REPORT")
  sourceReportJobId String?
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, snapshotDate, metricKey], map: "AccountHealthSnapshot_uq")
  @@index([tenantId, sellerAccountId, metricKey, snapshotDate], map: "AccountHealthSnapshot_metric_idx")
  @@index([sellerAccountId], map: "AccountHealthSnapshot_store_idx")
}

// 政策合规问题（P5-02）：来自账户健康报告里的违规 / 投诉条目，一条一个 issueId；报告里不再出现的条目标记为已解决。
// owner / handlingStatus / handlingNote / amazonCaseId 是人工处理信息，同步不会覆盖；version 做乐观锁。
// affectedAsinsJson 是受影响的 ASIN（字符串数组，最多 50 个）；detailJson 只留报告条目的原始字段，便于日后换口径重新解释。
model PolicyIssue {
  id                String        @id @default(cuid())
  tenantId          String
  sellerAccountId   String
  marketplaceId     String        @default("ATVPDKIKX0DER")
  issueId           String
  kind              String
  title             String
  status            String        @default("OPEN")
  firstSeenAt       DateTime
  lastSeenAt        DateTime
  resolvedAt        DateTime?
  affectedAsinsJson Json          @default("[]")
  impactText        String?
  detailJson        Json          @default("{}")
  ownerUserId       String?
  handlingStatus    String        @default("OPEN")
  handlingNote      String?
  amazonCaseId      String?
  version           Int           @default(1)
  sourceReportJobId String?
  sourceUpdatedAt   DateTime
  syncedAt          DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sellerAccountId, issueId], map: "PolicyIssue_uq")
  @@index([tenantId, status, firstSeenAt], map: "PolicyIssue_status_idx")
  @@index([tenantId, ownerUserId], map: "PolicyIssue_owner_idx")
  @@index([sellerAccountId], map: "PolicyIssue_store_idx")
}

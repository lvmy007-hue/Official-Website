// 按月分区表（分区列 purchaseDate，由手写迁移创建，见 M-P1-27）。主键与全部唯一键都包含分区列。
model Order {
  id                String               @default(cuid())
  tenantId          String
  sellerAccountId   String
  amazonOrderId     String
  marketplaceId     String
  purchaseDate      DateTime
  status            String
  fulfillment       String?
  currency          String
  amount            Decimal?             @db.Decimal(20, 6)
  itemCount         Int?
  sourceUpdatedAt   DateTime
  syncedAt          DateTime             @default(now())
  sourceReportJobId String?
  sourceRecordId    String
  fulfillmentStatus String?
  latestShipDate    DateTime?
  earliestDelivery  DateTime?
  latestDelivery    DateTime?
  cancelledBy       String?
  isReplacement     Boolean              @default(false)
  replacedOrderId   String?
  replacementReason String?
  refundStatus      String?
  piiCiphertext     String?
  shippedAt         DateTime?
  piiExpiresAt      DateTime?
  programs          String[]             @default([])
  salesChannel      String?
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sellerAccount     SellerAccount        @relation(fields: [sellerAccountId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  charges           OrderCharge[]
  packages          OrderPackage[]
  cancellations     OrderCancellation[]
  statusHistory     OrderStatusHistory[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@id([id, purchaseDate])
  @@unique([sellerAccountId, amazonOrderId, purchaseDate])
  @@index([tenantId, purchaseDate])
  @@index([piiExpiresAt])
  @@index([tenantId, replacedOrderId])
}

model SyncJob {
  id              String             @id @default(cuid())
  tenantId        String
  connectionId    String
  type            String
  status          String             @default("PENDING")
  progressCurrent Int                @default(0)
  progressTotal   Int                @default(0)
  attempts        Int                @default(0)
  failureCode     String?
  requestId       String
  context         Json?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime           @default(now())
  // P1-20：数据域、去重来源、优先级（1 用户触发 / 2 推送增量 / 3 定时 / 4 历史回补）、断点与死信标记。
  // 重试次数沿用既有的 attempts（冻结清单另列的 attempt 与它重复，见 CR-013）。
  domain          String             @default("general")
  sourceKey       String?
  priority        Int                @default(3)
  checkpointJson  Json?
  deadLettered    Boolean            @default(false)
  // M-P5-06 同步中心：写入统计（只存数字，没有统计的任务为空，不是 0）与过程时间线（最多 40 条：开始、等待重试、等待报告、完成、失败、取消、重试）。
  resultJson      Json?
  timelineJson    Json?
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection      PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([connectionId])
  @@index([tenantId, domain, status])
  @@index([tenantId, sourceKey])
}

// 流程状态机（12.3）：所有异步流程统一为“状态机 + 持久化步骤记录”。先记录意图，再调用，再记录结果。
// status：RUNNING / SUCCEEDED / FAILED / COMPENSATED / CANCELLED（检查约束保证）。
model WorkflowRun {
  id             String         @id @default(cuid())
  tenantId       String
  kind           String
  status         String         @default("RUNNING")
  // 同一企业、同一种流程、同一去重键只能有一次运行（例如同一个入仓计划的同一次提交）
  dedupeKey      String?
  intentJson     Json
  resultJson     Json?
  checkpointJson Json?
  errorCode      String?
  priority       Int            @default(3)
  attempt        Int            @default(0)
  syncJobId      String?
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?
  heartbeatAt    DateTime       @default(now())
  // 最长运行时间：超过后即使心跳还在也会被回收
  deadlineAt     DateTime?
  lockOwner      String?
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps          WorkflowStep[]

  @@unique([tenantId, kind, dedupeKey])
  @@index([tenantId, kind, status])
  @@index([status, heartbeatAt])
  @@index([syncJobId])
}

// 流程步骤：每一步记录状态、输入摘要、输出摘要、重试次数、下次执行时间、错误码。
// status：PENDING / RUNNING / SUCCEEDED / FAILED / COMPENSATED / SKIPPED（检查约束保证）。
model WorkflowStep {
  id           String      @id @default(cuid())
  tenantId     String
  runId        String
  seq          Int
  name         String
  status       String      @default("PENDING")
  requestJson  Json?
  responseJson Json?
  errorCode    String?
  attempt      Int         @default(0)
  nextRunAt    DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run          WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([tenantId, runId])
}

// 死信：超过重试次数或遇到不可重试错误的任务。只存编号与参数（payloadRef），不存业务数据正文；同步中心可手动重放。
model DeadLetterJob {
  id          String    @id @default(cuid())
  tenantId    String
  queue       String
  jobName     String
  payloadRef  String
  errorCode   String
  errorDetail String
  attempts    Int
  runId       String?
  syncJobId   String?
  createdAt   DateTime  @default(now())
  replayedAt  DateTime?
  replayedBy  String?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, queue, replayedAt])
}

// 带租约的分布式锁：同一店铺、同一数据域同一时间只跑一个任务。租约到期自动失效；fence 单调递增，用于识别过期持有者。
model DistributedLock {
  id         String   @id @default(cuid())
  tenantId   String
  lockKey    String
  owner      String
  fence      Int      @default(1)
  leaseUntil DateTime
  renewedAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, lockKey])
  @@index([leaseUntil])
}

// 原始报告文件登记（M-P1-23）：文件本体在对象存储（路径按“租户/数据域/日期”），库里只存路径、大小与内容摘要。
// 同一店铺内内容摘要相同的文件只登记一次。storeKey：卖家店铺编号；广告报告为 ads:<广告账户编号>；没有店铺归属时为 -（CR-015）。
model RawReportFile {
  id              String    @id @default(cuid())
  tenantId        String
  storeKey        String
  sellerAccountId String?
  sourceKey       String
  reportType      String?
  reportId        String?
  objectKey       String
  sizeBytes       BigInt    @default(0)
  sha256          String
  rowCount        Int?
  periodStart     DateTime? @db.Date
  periodEnd       DateTime? @db.Date
  storedAt        DateTime  @default(now())
  retentionUntil  DateTime?
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, storeKey, sha256])
  @@index([tenantId, sourceKey, storedAt])
  @@index([retentionUntil])
}

// 按月分区表（分区列 occurredAt，见 M-P1-27）。createdAt 保留，待 P1-14 统一审计写入后评估去留。
model AuditEvent {
  id           String   @default(cuid())
  tenantId     String
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  result       String
  detail       Json?
  // 修改前后的快照（已脱敏）、来源地址与终端、异步写入流程编号、再次验证记录、操作原因（P1-14）
  beforeJson   Json?
  afterJson    Json?
  ip           String?
  userAgent    String?
  writeRunId   String?
  stepUpId     String?
  reason       String?
  // 来源（PAGE 页面操作、API 接口调用、SYSTEM 系统任务）与所属页面（前端路径模板）；旧记录为空（P5-09）
  source       String?
  page         String?
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@id([id, occurredAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, occurredAt])
  @@index([tenantId, action, occurredAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([actorId])
}

// 幂等记录：同一企业、同一路由、同一幂等键 24 小时内只执行一次，重复提交返回首次结果。
model IdempotencyRecord {
  id             String   @id @default(cuid())
  tenantId       String
  key            String
  route          String
  requestHash    String
  responseStatus Int?
  responseJson   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, route])
  @@index([expiresAt])
}

// 再次验证身份记录：按用户与操作计，有效期 10 分钟（method：PASSWORD 或 TOTP，由检查约束保证）。
model StepUpVerification {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  action     String
  method     String
  verifiedAt DateTime @default(now())
  expiresAt  DateTime
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, action, expiresAt])
  @@index([userId, action, expiresAt])
}


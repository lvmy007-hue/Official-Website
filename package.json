{
  "name": "nova-commerce-workspace",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "eslint src/erp src/api.ts --max-warnings=0 && node scripts/check-code-quality.mjs && tsc -b && vite build && node scripts/bundle-budget.mjs && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "eslint src/erp src/api.ts apps packages scripts --max-warnings=35",
    "lint:web": "eslint src/erp src/api.ts --max-warnings=0",
    "format": "prettier --write \"src/erp/**/*.{ts,tsx,css}\" src/api.ts \"apps/**/*.ts\" \"packages/**/*.ts\" \"scripts/**/*.{mjs,cjs,mts}\" eslint.config.mjs",
    "format:check": "prettier --check \"src/erp/**/*.{ts,tsx,css}\" src/api.ts \"apps/**/*.ts\" \"packages/**/*.ts\" \"scripts/**/*.{mjs,cjs,mts}\" eslint.config.mjs",
    "check:quality": "node scripts/check-code-quality.mjs",
    "check:security": "node scripts/check-security.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "ci": "node scripts/ci.mjs",
    "api:dev": "pnpm --filter @nova/api dev",
    "worker:dev": "pnpm --filter @nova/worker dev",
    "db:generate": "pnpm --filter @nova/api prisma:generate",
    "db:migrate": "pnpm --filter @nova/api prisma:migrate",
    "fullstack:build": "pnpm --filter @nova/api-contracts build && pnpm --filter @nova/authz build && pnpm --filter @nova/metrics build && pnpm typecheck && pnpm build && pnpm test && pnpm --filter @nova/api build && pnpm --filter @nova/worker build",
    "fullstack:up": "docker compose -f infrastructure/compose/docker-compose.yml up --build",
    "fullstack:dev-up": "docker compose -f infrastructure/compose/docker-compose.yml -f infrastructure/compose/docker-compose.dev-ports.yml up --build"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/pro-components": "^2.8.10",
    "@radix-ui/react-accordion": "1.2.1",
    "@radix-ui/react-navigation-menu": "1.2.1",
    "@radix-ui/react-tabs": "1.1.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "antd": "^5.29.3",
    "dayjs": "^1.11.23",
    "echarts": "^5.6.0",
    "framer-motion": "11.11.0",
    "lucide-react": "0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "^5.22.0",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "8.4.47",
    "prettier": "^3.9.10",
    "prisma": "^5.22.0",
    "tailwindcss": "3.4.17",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "zod": "^4.6.7"
  }
}

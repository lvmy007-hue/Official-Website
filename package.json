{
  "name": "nova-commerce-workspace",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "api:dev": "pnpm --filter @nova/api dev",
    "worker:dev": "pnpm --filter @nova/worker dev",
    "db:generate": "pnpm --filter @nova/api prisma:generate",
    "db:migrate": "pnpm --filter @nova/api prisma:migrate",
    "fullstack:build": "pnpm --filter @nova/api-contracts build && pnpm --filter @nova/authz build && pnpm --filter @nova/metrics build && pnpm typecheck && pnpm build && pnpm test && pnpm --filter @nova/api build && pnpm --filter @nova/worker build",
    "fullstack:up": "docker compose -f infrastructure/compose/docker-compose.yml up --build"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.4",
    "echarts": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "turbo": "^2.3.3",
    "prisma": "^5.22.0"
  }
}

APP_MODE=development
DEMO_MODE=false
MOCK_CONNECTOR=false
LOCAL_NO_AUTH=true
LOCAL_DEV_TENANT_ID=local-dev-tenant
LOCAL_DEV_USER_ID=local-dev-user
LOCAL_DEV_USER_EMAIL=local.admin@nova-erp.local
PORT=4000
# 本地开发的数据库与 Redis（P1-25）：docker compose 默认不映射端口，需要在宿主机上直接运行接口/前端时叠加端口映射文件：
#   docker compose -f infrastructure/compose/docker-compose.yml -f infrastructure/compose/docker-compose.dev-ports.yml up -d
# 下面的地址与账号对应 docker-compose.yml 里的开发默认值（只用于本机）。
# 租户隔离（P1-16）：DATABASE_URL 是普通账号 nova_app（受行级安全约束），系统流程（登录、授权回调、跨租户调度、分区维护）使用
# DATABASE_SYSTEM_URL（账号 nova_system）。账号由 compose 的一次性服务 roles 创建，手动创建见 database/ops/roles.sql。
# 迁移要用表的所有者账号直连：DATABASE_URL=postgresql://nova:nova_dev_password@localhost:15432/nova_erp?schema=public pnpm --filter @nova/api prisma:deploy
DATABASE_URL=postgresql://nova_app:nova_app_dev_password@localhost:15432/nova_erp?schema=public
DATABASE_SYSTEM_URL=postgresql://nova_system:nova_system_dev_password@localhost:15432/nova_erp?schema=public
# 连接池与超时（P1-25，均有默认值）：
# DB_POOL_SIZE=10                       # 单进程数据库连接数上限（连接串里写了 connection_limit 则以连接串为准）
# DB_POOL_TIMEOUT_SECONDS=20            # 排队等连接的最长时间
# DB_PGBOUNCER=false                    # 经 PgBouncer 事务池访问时为 true（等价于连接串加 pgbouncer=true）
# DB_REQUIRE_TLS=false                  # 数据库在另一台机器上时为 true：连接串必须带 sslmode=require/verify-full；任何情况下不允许 sslaccept=accept_invalid_certs
# QUERY_STATEMENT_TIMEOUT_MS=30000      # 接口服务单条语句超时；超时返回 QUERY_TIMEOUT（504，可重试）
# WORKER_STATEMENT_TIMEOUT_MS=120000    # 后台任务单条语句超时
# 双 Redis（P1-20/P1-25，12.3）：队列实例存任务（不淘汰任何键、开持久化、设密码），缓存实例存限流桶与并发槽位等可重建数据（内存满淘汰最久未用）。
# 两项都不配置时都退回 REDIS_URL（仅限开发与测试）；生产必须分开配置、都带密码。加密连接：连接串写 rediss://（证书始终校验，私有 CA 用 REDIS_TLS_CA_FILE）。
QUEUE_REDIS_URL=redis://:nova_dev_queue_password@localhost:16379
CACHE_REDIS_URL=redis://:nova_dev_cache_password@localhost:16380
# REDIS_REQUIRE_TLS=false               # Redis 在另一台机器上时为 true：连接串必须是 rediss://
# REDIS_TLS_CA_FILE=
# REDIS_TLS_SERVERNAME=
# 后台任务可靠性参数（均有默认值，按需调整）
# TENANT_MAX_CONCURRENT_JOBS=2          # 每个租户同时运行的任务数上限（租户公平，防止一家占满全部处理能力）
# LOCK_LEASE_MS=90000                   # 分布式锁租期（毫秒），持有者需定期续租，崩溃后到期由他人接管
# AMAZON_DEFAULT_RATE_PER_SECOND=1      # 亚马逊接口默认每秒请求数（收到 x-amzn-RateLimit-Limit 后按实际值调整）
# AMAZON_DEFAULT_BURST=2                # 亚马逊接口默认突发容量
# RATE_LIMIT_MAX_WAIT_MS=30000          # 等待限流令牌的最长时间，超过则任务延后重试
# SHUTDOWN_TIMEOUT_MS=30000             # 优雅停机等待在途任务完成的最长时间，超时强制退出
# 内存防护（P1-22，12.5）：
# WORKER_RSS_LIMIT_MB=1500               # 后台进程常驻内存上限；连续超限则不再领取新任务、等在途任务收尾后以退出码 75 退出，由守护进程重启
# WORKER_HEAP_RATIO=0.85                 # 堆占用占堆上限的比例阈值（0~1）
# WORKER_MEMORY_BUDGET_MB=               # 并发内存预算；不设则取堆上限（--max-old-space-size）的 60%
# JOB_MEMORY_MB=64                       # 单个任务的内存估算：预算 / 估算 = 总并发上限（各队列按比例缩小，至少为 1）
# QUERY_MAX_ROWS=20000                   # 接口查询单次最多返回的行数；超过则报错而不是静默截断，需分页或走导出
# STRESS_STREAM_MB=                      # 内存压测的手动体量（例如 1024 即 1GB），仅测试时设置
# 应用层加密（P1-24）：密钥分三层——主密钥（这里配置，不进数据库）→ 数据密钥（按用途一把、带版本、被主密钥包裹后存数据库）→ 令牌、买家信息、多因素密钥。
# 主密钥是 32 字节（64 位十六进制）。只配 TOKEN_ENCRYPTION_KEY 时它就是唯一的主密钥（编号 env-1）。轮换主密钥时同时配置新旧两把并指定新包裹用哪一把，
# 运行 keys 命令重新包裹后再移除旧的；步骤见 docs/runbooks/encryption-keys.md。生产环境缺失或格式不对会拒绝启动。
# ENCRYPTION_MASTER_KEYS=new-2026:<64位十六进制>,old:<64位十六进制>
# ENCRYPTION_MASTER_KEY_ACTIVE=new-2026
# ENCRYPTION_KEY_PROVIDER=env              # env | kms；kms（云密钥管理）随部署专项接入，接口已预留，当前请用 env
# KMS_KEY_ID=
# 文件存储（P1-23）：本地磁盘或阿里云对象存储。所有文件路径按租户隔离，下载与直传都走短时签名链接。
# STORAGE_DRIVER=local                   # local | oss
# STORAGE_LOCAL_DIR=./storage-data       # local：存储目录；生产需挂载为持久卷（api 与 worker 共享）并纳入备份
# STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:4000/api/v1/storage/local   # local：签名链接前缀（对外可访问的地址）
# STORAGE_SIGNING_KEY=                   # local：签名密钥（至少 32 个字符）；生产必须显式设置，其他环境缺省时由 JWT_SECRET 派生
# STORAGE_MAX_UPLOAD_MB=50               # 单个直传文件大小上限
# OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com   # oss：地域节点
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_PART_SIZE_MB=8                     # oss：分片上传的分片大小
# RAW_FILE_RETENTION_DAYS=400            # 亚马逊原始报告文件留存天数，到期自动清理（便于追溯与重新解析）
# 真实 Redis 的故障注入测试：指向一个可丢弃的 Redis，例如 redis://127.0.0.1:26379；未设置时这些用例被跳过
# TEST_REDIS_URL=
JWT_SECRET=local-development-secret-change-me-at-least-32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 代理信任（P1-17）：只信任我方网关，才能拿到真实客户端地址（限流、登录锁定、审计都依赖它）。不配置则不信任任何代理。
# 写代理层数（网关到服务只隔一层写 1；宿主机 nginx 再转发到 web 容器 nginx 的两层部署写 2），或写网关的地址/网段，例如 10.0.0.0/8。
# 不允许写 true（等于信任任何来源伪造的地址）。生产环境未配置时启动日志持续告警。
# TRUST_PROXY=2
# 内部访问模式（P1-18）：企业内网直连、不走个人登录。默认关闭；生产环境开启时启动日志持续告警。
# 开启后，来自允许地址段的无登录请求按“固定内部租户 + 最小权限角色”处理；其余请求仍走普通登录。依赖 TRUST_PROXY 配置正确。
# INTERNAL_DIRECT_ACCESS=false
# INTERNAL_ACCESS_TENANT_ID=
# INTERNAL_ACCESS_ROLE_ID=preset-readonly
# INTERNAL_ACCESS_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16
# 可选：内网网关注入的校验头（两项同时配置，密钥至少 16 个字符）
# INTERNAL_ACCESS_GATEWAY_HEADER=
# INTERNAL_ACCESS_GATEWAY_SECRET=
# 管理员强制绑定多因素认证：生产环境默认开启，其他环境默认关闭；显式写 true/false 可覆盖。
# MFA_REQUIRED_FOR_ADMINS=true
VITE_API_MODE=server
VITE_API_BASE_URL=/api/v1

